+# [MP8] Promo shots (mp8promo), for every minigame, timed from the moment it enters the tree:
+# game.gd cannot see each minigame's own state machine. mp8promoat=10,16 sets the seconds
+# (default 10,16,22); mp8promoui keeps debug UI. Saved as user://mp8_promo_<id>_t<s>_<peer>.png.
+func _mp8_promo_shot(minigame_identifier: int) -> void :
+
+	if not NetworkManager.mp8_dev_args().has("mp8promo"):
+		return
+
+	var times: Array = []
+	var spec: String = _mp8_arg("mp8promoat=")
+	if spec == "":
+		times = [10.0, 16.0, 22.0]
+	else:
+		for part in spec.split(",", false):
+			var v: float = float(part)
+			if v > 0.0:
+				times.append(v)
+	if times.is_empty():
+		return
+	times.sort()
+
+	var peer: int = multiplayer.get_unique_id() if multiplayer.has_multiplayer_peer() else 0
+	var waited: float = 0.0
+
+	for t in times:
+		# Times are seconds since entering the tree, not gaps between shots.
+		var gap: float = float(t) - waited
+		if gap > 0.0:
+			await get_tree().create_timer(gap, false).timeout
+			waited = float(t)
+
+		# Stop once the minigame is replaced, or the next one's frame is saved under this id.
+		if not is_inside_tree():
+			return
+		if Globals.current_minigame_identifier != minigame_identifier:
+			return
+
+		# Debug UI is hidden for the shot and restored after. Only help_label, not the name tags that
+		# share Globals.GROUP_UI with it: the tags are stock UI and part of what the shot shows.
+		var hidden: Array = []
+		if not NetworkManager.mp8_dev_args().has("mp8promoui"):
+			if debug_player_handler != null and debug_player_handler.help_label != null:
+				if debug_player_handler.help_label.visible:
+					hidden.append(debug_player_handler.help_label)
+					debug_player_handler.help_label.visible = false
+			_mp8_hide_debug_overlays(get_tree().root, hidden)
+
+		await RenderingServer.frame_post_draw
+
+		var img: Image = get_viewport().get_texture().get_image()
+		if img != null:
+			var path: String = "user://mp8_promo_%d_t%d_%d.png" % [minigame_identifier, int(t), peer]
+			img.save_png(path)
+			print("[MP8] mp8promo: saved %s" % path)
+
+		for node in hidden:
+			if is_instance_valid(node):
+				node.visible = true
+
+
+# [MP8] Hides this mod's debug overlays, collecting them in out to restore. All three tests are needed:
+# a CanvasLayer or Control (MP8-named Node3Ds are gameplay), a name starting MP8 (stock UI is never
+# touched), and Panel/Debug/Info in the name (player-facing MP8 UI such as score boards stays).
+func _mp8_hide_debug_overlays(node: Node, out: Array) -> void :
+
+	var n: String = node.name
+	if n.begins_with("MP8") and (node is CanvasLayer or node is Control):
+		if n.contains("Panel") or n.contains("Debug") or n.contains("Info"):
+			if node.visible:
+				out.append(node)
+				node.visible = false
+			return
+
+	for child in node.get_children():
+		_mp8_hide_debug_overlays(child, out)
+
+
+# [MP8] The value of a command-line argument of the form <prefix><value>, or "".
+func _mp8_arg(prefix: String) -> String:
+	for a in NetworkManager.mp8_dev_args():
+		var s: String = str(a)
+		if s.begins_with(prefix):
+			return s.substr(prefix.length())
+	return ""
+
+
+# [MP8] Crash breadcrumbs: open, write, close for every line so it survives a hard crash. Only with mp8trace.
+var _mp8_trace_on: int = -1
+
+func _mp8_trace(msg: String) -> void :
+
+	if _mp8_trace_on == -1:
+		_mp8_trace_on = 1 if NetworkManager.mp8_dev_args().has("mp8trace") else 0
+
+	if _mp8_trace_on == 0:
+		return
+
+	var path := "user://mp8_trace.txt"
+	var f := FileAccess.open(path, FileAccess.READ_WRITE) if FileAccess.file_exists(path) else FileAccess.open(path, FileAccess.WRITE)
+	if f == null:
+		return
+	f.seek_end()
+	f.store_line("[%d] %s" % [multiplayer.get_unique_id() if multiplayer else 0, msg])
+	f.close()
 
