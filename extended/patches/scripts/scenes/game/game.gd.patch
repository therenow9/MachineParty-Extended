+# [MP8] Re-evaluates the load gate after a disconnect, server only. The leaver is erased from
+# players_loaded first (they may have reported already), then the gate rechecked.
+# is_all_player_loaded marks a gate already passed (every minigame's all_players_loaded() sets it on
+# the server); without that check a later disconnect would initialize the round again.
+func _mp8_recheck_load_gate(_network_id: int) -> void :
+
+	if not multiplayer.is_server():
+		return
+	# A mixed room leaves the gate as the game does.
+	if not NetworkManager.mp8_room_extended():
+		return
+	if not is_instance_valid(minigame):
+		return
+	if minigame.is_all_player_loaded:
+		return
+
+	var before: int = minigame.players_loaded.size()
+	minigame.players_loaded.erase(_network_id)
+
+	var have: int = minigame.players_loaded.size()
+	var want: int = PlayerManager.player_presences.size()
+	var pass_now: bool = want > 0 and have >= want
+
+	print("[MP8] load gate recheck: %d left -> reported %d (before erase %d) / present %d - %s" % [
+		_network_id, have, before, want, "gate passes" if pass_now else "still waiting for reports"
+	])
+
+	if not pass_now:
+		return
+
+	minigame.all_players_loaded()
+
