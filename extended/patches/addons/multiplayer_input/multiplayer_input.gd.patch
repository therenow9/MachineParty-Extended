+++ b/addons/multiplayer_input/multiplayer_input.gd
@@ -1,5 +1,8 @@
 extends Node
 
+# Core actions belong to the keyboard. 8 is a valid controller ID after hot
+# plugging, so reserve an unreachable ID instead of routing that pad twice.
+const MP8_KEYBOARD_ONLY_DEVICE: int = 2147483647
 
 
 
@@ -54,7 +57,7 @@ func initialize():
 	for action in core_actions:
 		for e in InputMap.action_get_events(action):
 			if _is_joypad_event(e) and !is_ui_action(action):
-				e.device = 8
+				e.device = MP8_KEYBOARD_ONLY_DEVICE
 
 	for device_id in Input.get_connected_joypads():
 		_create_actions_for_device(device_id)
@@ -105,6 +108,20 @@ func _create_actions_for_device(device: int):
 				InputMap.action_add_event(new_action, new_event)
 
 func _delete_actions_for_device(device: int):
+
+	# [MP8] A mixed room erases as the game does, by name prefix (D120).
+	if not NetworkManager.mp8_room_extended():
+		_mp8_game_delete_actions_for_device(device)
+		return
+	# Use the exact names created for this device; prefix "1" also matches "10".
+	var actions: Dictionary = device_actions.get(device, {})
+	for action in actions.values():
+		if InputMap.has_action(action):
+			InputMap.erase_action(action)
+	device_actions.erase(device)
+
+# The game's _delete_actions_for_device, for a mixed room (D120).
+func _mp8_game_delete_actions_for_device(device: int):
 	device_actions.erase(device)
 	var actions_to_erase = []
 	var device_num_str = str(device)
@@ -122,9 +139,6 @@ func _delete_actions_for_device(device: int):
 	for action in actions_to_erase:
 		InputMap.erase_action(action)
 
