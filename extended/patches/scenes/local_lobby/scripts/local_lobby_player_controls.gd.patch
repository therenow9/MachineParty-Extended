+# Eight cards at 75%, each centred in its 118 px slot.
+const MP8_CARD_SCALE := 0.75
+const MP8_SLOT_CENTRE := 67.25
+# The outfit icons are 26 px drawings in 32 px boxes; on screen they show at this multiple of their
+# size. Below 1x, nearest filtering drops whole pixel rows.
+const MP8_OUTFIT_ICON := 1.15
+
 func set_container_position(set_to_default: bool):
-	var pos: Vector2
-	if set_to_default:
-		match seat_index:
-			0:
-				pos = Vector2(190, 71)
-			1:
-				pos = Vector2(345, 128)
-			2:
-				pos = Vector2(446, 120)
-			3:
-				pos = Vector2(576, 112)
-	else:
-		match seat_index:
-			0:
-				pos = Vector2(190, 143)
-			1:
-				pos = Vector2(345, 200)
-			2:
-				pos = Vector2(446, 193)
-			3:
-				pos = Vector2(576, 184)
-	position = pos
+	# Eight fixed cards in the scene's 960x540 logical canvas; never compact holes.
+	set_anchors_preset(Control.PRESET_TOP_LEFT)
+	scale = Vector2.ONE * MP8_CARD_SCALE
+	size.x = floorf(116.0 / MP8_CARD_SCALE)
+	position = Vector2(MP8_SLOT_CENTRE + seat_index * 118 - size.x * MP8_CARD_SCALE / 2.0, 235 if set_to_default else 285)
+	# The host's crown is a row of this VBox and pushes the card down; shift up by that row so all 8 names line up.
+	if main_player_icon.visible:
+		position.y -= (main_player_icon.get_combined_minimum_size().y + get_theme_constant("separation")) * scale.y
+	_mp8_size_outfit()
+
+# Every outfit row (any HBox of the card but the name letters, so a mod's added row too) and the
+# ready box, grown from the scene's own sizes, kept as meta the first time.
+func _mp8_size_outfit() -> void:
+	var f := MP8_OUTFIT_ICON * 26.0 / (MP8_CARD_SCALE * 32.0)
+	var boxes: Array = [ready_toggle]
+	for row in get_children():
+		if row is HBoxContainer and row != name_entry_selector:
+			boxes.append_array(row.get_children().filter(func(n): return n is TextureRect))
+	for t in boxes.filter(func(n): return n is TextureRect):
+		if not t.has_meta(&"mp8_base"):
+			t.set_meta(&"mp8_base", t.custom_minimum_size if t.custom_minimum_size != Vector2.ZERO else (t.texture.get_size() if t.texture else Vector2.ZERO))
+		t.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
+		t.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_CENTERED
+		t.custom_minimum_size = t.get_meta(&"mp8_base") * f
 
 func set_container_position_name_selection():
-	position = Vector2(position.x, 127)
+	set_container_position(true)
 
