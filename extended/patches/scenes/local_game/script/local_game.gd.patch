+# Shared session state calls this before changing round counters. This is a
+# local lifecycle guard only; no peer IDs involved.
+func mp8_claim_round_finish(instance_id: int, epoch: int) -> bool:
+	if not is_instance_valid(minigame) or epoch != _mp8_round_epoch:
+		return false
+	if instance_id != minigame.get_instance_id() or _mp8_finish_claimed:
+		return false
+	_mp8_finish_claimed = true
+	return true
