+# [MP8] A tiled minigame's local CanvasLayer (The Filter, Chisel Gauntlet, Knife at the Office, Duck Hunt) opens with
+# an opaque ColorRect over the whole window, under the tiles. While it shows, the window's own 3D (the world again,
+# with every shadowed light) is drawn and never seen. Checked just before each frame is drawn, after its scripts.
+func _mp8_skip_covered_3d() -> void :
+	var handler = minigame.get("local_handler") if is_instance_valid(minigame) else null
+	var layer = handler.get("canvas_layer") if is_instance_valid(handler) else null
+	var covered := mp8_covers_window(layer, get_viewport().get_visible_rect())
+	if get_viewport().disable_3d != covered:
+		get_viewport().disable_3d = covered
+
+static func mp8_covers_window(layer, window: Rect2) -> bool:
+	if not is_instance_valid(layer) or not (layer is CanvasLayer) or not layer.visible or layer.get_child_count() == 0 \
+			or layer.transform != Transform2D.IDENTITY or layer.follow_viewport_enabled:
+		return false
+	var cover = layer.get_child(0)
+	return cover is ColorRect and cover.is_visible_in_tree() and cover.material == null and cover.color.a >= 1.0 \
+		and cover.modulate.a >= 1.0 and cover.self_modulate.a >= 1.0 and cover.get_global_rect().encloses(window)
+
