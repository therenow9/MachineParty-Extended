 		GlobalOverlay.fade_overlay(Color.BLACK, 1.0)
 		await GlobalOverlay.fade_finished
+		if not is_inside_tree():
+			return
 		MusicManager.filter_controller.begin_shift(MusicManager.filter_controller.effect_low_pass.cutoff_hz, 300, 1, 1)
 		get_tree().change_scene_to_file("res://scenes/character_customization.tscn")
 	)
