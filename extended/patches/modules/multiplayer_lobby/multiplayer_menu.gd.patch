+# [MP8] Auto start on the host instance: presses START once everyone is in, and gives up on a
+# timeout rather than holding the lobby.
+func _mp8_autostart(want: int) -> void :
+
+	print("[MP8] autostart: waiting for %d players" % want)
+
+	var waited: int = 0
+	while waited < 180:
+
+		await get_tree().create_timer(1.0).timeout
+		waited += 1
+
+		if not NetworkManager.active_backend:
+			continue
+
+		var n: int = NetworkManager.active_backend.connected_players.size()
+
+		if waited % 5 == 0:
+			print("[MP8] autostart: %d/%d connected (%d s)" % [n, want, waited])
+
+		if n >= want:
+			print("[MP8] autostart: %d players in, starting in 3 s" % n)
+			# [MP8] The lobby promo shot, mid-wait: the only moment with every seat filled before the
+			# start. The 3 s wait is split around it.
+			await get_tree().create_timer(1.5).timeout
+			_mp8_lobby_shot()
+			await get_tree().create_timer(1.5).timeout
+			print("[MP8] autostart: starting")
+			_on_lobby_start_button_pressed()
+			return
+
+	print("[MP8] autostart: gave up after %d s without %d players" % [waited, want])
+
+
+# [MP8] The 8-seat lobby promo shot (mp8promo), from the host's viewport. game.gd's in-match shots
+# hang off load_minigame() and game.gd is not in the tree yet in the lobby, hence this one.
+func _mp8_lobby_shot() -> void :
+
+	if not NetworkManager.mp8_dev_args().has("mp8promo"):
+		return
+
+	await RenderingServer.frame_post_draw
+
+	var img: Image = get_viewport().get_texture().get_image()
+	if img != null:
+		img.save_png("user://mp8_promo_lobby.png")
+		print("[MP8] mp8promo: saved user://mp8_promo_lobby.png")
+
 
