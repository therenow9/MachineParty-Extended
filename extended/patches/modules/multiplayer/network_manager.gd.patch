+# [MP8] ======== The Steam lobby member limit follows the cap ========
+# The capacity guard covers max_player_count, not Steam's member limit: MachineParty+'s "Make Lobby
+# Public" sets that to at most 4, and Steam refuses player 5 with nothing in our log. The limit is the
+# mixed cap while anyone in the room lacks our key, so Steam itself turns a 5th away ("The room is
+# full."), and max_player_count otherwise. The host checks every 2 s and on each join and leave. Every
+# Steam call is behind has_method, so a missing one is skipped.
+var _mp8_lobby_timer: Timer = null
+var _mp8_lobby_last_fix: int = -1
+var _mp8_lobby_set: int = -1   # the limit this script last set, so its own 4 isn't taken for another mod's
+
+
+func _mp8_lobby_guard_start() -> void :
+
+	_mp8_lobby_timer = Timer.new()
+	_mp8_lobby_timer.name = "MP8LobbySizeGuard"
+	_mp8_lobby_timer.wait_time = 2.0
+	_mp8_lobby_timer.autostart = true
+	_mp8_lobby_timer.timeout.connect(_mp8_enforce_lobby_size)
+	add_child(_mp8_lobby_timer)
+	on_peer_connected.connect(func(_id): _mp8_enforce_lobby_size.call_deferred())
+	on_peer_disconnected.connect(func(_id): _mp8_enforce_lobby_size.call_deferred())
+
+
+# The member limit for a room: never below the members already in it.
+func mp8_lobby_limit(members: int, room_extended: bool) -> int:
+	return maxi(max_player_count if room_extended else MP8_MIXED_CAP, members)
+
+
+func _mp8_enforce_lobby_size() -> void :
+
+	if active_backend_type != NetworkBackendType.Steam:
+		return
+	if not (multiplayer and multiplayer.has_multiplayer_peer() and multiplayer.is_server()):
+		return
+	if active_backend == null:
+		return
+
+	# lobby_id exists only on the Steam backend, not on MultiplayerBackend: read it duck-typed.
+	var lobby_id: int = int(active_backend.get("lobby_id") if active_backend.get("lobby_id") != null else 0)
+	if lobby_id <= 0:
+		return
+
+	if not (Engine.has_singleton("Steam") or ClassDB.class_exists("Steam")):
+		return
+
+	var members: int = int(Steam.getNumLobbyMembers(lobby_id)) if Steam.has_method("getNumLobbyMembers") else 0
+	var room_extended: bool = _mp8_room_live()
+	var want: int = mp8_lobby_limit(members, room_extended)
+
+	# With a getter, change the limit only when it differs; without one, set it (idempotent).
+	if Steam.has_method("getLobbyMemberLimit"):
+		var cur: int = int(Steam.getLobbyMemberLimit(lobby_id))
+		if cur == want or cur <= 0:
+			return
+		if not Steam.has_method("setLobbyMemberLimit"):
+			return
+		Steam.setLobbyMemberLimit(lobby_id, want)
+		if room_extended and cur < want and cur != _mp8_lobby_set and _mp8_lobby_last_fix != cur:
+			_mp8_lobby_last_fix = cur
+			push_warning("[MP8] another mod lowered the Steam lobby limit to %d (known case: MachineParty+'s 'Make Lobby Public'), restored to %d" % [cur, want])
+		_mp8_lobby_set = want
+		print("[MP8] Steam lobby limit %d -> %d (extended room=%s, members=%d)" % [cur, want, room_extended, members])
+	else:
+		if Steam.has_method("setLobbyMemberLimit"):
+			Steam.setLobbyMemberLimit(lobby_id, want)
+			_mp8_lobby_set = want
