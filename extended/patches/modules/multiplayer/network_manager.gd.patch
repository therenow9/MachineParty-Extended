+# The lobby's player slots (model, name tag, customization assigner) are @export arrays of 4, and
+# update_player_list() indexes them by counter, so player 5 has no slot. Slots are copied up to MAX_PLAYERS.
+func _mp8_extend_lobby(h) -> void :
+
+	if not is_instance_valid(h):
+		return
+
+	var n: int = h.players.size()
+
+	print("[MP8] extend_lobby hit handler=%s players=%d models=%s" % [
+		str(h.get_path()), n, str(h.get("player_models"))
+	])
+
+	if n < 2 or n >= MAX_PLAYERS:
+		print("[MP8]   skipped (n=%d not in 2..%d)" % [n, MAX_PLAYERS])
+		return
+
+	if h.customization_assigners.size() < n or h.nametags.size() < n:
+		return
+
+	var parent = h.players[0].get_parent()
+	var cam = parent.get_parent().get_node_or_null("Camera3D")
+	var game_side := {"players": h.players.duplicate(), "assigners": h.customization_assigners.duplicate(),
+		"nametags": h.nametags.duplicate(), "cam": cam.position if cam else Vector3.ZERO}
+
+	# The stock slots' poses are baked into each Armature with different offsets, so none moves: all 4
+	# are copied and shifted as a second row, which inherits the same offsets.
+	for j in range(MAX_PLAYERS - n):
+
+		var src_slot = h.players[j % n]
+		var src_assigner = h.customization_assigners[j % n]
+		var src_nametag = h.nametags[j % n]
+
+		if not src_slot.is_ancestor_of(src_assigner) or not src_slot.is_ancestor_of(src_nametag):
+			print("[MP8] slot %d has an unexpected structure, skipped" % (j % n))
+			continue
+
+		var rel_a: NodePath = src_slot.get_path_to(src_assigner)
+		var rel_t: NodePath = src_slot.get_path_to(src_nametag)
+
+		var dup = src_slot.duplicate()
+		dup.name = "MP8Slot%d" % (n + j)
+		parent.add_child(dup)
+		dup.position = src_slot.position + MP8_ROW2_OFFSET
+		dup.visible = false
+
+		h.players.append(dup)
+		h.customization_assigners.append(dup.get_node(rel_a))
+		h.nametags.append(dup.get_node(rel_t))
+
+	# The chairs are copied with the same shift, so the second row sits as the first does.
+	_mp8_clone_chairs(parent, MP8_ROW2_OFFSET)
+
+	# The second row is nearer the camera; pull it back a little.
+	if cam:
+		var before = cam.position
+		cam.position = Vector3(before.x, before.y * 1.08, before.z * 1.22)
+		print("[MP8] camera %s -> %s" % [str(before), str(cam.position)])
+
+	print("[MP8] lobby slots: %d -> %d (second row offset %s)" % [n, h.players.size(), str(MP8_ROW2_OFFSET)])
+	h.set_meta("mp8_lobby", {"extended": true, "game": game_side, "cam_node": cam,
+		"chairs": parent.get_parent().get_node_or_null("lobby environment1/MP8ChairRow"),
+		"ext": {"players": h.players.duplicate(), "assigners": h.customization_assigners.duplicate(),
+			"nametags": h.nametags.duplicate(), "cam": cam.position if cam else Vector3.ZERO}})
+
+	# Dumped now and again 4 s later: a difference means other code moved the slots.
+	_mp8_dump_slots(h, "just placed")
+	await get_tree().create_timer(4.0).timeout
+	if is_instance_valid(h):
+		_mp8_dump_slots(h, "after 4 s")
+
+
+# The second row's offset from the stock slots: larger z is nearer the camera (lower on screen),
+# larger x further right.
+const MP8_ROW2_OFFSET := Vector3(0.6, 0.0, 5.2)
+
+
+# Copies the scene's visible decorative chairs, shifted by offset, so each second-row seat has its chair.
+func _mp8_clone_chairs(parent, offset: Vector3) -> void :
+
+	var env = parent.get_parent().get_node_or_null("lobby environment1")
+	if env == null:
+		print("[MP8] lobby environment1 not found, skipping chairs")
+		return
+
+	if env.has_node("MP8ChairRow"):
+		return
+
+	var holder := Node3D.new()
+	holder.name = "MP8ChairRow"
+	env.add_child(holder)
+
+	var cloned: int = 0
+	for c in env.get_children():
+		if c == holder:
+			continue
+		if not (c is Node3D) or not c.visible:
+			continue
+		if not String(c.name).to_lower().begins_with("chair"):
+			continue
+		var d = c.duplicate()
+		d.name = "MP8" + String(c.name)
+		holder.add_child(d)
+		d.transform = c.transform
+		d.position = c.position + offset
+		d.visible = true
+		cloned += 1
+
+	print("[MP8] copied %d chairs, offset %s" % [cloned, str(offset)])
+
+
+# D121: the seat map a lobby's host sends. An Extended room has 8 seats; a mixed room the game's 4, anyone
+# seated at 5-8 moved to a free seat of 1-4 in seat order (a mixed room holds 4 at most, D117). Run before the
+# game's seat loop, which takes the first free seat. Static, for mp8_selftest.
+static func mp8_fit_seats(seats: Dictionary, extended: bool) -> Dictionary[int, int]:
+	var out: Dictionary[int, int] = {}
+	if extended:
+		for i in MAX_PLAYERS:
+			out[i] = int(seats.get(i, -1))
+		return out
+	var moved: Array[int] = []
+	for i in range(MP8_MIXED_CAP, MAX_PLAYERS):
+		if int(seats.get(i, -1)) >= 0:
+			moved.append(int(seats[i]))
+	for i in MP8_MIXED_CAP:
+		out[i] = int(seats.get(i, -1))
+		if out[i] < 0 and not moved.is_empty():
+			out[i] = moved.pop_front()
+	return out
+
+
+# D121: a lobby shows the game's 4 slots while its seat map has the game's 4 seats (a mixed room), and the
+# second row otherwise. Every peer follows the map the host sent, so all agree. The handler gets the game's
+# arrays back, since its update_player_list() indexes them by seat.
+func mp8_lobby_layout(h, extended: bool) -> void:
+	if not is_instance_valid(h) or not h.has_meta("mp8_lobby"):
+		return
+	var m: Dictionary = h.get_meta("mp8_lobby")
+	if m["extended"] == extended:
+		return
+	m["extended"] = extended
+	var side: Dictionary = m["ext" if extended else "game"]
+	h.players = side["players"].duplicate()
+	h.customization_assigners = side["assigners"].duplicate()
+	h.nametags = side["nametags"].duplicate()
+	for slot in m["ext"]["players"]:
+		if not side["players"].has(slot):
+			slot.visible = false
+	if is_instance_valid(m["chairs"]):
+		m["chairs"].visible = extended
+	if is_instance_valid(m["cam_node"]):
+		m["cam_node"].position = side["cam"]
+	print("[MP8] lobby layout: %s" % ("the second row" if extended else "the game's 4 slots, a mixed room"))
+
+
+func _mp8_dump_slots(h, tag: String) -> void :
+
+	# [MP8] Opt-in, like _mp8_audit.
+	if not _mp8_audit_on:
+		return
+
+	print("[MP8] ---- slot positions (%s) ----" % tag)
+	for i in h.players.size():
+		var s = h.players[i]
+		if not is_instance_valid(s):
+			print("[MP8]   slot %d <invalid>" % i)
+			continue
+		print("[MP8]   slot %d '%s' pos=%s gpos=%s vis=%s chair=%s" % [
+			i, str(s.name), str(s.position), str(s.global_position),
+			str(s.visible), str(_mp8_find_chair(s))
+		])
+
+
+# A chair mesh in a slot's subtree, if any: found means the chair moves with the slot.
+func _mp8_find_chair(node: Node) -> String :
+
+	for c in node.get_children():
+		if String(c.name).to_lower().contains("chair"):
+			return String(c.name)
+		var deeper: String = _mp8_find_chair(c)
+		if deeper != "":
+			return deeper
+	return ""
+
+# [MP8-AUDIT] Read-only, logs only: where each minigame keeps its spawn points, and what
+# MP8_SPAWN_CONTAINERS misses. Spawns live in a container node or an @export Array[Node3D]; both are logged.
+func _mp8_audit(mg: Node) -> void :
+
+	if not is_instance_valid(mg):
+		return
+
+	var script_path: String = "?"
+	if mg.get_script():
+		script_path = String(mg.get_script().resource_path)
+
+	print("[MP8-AUDIT] ========== minigame '%s' ==========" % str(mg.name))
+	print("[MP8-AUDIT] script=%s is_server=%s players=%d" % [
+		script_path, str(multiplayer.is_server()), PlayerManager.player_presences.size()
+	])
+
+	print("[MP8-AUDIT] -- script properties --")
+	for p in mg.get_property_list():
+
+		if not (int(p.get("usage", 0)) & PROPERTY_USAGE_SCRIPT_VARIABLE):
+			continue
+
+		var pname: String = String(p.get("name", ""))
+		var v = mg.get(pname)
+
+		if v is Array:
+			if v.size() > 0 and v.size() < MAX_PLAYERS:
+				print("[MP8-AUDIT]   [array] %s size=%d" % [pname, v.size()])
+			continue
+
+		if v is Node3D:
+			var ln: String = pname.to_lower()
+			if ln.contains("spawn") or ln.contains("position"):
+				print("[MP8-AUDIT]   [container] %s -> '%s' children=%d" % [
+					pname, str(v.name), v.get_child_count()
+				])
+
+	print("[MP8-AUDIT] -- subtree nodes named spawn/position --")
+	_mp8_audit_walk(mg, mg, 0)
+	print("[MP8-AUDIT] ========== audit done ==========")
+
+
+func _mp8_audit_walk(root: Node, node: Node, depth: int) -> void :
+
+	if depth > 8:
+		return
+
+	for c in node.get_children():
+
+		var ln: String = String(c.name).to_lower()
+		if ln.contains("spawn") or ln.contains("position"):
+
+			print("[MP8-AUDIT]   %s [%s] children=%d" % [
+				str(root.get_path_to(c)), c.get_class(), c.get_child_count()
+			])
+
+			# Point positions too: world coordinates at runtime, which the binary .scn cannot give statically.
+			if c.get_child_count() > 0 and c.get_child_count() <= 12:
+				for gc in c.get_children():
+					if gc is Node3D:
+						print("[MP8-AUDIT]       %-22s pos=%s gpos=%s rot=%s" % [
+							str(gc.name), str(gc.position),
+							str(gc.global_position), str(gc.rotation_degrees)
+						])
+
+			if c is Node3D:
+				print("[MP8-AUDIT]       (container itself) gpos=%s" % str(c.global_position))
+
+		_mp8_audit_walk(root, c, depth + 1)
+
