+# The rule with the room given, so mp8_selftest can play a mixed room without real peers.
+func mp8_join_refusal_in(network_id: int, client_data: Dictionary, room_extended: bool) -> int:
+	if active_backend == null:
+		return -1
+	var tag = client_data.get("mp8")
+	if tag is String and tag != MP8_VERSION_TAG:
+		return RefuseReason.VersionMismatch
+	# The size counts Offline Bots' bots, as vanilla's spectator check does; never the joiner itself.
+	var players: int = active_backend.connected_players.size()
+	if active_backend.connected_players.has(network_id):
+		players -= 1
+	if (not (tag is String) or not room_extended) and players + 1 > MP8_MIXED_CAP:
+		return RefuseReason.MP8RoomFull
+	return -1
