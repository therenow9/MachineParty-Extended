+# [MP8] ================ Runtime spawn top-up ================
+# Spawn containers hold 4 markers, and spawn_players() indexes positions[counter] unchecked, so
+# players 5-8 get null and stay put. Containers named here are topped up to MAX_PLAYERS as they
+# enter the tree, new points between neighbouring originals; no .tscn changes.
+
+const MP8_SPAWN_CONTAINERS: Array[String] = [
+	"playerspawnpositions",
+	"player spawn positions",
+	"spawnpositions",
+	"playerpositions",
+	"playerspawn",
+	"playerspawnparent",
+	# [MP8] Left out, each placed by its own minigame: "duckplayerspawnpositions" (midpoints of its 3
+	# points coincide with markers; duck_hunt.gd's _mp8_ensure_duck_spawns()) and "workstationspawns"
+	# (edge midpoints land inside walls and desks; manufacture_gun.gd's _mp8v_expand_for_roster(),
+	# after machine-party-8p's mid-edge desks).
+	"spectatepositions",
+]
+
+# [MP8] Diagnostic switches, read once in _ready(): mp8notopup skips the spawn top-up, mp8audit turns
+# on audit logging (_mp8_audit_on).
+var _mp8_no_topup: bool = false
+
+# [MP8] Audit logging, opt-in (pure diagnostics): editor, -debug-tools or mp8audit; mp8noaudit forces it off.
+var _mp8_audit_on: bool = false
+
+# [MP8] The main menu dialog's label wraps with AUTOWRAP_WORD, at spaces only, so unspaced Chinese
+# overflows and its clipping ScrollContainer cuts both ends. WORD_SMART fixes that; a very long ASCII
+# string may break mid-word. Only wrapping changes, not the 512x192 box the texts are written for.
+func _mp8_fix_dialog_label(handler) -> void :
+
+	if handler == null or not is_instance_valid(handler):
+		return
+	var lbl = handler.get("message_label")
+	if lbl == null or not is_instance_valid(lbl) or not (lbl is Label):
+		print("[MP8] dialog Label not found, skipping the wrap fix (harmless)")
+		return
+	(lbl as Label).autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
+
