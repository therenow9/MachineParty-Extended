+# [MP8] Capacity guard, locked at the end of _ready(). Another mod can write max_player_count at
+# runtime (MachineParty+'s "Make Lobby Public" caps it at 4), and this autoload outlives the lobby, so
+# the next lobby would silently hold 4. Once locked, other values are refused with a warning.
+var _mp8_cap_locked: bool = false
+
+# The capacity the lock holds, in both directions: allowing increases would ratchet (after a write of 9,
+# 8 is refused), and a mod with more players must replace this script anyway, MAX_PLAYERS being a const.
+var _mp8_cap_want: int = MAX_PLAYERS
+
+# push_warning rate limit: a value is reported once, then at most every 5 s with the suppressed count,
+# so a mod writing every frame cannot flood godot.log.
+var _mp8_cap_warn_at: float = -1.0
+var _mp8_cap_warn_val: int = -0x7FFFFFFF
+var _mp8_cap_warn_skipped: int = 0
+
+var max_player_count: int = MAX_PLAYERS:
+	set(v):
+		if _mp8_cap_locked and v != _mp8_cap_want:
+			_mp8_cap_warn(v)
+			return
+		max_player_count = v
+
+
+func _mp8_cap_warn(v: int) -> void :
+
+	var now: float = float(Time.get_ticks_msec()) / 1000.0
+
+	# Same value within 5 s: count only.
+	if v == _mp8_cap_warn_val and _mp8_cap_warn_at >= 0.0 and now - _mp8_cap_warn_at < 5.0:
+		_mp8_cap_warn_skipped += 1
+		return
+
+	var tail: String = ""
+	if _mp8_cap_warn_skipped > 0:
+		tail = "(in the last %.0f s, %d more identical writes suppressed)" % [now - _mp8_cap_warn_at, _mp8_cap_warn_skipped]
+
+	push_warning("[MP8] external code tried to change lobby capacity from %d to %d; ignored%s (see _mp8_cap_locked)" % [
+		_mp8_cap_want, v, tail
+	])
+
+	_mp8_cap_warn_at = now
+	_mp8_cap_warn_val = v
+	_mp8_cap_warn_skipped = 0
 
