+# Who is in the room now, whatever the latch holds: the join rules and the Steam member limit.
+func _mp8_room_live() -> bool:
+	if GameManager.local_game or active_backend == null:
+		return true
+	return mp8_peers_extended(Array(multiplayer.get_peers()))
+
