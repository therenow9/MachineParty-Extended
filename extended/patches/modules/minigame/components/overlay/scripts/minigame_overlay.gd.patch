+# [MP8] Countdown colour and size: a replaced "1" or "GO!" is red, and only the "GO!" slogan is
+# enlarged; anything else gets the stock colour and size back.
+func _mp8_apply_countdown_style(token: String) -> void :
+
+	# Master switch: a minigame that set no MP8 field returns here without a single theme
+	# override, so it behaves exactly like stock.
+	if not (mp8_shake_on_go or mp8_go_text != "" or mp8_one_text != ""):
+		return
+
+	if countdown_label == null:
+		return
+
+	if not _mp8_label_base_saved:
+		_mp8_label_base_color = countdown_label.get_theme_color("font_color")
+		_mp8_label_base_position = countdown_label.position
+		var s: int = countdown_label.get_theme_font_size("font_size")
+		if s > 0:
+			_mp8_label_base_size = s
+		_mp8_label_base_saved = true
+
+	var red: bool = (token == "GO!" and mp8_go_text != "") or (token == "1" and mp8_one_text != "")
+	countdown_label.add_theme_color_override(
+		"font_color", MP8_RED if red else _mp8_label_base_color
+	)
+
+	# Only the GO slogan grows; a replaced "1" keeps the stock size, or it would not fit on one line.
+	var size: int = _mp8_label_base_size
+	if token == "GO!" and mp8_go_text != "":
+		size = int(_mp8_label_base_size * MP8_GO_FONT_SCALE)
+	countdown_label.add_theme_font_size_override("font_size", size)
+
+
+# [MP8] Shakes the label's position on GO; the tween must end at the base position or the next
+# countdown starts off-centre.
+func _mp8_shake_countdown() -> void :
+
+	if countdown_label == null:
+		return
+	if _mp8_shake_tween != null and _mp8_shake_tween.is_valid():
+		_mp8_shake_tween.kill()
+
+	var base: Vector2 = _mp8_label_base_position
+	_mp8_shake_tween = create_tween()
+	for i in MP8_SHAKE_STEPS:
+		var amount: float = MP8_SHAKE_AMPLITUDE * (1.0 - float(i) / float(MP8_SHAKE_STEPS))
+		_mp8_shake_tween.tween_property(
+			countdown_label, "position",
+			base + Vector2(randf_range(-amount, amount), randf_range(-amount, amount)),
+			0.03
+		)
+	_mp8_shake_tween.tween_property(countdown_label, "position", base, 0.05)
+
