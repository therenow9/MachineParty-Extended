+# [MP8] ===== Countdown customisation (empty by default) =====
+# Every minigame shares this overlay: empty fields change nothing; a minigame fills them
+# (duck_hunt.gd's _mp8_setup_countdown). Each machine renders the countdown from the bare tokens
+# "3"/"2"/"1"/"GO!", so ducks and the hunter can see different text with no extra RPC.
+var mp8_go_text: String = ""        # non-empty: replaces the "GO!" text (red, one size larger)
+var mp8_one_text: String = ""       # non-empty: replaces the countdown's "1" entirely (red)
+var mp8_shake_on_go: bool = false
+
+const MP8_RED: Color = Color(1.0, 0.18, 0.18)
+const MP8_GO_FONT_SCALE: float = 1.18   # one size larger
+const MP8_SHAKE_AMPLITUDE: float = 34.0 # pixels
+const MP8_SHAKE_STEPS: int = 16
+
+var _mp8_label_base_color: Color = Color.WHITE
+var _mp8_label_base_size: int = 128
+var _mp8_label_base_saved: bool = false
+var _mp8_label_base_position: Vector2 = Vector2.ZERO
+var _mp8_shake_tween: Tween = null
+
+
 func set_countdown(text: String, _with_fade: bool = true, _fade_time: float = 0.5):
+
+	# [MP8] A mixed room shows the game's countdown, whatever a minigame filled in.
+	if not NetworkManager.mp8_room_extended():
+		_mp8_game_set_countdown(text, _with_fade, _fade_time)
+		return
+	var is_valid_string = false
+	var mp8_token: String = text  # [MP8] the raw token: the match below translates "GO!" in place
+	match text:
+		"3":
+			is_valid_string = true
+			pass
+		"2":
+			is_valid_string = true
+			pass
+		"1":
+			is_valid_string = true
+			pass
+		"GO!":
+			text = tr("LOC_IM_GO")
+			is_valid_string = true
+			pass
+	if is_valid_string:
+		if mp8_token == "GO!" and mp8_go_text != "":
+			countdown_label.text = mp8_go_text
+		elif mp8_token == "1" and mp8_one_text != "":
+			countdown_label.text = mp8_one_text
+		else:
+			countdown_label.text = tr(text)
+	else:
+		print("Invalid string found for countdown label. Skipping text assignment.")
+		countdown_label.text = ""
+
+	_mp8_apply_countdown_style(mp8_token)
+
+	anim_countdown_show.play("RESET")
+	anim_countdown_show.play("show")
+
+	if mp8_token == "GO!" and mp8_shake_on_go:
+		_mp8_shake_countdown()
+
