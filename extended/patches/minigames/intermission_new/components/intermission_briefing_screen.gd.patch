+# [MP8] Test bench (mp8fast / mp8ready): 3 seconds after the briefing screen appears, presses Ready once.
+# Pressing the button, not Globals.debug_skip_brief: skipping the brief compresses the round's timing and
+# exposes a game bug in disco_dodge (shown symbol out of step with symbol_index). The countdown is shown
+# after the button's scene text, which nothing else writes, so restoring it afterwards is safe.
+const MP8_AUTO_READY_SECONDS: int = 3
+
+var _mp8_auto_ready_armed: bool = false     # command-line switch, cached once in _ready()
+var _mp8_auto_ready_running: bool = false   # this showing's countdown is running
+var _mp8_auto_ready_done: bool = false      # this showing has already auto-pressed
+
+# [MP8] Unfocused windows tick the ready cooldown too, or clients cannot ready from the second round on.
+# check_ready_button_cooldown() is the only thing that clears ready_button_on_cooldown and runs after the
+# game_focused gate; _on_ready_button_pressed() returns while on cooldown; show_briefing_screen() never
+# resets it. Every real player's window has focus; only the test bench (_mp8_auto_ready_armed) needs this.
+func _mp8_tick_cooldown_offscreen() -> void :
+
+	if not _mp8_auto_ready_armed:
+		return
+	# A focused window runs the game's own call below; don't tick twice
+	if GameManager.game_focused:
+		return
+
+	check_ready_button_cooldown()
+
+
+# Polled each frame rather than started from show_briefing_screen(): its two near-duplicate call paths
+# (intermission_game_picker.gd) each return early outside the tree, so a countdown started there runs
+# only in the first round. Polling "button pressable and not ready" does not depend on the path.
+func _mp8_tick_auto_ready() -> void :
+
+	if not _mp8_auto_ready_armed:
+		return
+	if _mp8_auto_ready_running or _mp8_auto_ready_done:
+		return
+	if not ready_button_press_allowed:
+		return
+	if button_ready == null or not button_ready.visible:
+		return
+	if is_ready:
+		return
+
+	_mp8_auto_ready_running = true
+	_mp8_auto_ready_countdown()
+
+
+func _mp8_auto_ready_countdown() -> void :
+
+	var base_text: String = ""
+	if label_ready_button:
+		base_text = label_ready_button.text
+
+	for remaining in range(MP8_AUTO_READY_SECONDS, 0, -1):
+
+		if not is_inside_tree():
+			_mp8_auto_ready_running = false
+			return
+		# A player who pressed by hand decides; don't press again and un-ready them
+		if is_ready:
+			break
+
+		if label_ready_button:
+			label_ready_button.text = "%s (%d)" % [base_text, remaining]
+
+		await get_tree().create_timer(1.0, false).timeout
+
+	if label_ready_button:
+		label_ready_button.text = base_text
+
+	_mp8_auto_ready_running = false
+
+	if not is_inside_tree():
+		return
+	if is_ready:
+		return
+	if not ready_button_press_allowed:
+		return
+
+	_mp8_auto_ready_done = true
+	print("[MP8] briefing: countdown done, auto-ready")
+	_on_ready_button_pressed()
+
+
 func _on_ready_button_pressed():
 
 	if ready_button_on_cooldown:
