+
+# [MP8] duplicate() does not remap @export references to the node's own children: a copy keeps pointing
+# at the original's Label3D. Re-resolve each through src.get_path_to() on the copy, as
+# network_manager.gd's _mp8_extend_lobby() does.
+func _mp8_reresolve_children(src: Intermission_UserContainer, dup: Intermission_UserContainer) -> void :
+
+	if is_instance_valid(src.anim_connector):
+		dup.anim_connector = dup.get_node(src.get_path_to(src.anim_connector))
+	if is_instance_valid(src.label_rank):
+		dup.label_rank = dup.get_node(src.get_path_to(src.label_rank))
+	if is_instance_valid(src.label_score):
+		dup.label_score = dup.get_node(src.get_path_to(src.label_score))
+	if is_instance_valid(src.label_name):
+		dup.label_name = dup.get_node(src.get_path_to(src.label_name))
+	if is_instance_valid(src.speaker_connector):
+		dup.speaker_connector = dup.get_node(src.get_path_to(src.speaker_connector))
+
+	var ops: Array[GeometryInstance3D] = []
+	for op in src.opacity_visuals:
+		if is_instance_valid(op):
+			var re = dup.get_node_or_null(src.get_path_to(op))
+			if re != null:
+				ops.append(re)
+	dup.opacity_visuals = ops
+
+	# score_screen / container_order_swapper point at shared external nodes; the copied references are right.
+
