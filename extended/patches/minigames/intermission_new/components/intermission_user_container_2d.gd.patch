 func set_user_data(_score: int, _name: String):
+
+	# [MP8] The game's layout fills the row as the game does, its 9-character cut included (D120).
+	if not mp8_extended:
+		_mp8_game_set_user_data(_score, _name)
+		return
+	state = ContainerState.Normal
+
+	user_score_value = _score
+	var formatted_name = _mp8_format_name(_name)  # [MP8] MP8_NAME_MAX, not the game's 8-character cut
+
+	label_score.text = "%04d" % _score
+	label_name.text = formatted_name
+
+# The game's set_user_data, for the game's layout (D120).
+func _mp8_game_set_user_data(_score: int, _name: String):
 	state = ContainerState.Normal
 
 	user_score_value = _score
