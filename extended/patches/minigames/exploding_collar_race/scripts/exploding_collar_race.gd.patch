+# [MP8] Widens the whole corridor (`mp8minewide=<factor>`, default 1.2). Runs on every machine: these are
+# local scene nodes, and the server RPCs each mine's position, so every machine's walls must match.
+func _mp8_widen_field() -> void :
+
+	var forced: String = _mp8_arg("mp8minewide=")
+	_mp8_wide = (clampf(float(forced), 1.0, 2.0) if forced.is_valid_float() else MP8_WIDE_DEFAULT)
+
+	if is_equal_approx(_mp8_wide, 1.0):
+		print("[MP8] Minefield: widen factor 1.0, field unchanged")
+		return
+
+	# ---- 1. Scale what holds only meshes or Box ----
+	var scaled := PackedStringArray()
+	for path in MP8_WIDE_SCALE_NODES:
+		var n: Node3D = get_node_or_null(path) as Node3D
+		if n == null:
+			push_warning("[MP8] Minefield: %s not found, not widened (the corridor will be misaligned)" % path)
+			continue
+		# x only, assigned rather than multiplied, or each round would be wider than the last
+		n.scale = Vector3(_mp8_wide, n.scale.y, n.scale.z)
+		scaled.append(path)
+
+	# ---- 2. Move, never scale, what holds cylinders/spheres ----
+	var moved: int = 0
+	for parent_path in MP8_WIDE_MOVE_PARENTS:
+		var parent: Node = get_node_or_null(parent_path)
+		if parent == null:
+			push_warning("[MP8] Minefield: %s not found" % parent_path)
+			continue
+		for c in parent.get_children():
+			if c is Node3D:
+				var n3: Node3D = c
+				n3.position = Vector3(n3.position.x * _mp8_wide, n3.position.y, n3.position.z)
+				moved += 1
+
+	# ---- 3. Move the danger sign further right ----
+	var forced_sign: String = _mp8_arg("mp8minesign=")
+	var shift: float = (float(forced_sign) if forced_sign.is_valid_float() else MP8_SIGN_SHIFT_DEFAULT)
+	var sign_note := "not moved"
+	if not is_equal_approx(shift, 0.0):
+		var parts := PackedStringArray()
+		# The visual sits under the scaled Geometry, which multiplies a local offset; dividing by the factor
+		# moves visual and collider the same world distance.
+		var vis: Node3D = get_node_or_null(MP8_SIGN_VISUAL) as Node3D
+		if vis != null:
+			vis.position.x += shift / _mp8_wide
+			parts.append("visual->%.2f" % vis.global_position.x)
+		var col: Node3D = get_node_or_null(MP8_SIGN_COLLIDER) as Node3D
+		if col != null:
+			col.position.x += shift
+			parts.append("collider->%.2f" % col.global_position.x)
+		sign_note = "moved right %.1f m (%s)" % [shift, ", ".join(parts)]
+
+	print("[MP8] Minefield: corridor widened x%.2f - wall inner faces %.2f..%.2f -> %.2f..%.2f, mine area width %.1f -> %.1f" % [
+		_mp8_wide, -8.06, 7.99, -8.06 * _mp8_wide, 7.99 * _mp8_wide,
+		16.0, 16.0 * _mp8_wide
+	])
+	print("[MP8] Minefield: scaled %d nodes (%s); moved %d colliders (cylinders/spheres, not scalable); danger sign %s" % [
+		scaled.size(), ", ".join(scaled), moved, sign_note
+	])
+	print("[MP8] Minefield: harvester KillArea 17.0 -> %.1f wide (corridor %.1f, still spanned)" % [
+		17.0 * _mp8_wide, 16.05 * _mp8_wide
+	])
+
+
+func _mp8_arg(prefix: String) -> String :
+	for a in NetworkManager.mp8_dev_args():
+		if String(a).begins_with(prefix):
+			return String(a).substr(prefix.length())
+	return ""
+
+
+# Default layout: the game's 4 spawns stay, in two rows by z (front z 1.85, back 7.43); new spawns are
+# inserted within each row's x span, 4 per row at 8 players.
+func _mp8_default_spawns(want: int) -> Array :
+
+	var orig: Array = []
+	for n in player_spawn_positions:
+		if n != null and is_instance_valid(n):
+			orig.append(Vector2(n.global_position.x, n.global_position.z))
+	if orig.is_empty():
+		return []
+
+	# Split into two rows by z (5.6 m apart; the mean splits them)
+	var zsum: float = 0.0
+	for o in orig:
+		zsum += o.y
+	var zmid: float = zsum / float(orig.size())
+
+	var rows: Array = [[], []]
+	for o in orig:
+		rows[0 if o.y < zmid else 1].append(o)
+
+	var out: Array = orig.duplicate()
+	var need: int = want - orig.size()
+	var r: int = 0
+
+	# Alternate rows, each time inserting at the midpoint of that row's widest gap
+	while need > 0:
+		var row: Array = rows[r % 2]
+		r += 1
+		if row.size() < 2:
+			continue
+		row.sort_custom(func(a, b): return a.x < b.x)
+		var bi: int = 0
+		var bw: float = -1.0
+		for i in row.size() - 1:
+			var w: float = row[i + 1].x - row[i].x
+			if w > bw:
+				bw = w
+				bi = i
+		var mid := Vector2(
+			(row[bi].x + row[bi + 1].x) * 0.5,
+			(row[bi].y + row[bi + 1].y) * 0.5
+		)
+		row.insert(bi + 1, mid)
+		out.append(mid)
+		need -= 1
+
+	return out
+
+
+func _mp8_apply_spawns(pts: Array) -> void :
+
+	var parent: Node3D = null
+	if player_spawn_positions.size() > 0 and is_instance_valid(player_spawn_positions[0]):
+		parent = player_spawn_positions[0].get_parent() as Node3D
+	if parent == null:
+		push_warning("[MP8] Minefield: spawn parent not found, spawns not topped up")
+		return
+
+	# The game's spawn nodes are reused (moved only above 4 players); missing ones are created
+	var arr: Array[Node3D] = []
+	for i in pts.size():
+		var p: Vector2 = _mp8_clamp(pts[i])
+		var n: Node3D
+		if i < player_spawn_positions.size() and is_instance_valid(player_spawn_positions[i]):
+			n = player_spawn_positions[i]
+		else:
+			n = Marker3D.new()
+			n.name = "MP8Spawn%d" % i
+			parent.add_child(n)
+		n.global_position = Vector3(p.x, 0.0, p.y)
+		arr.append(n)
+
+	player_spawn_positions = arr
+
+
+# [MP8] The x range widens with the corridor (z is not stretched)
+func _mp8_clamp(p: Vector2) -> Vector2 :
+	return Vector2(
+		clampf(p.x, MP8_SPAWN_BOX_MIN.x * _mp8_wide, MP8_SPAWN_BOX_MAX.x * _mp8_wide),
+		clampf(p.y, MP8_SPAWN_BOX_MIN.y, MP8_SPAWN_BOX_MAX.y)
+	)
+
+
+func _mp8_spawn_desc() -> String :
+	var parts := PackedStringArray()
+	for i in player_spawn_positions.size():
+		var n: Node3D = player_spawn_positions[i]
+		if n != null and is_instance_valid(n):
+			parts.append("%d(%.2f,%.2f)" % [i + 1, n.global_position.x, n.global_position.z])
+	return " ".join(parts)
+
+
+func _mp8_load_spawns() -> Array :
+
+	# [MP8] The editor's file, read only in a test build: a shipped build plays the built-in layout (D116).
+	if not NetworkManager.mp8_development_tools_allowed() or not FileAccess.file_exists(MP8_SPAWN_FILE):
+		return []
+	var f := FileAccess.open(MP8_SPAWN_FILE, FileAccess.READ)
+	if f == null:
+		push_warning("[MP8] Minefield: cannot open %s (%d)" % [MP8_SPAWN_FILE, FileAccess.get_open_error()])
+		return []
+
+	var rows: Array = []
+	var ln: int = 0
+	while not f.eof_reached():
+		var line: String = f.get_line().strip_edges()
+		ln += 1
+		if line.is_empty() or line.begins_with("#"):
+			continue
+		var cols: PackedStringArray = line.split(",", false)
+		if cols.size() < 2:
+			push_warning("[MP8] Minefield: spawn file line %d is not 2 numbers, skipped: %s" % [ln, line])
+			continue
+		var x: String = cols[0].strip_edges()
+		var z: String = cols[1].strip_edges()
+		if not (x.is_valid_float() and z.is_valid_float()):
+			push_warning("[MP8] Minefield: spawn file line %d has a non-number, skipped: %s" % [ln, line])
+			continue
+		rows.append(Vector2(float(x), float(z)))
+	f.close()
+	return rows
+
+
+func _mp8_save_spawns() -> bool :
+
+	var f := FileAccess.open(MP8_SPAWN_FILE, FileAccess.WRITE)
+	if f == null:
+		push_warning("[MP8] Minefield: cannot write %s (%d)" % [MP8_SPAWN_FILE, FileAccess.get_open_error()])
+		return false
+
+	f.store_line("# Minefield (mp8game=1) spawn points - one per line: x, z")
+	f.store_line("# Used only at 5+ players; at 4 or fewer the stock 4 spawns are used unchanged.")
+	f.store_line("# The minefield covers x in [-8, +8], z in [-90, -10]; spawns must be before it (z > -10),")
+	f.store_line("#   and below z = +10 (the KillArea behind the start, which kills on spawn).")
+	f.store_line("# Delete this file to go back to the built-in default layout.")
+	f.store_line("# Saved %s" % Time.get_datetime_string_from_system())
+	f.store_line("")
+	for n in player_spawn_positions:
+		if n != null and is_instance_valid(n):
+			f.store_line("%.2f, %.2f" % [n.global_position.x, n.global_position.z])
+	f.close()
+
+	print("[MP8] Minefield: spawns saved -> %s" % ProjectSettings.globalize_path(MP8_SPAWN_FILE))
+	print("[MP8] Minefield: current layout - %s" % _mp8_spawn_desc())
+	return true
+
