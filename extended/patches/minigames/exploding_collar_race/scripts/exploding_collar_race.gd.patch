+# [MP8] Rank scoring overwrites player_scores whole; the game's `+= 1` increments, made as players go,
+# are replaced here because ranks are known only at the end. A mixed room keeps the game's (D116).
+func _mp8_rank_scores() -> void :
+
+	if not NetworkManager.mp8_room_extended():
+		print("[MP8] Minefield: a mixed room, the game's scores kept")
+		return
+
+	var d: int = _mp8_dead_order.size()
+	var f: int = finished_players.size()
+	var rows := PackedStringArray()
+
+	# Everyone starts at 0: a player who neither finished nor died (disconnected, say) scores 0, without the
+	# game's partial points.
+	for id in player_scores.keys():
+		player_scores[id] = 0
+
+	# The dead: the earliest death scores lowest
+	for i in d:
+		var id: int = _mp8_dead_order[i]
+		if player_scores.has(id):
+			player_scores[id] = i
+
+	# Finishers rank above the dead, earlier is higher; full health +1
+	for j in f:
+		var p = finished_players[j]
+		if p == null or not is_instance_valid(p):
+			continue
+		var id: int = p.player_presence.network_id
+		if not player_scores.has(id):
+			continue
+		var s: int = d + (f - 1 - j)
+		var full: bool = (p.lives == p.max_lives)
+		if full:
+			s += 1
+		player_scores[id] = s
+		rows.append("#%d %s %d pts%s" % [
+			j + 1, String(p.player_presence.network_name), s, ("(full health)" if full else "")
+		])
+
+	print("[MP8] Minefield scores (%d players: %d finished / %d dead) - %s%s" % [
+		player_scores.size(), f, d, " | ".join(rows),
+		("" if d == 0 else " || dead (earliest first): %s" % ", ".join(_mp8_dead_names()))
+	])
+
+
+func _mp8_dead_names() -> PackedStringArray :
+	var out := PackedStringArray()
+	for i in _mp8_dead_order.size():
+		var id: int = _mp8_dead_order[i]
+		var nm: String = str(id)
+		if player_characters.has(id) and is_instance_valid(player_characters[id]):
+			nm = String(player_characters[id].player_presence.network_name)
+		out.append("%s %d pts" % [nm, i])
+	return out
+
