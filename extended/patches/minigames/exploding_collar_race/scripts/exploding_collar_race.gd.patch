+		print("[MP8] Minefield: mp8noexpand, field and spawns unchanged (stock control run, needs 4 players)")
+		return
+
+	if mp8_player_count <= 4:
+		print("[MP8] Minefield: %d players, stock field and 4 spawns unchanged" % mp8_player_count)
+		return
+
+	_mp8_widen_field()
+
+	var want: int = mini(maxi(mp8_player_count, 5), MP8_MAX_PLAYERS)
+	var pts: Array = ([] if mp8_args.has("mp8minenofile") else _mp8_load_spawns())
+
+	if pts.is_empty():
+		pts = _mp8_default_spawns(want)
+		_mp8_layout_src = "built-in default (game's 4 + 4 inserted)"
+	else:
+		_mp8_layout_src = "saved file %s" % MP8_SPAWN_FILE
+
+	# Too few saved spawns are topped up from the default: a missing spawn is a player not spawned
+	while pts.size() < want:
+		var fill: Array = _mp8_default_spawns(want)
+		pts.append(fill[pts.size()])
+
+	_mp8_apply_spawns(pts)
+
+	print("[MP8] Minefield: spawns 4 -> %d (%s) - %s" % [
+		player_spawn_positions.size(), _mp8_layout_src, _mp8_spawn_desc()
+	])
