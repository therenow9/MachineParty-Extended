+# [MP8] The markers' positions in the order given, then above 4 players the second row, shuffled: the markers
+# fill first, so a game of up to 4 is the game's own.
+func _mp8_spawn_spots(markers: Array, players: int) -> Array[Vector3]:
+	var spots: Array[Vector3] = []
+	for marker in markers:
+		spots.append(marker.global_position)
+	if players > MP8_GAME_SPOTS:
+		var row := MP8_SECOND_ROW.duplicate()
+		row.shuffle()
+		spots.append_array(row)
+	return spots
+
