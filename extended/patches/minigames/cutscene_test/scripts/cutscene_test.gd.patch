+var mp8_owns_spawns: bool = true
+const MP8_GAME_SPOTS := 4
+const MP8_SECOND_ROW: Array[Vector3] = [Vector3(-6.4, 0.0, 45.5), Vector3(1.7, 0.0, 45.5),
