+		var wait: float = _mp8_wait_for(d)
+
+		parts.append("device %d fuse %.1f s + wait %.1f s = period %.1f s, speed x%.2f (%.1f -> %.1f m/s)%s texture key=%s" % [
+			i + 1, fuse, wait, fuse + wait,
