+# Resets the devices each round: only this mod's state and what attach leaves behind (a retired
+# device sits hidden in BreakSpine with collision off). _mp8_place_devices repositions them.
+# The game's `active` and `deactivated` are left alone: `active` is never set true, and `deactivated` is never read.
+func mp8_device_reset_rpc() -> void :
+	if not _mp8_host_command():
+		return
+	for d in _mp8_devices:
+
+		if not is_instance_valid(d):
+			continue
+
+		# Detach first: going to Idle runs only attached_state.exit(), which leaves the device visual
+		# on the victim. Properties are set directly: this RPC is call_local, so each peer clears its own.
+		if d.attached_to != null and is_instance_valid(d.attached_to):
+			var victim = d.attached_to
+			victim.has_spine_breaker = false
+			victim.mp8_current_device = null
+			if victim.spine_breaker_visual != null:
+				victim.spine_breaker_visual.visible = false
+			victim.set_spinebreaker_visuals()
+
+		d.mp8_retired = false
+		d.attached_to = null
+		d.is_attached = false
+		d.breaking_spine = false
+		d.can_kick = true
+		d.can_proximity_target = true
+		d.can_proximity_attach = true
+		d.players_in_proximity.clear()
+		d.visible = true
+		d.set_collision_layer_value(1, true)
+		d.set_collision_mask_value(1, true)
+
+		if multiplayer.is_server():
+			d.state_machine.transition_to(&"Idle")
+
