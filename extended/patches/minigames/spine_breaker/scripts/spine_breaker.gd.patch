+		var idx: int = _mp8_devices.size() + 1
+		var d = ps.instantiate()
+		d.name = "MP8Device%d" % idx
+		device.get_parent().add_child(d)
+
+		# The scene sets this @export for its own device; an instantiated one needs it set here.
+		d.game_instance = self
