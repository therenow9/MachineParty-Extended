+# Places a device on every peer: its physics runs only on the server, so clients would not see
+# a position set there alone.
+func mp8_device_place_rpc(dev_path: NodePath, pos: Vector3) -> void :
+	if not _mp8_host_command() or not _mp8_valid_layout_position(pos):
+		return
+	var d = get_node_or_null(dev_path)
+	if d == null or not is_instance_valid(d) or not _mp8_devices.has(d):
+		return
+	d.global_position = pos
+	d.velocity = Vector3.ZERO
