+	f.store_line("# Spine Breaker (mp8game=14) spawn point pool")
+	f.store_line("# One point per line: x, z, facing in degrees. Order is priority: fewer players use only the first N:")
+	# Generated from MP8_POOL_BY_COUNT, so the file's note follows the table.
+	f.store_line("#   %s" % _mp8_enable_desc())
+	f.store_line("# Devices are drawn from this pool too (at least %.0f m from every player, relaxed a metre at a time)." % MP8_DEVICE_MIN_GAP)
+	f.store_line("# This file holds every point, the scene's stock 4 included:")
+	f.store_line("#    every player count uses the pool, 4 players too.")
+	f.store_line("# Delete this file to go back to the built-in layout. Safe to edit by hand.")
+	f.store_line("# Saved %s" % Time.get_datetime_string_from_system())
+	f.store_line("")
+	for r in _mp8_pool:
+		var p: Vector3 = r[0]
