+func _mp8_server_command() -> bool:
+	var sender: int = multiplayer.get_remote_sender_id()
+	return sender == get_multiplayer_authority() or (sender == 0 and multiplayer.is_server())
+
+# For relay-only targets. Online the host sends them from initialize(), inside the last client's player_loaded
+# RPC, so its own call carries that client's sender id; on the server the relay delivers them only from the host.
+func _mp8_host_command() -> bool:
+	return multiplayer.is_server() or _mp8_server_command()
+
+func _mp8_valid_layout_position(pos: Vector3) -> bool:
+	return pos.is_finite() and absf(pos.x) <= MP8_LAYOUT_LIMIT and absf(pos.y) <= MP8_LAYOUT_LIMIT and absf(pos.z) <= MP8_LAYOUT_LIMIT
+
