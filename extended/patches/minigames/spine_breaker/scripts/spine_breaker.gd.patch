+			]
+		d.default_speed = d.mp8_speed_base[0] * sp
+		d.new_target_speed = d.mp8_speed_base[1] * sp
+		d.speed_increase_over_time = d.mp8_speed_base[2] * sp
+
+		var tint: Color = (
+			MP8_DEVICE_TINT[i] if i < MP8_DEVICE_TINT.size() else MP8_DEVICE_TINT[0]
+		)
+		# Kept on the device: after attach the device is hidden and its colour shows on the victim's back.
+		d.mp8_tint = tint
+		var painted: int = _mp8_tint_device(d, tint)
+
+		# The hourglass rides the body bone, so it follows the walk. Added once: devices are reused.
+		d.mp8_mark = (MP8_DEVICE_MARK[i] if i < MP8_DEVICE_MARK.size() else MP8_DEVICE_MARK[0])
+		if d.mp8_mark and d.skeleton.get_node_or_null("MP8Mark") == null:
+			var mark: Node3D = d.mp8_make_mark()
+			if mark != null:
