+func _mp8_init_pool(ignore_file: bool) -> void :
+
+	_mp8_pool.clear()
+
+	for r in MP8_POOL_BAKED:
+		_mp8_pool.append([r[0], float(r[1])])
+	_mp8_pool_src = "built-in layout"
+
+	# An empty MP8_POOL_BAKED falls back to the scene's markers, read at runtime.
+	if _mp8_pool.is_empty() and player_spawn_positions_node != null:
+		for c in player_spawn_positions_node.get_children():
+			if not (c is Node3D):
+				continue
+			var n3: Node3D = c
+			var rot: Vector3 = n3.rotation_degrees
+			# Only yaw matters for a spawn; any x/z rotation is reported, not silently dropped.
+			if absf(rot.x) > 0.01 or absf(rot.z) > 0.01:
+				push_warning("[MP8] Spine Breaker: spawn %s has x/z rotation %s, using y only" % [
+					String(n3.name), str(rot)
+				])
+			_mp8_pool.append([n3.global_position, rot.y])
+		_mp8_pool_src = "scene default"
+
+	var from_scene: int = _mp8_pool.size()
+
+	if not ignore_file:
+		var rows: Array = _mp8_load_layout_file()
+		if not rows.is_empty():
+			_mp8_pool = rows
+			_mp8_pool_src = "saved file (%d points)" % rows.size()
+
+	if _mp8_pool.is_empty():
+		push_warning("[MP8] Spine Breaker: the spawn pool is empty, falling back to the game's container")
+		return
+
+	print("[MP8] Spine Breaker: spawn pool of %d, source=%s (%d built in); enabled %s" % [
+		_mp8_pool.size(), _mp8_pool_src, from_scene, _mp8_enable_desc()
+	])
