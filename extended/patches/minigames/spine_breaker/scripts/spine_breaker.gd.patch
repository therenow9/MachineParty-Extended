+		# The main scene overrides only activation_duration on its Device; the fuse is set per device below.
+
+		# [MP8] Devices never collide with each other: attached devices both wait at Vector3.DOWN * 100,
+		# and when they reset together the overlap would launch one into the sky. A collision exception
+		# leaves their collisions with floor, walls and players unchanged.
+		for other in _mp8_devices:
+			if is_instance_valid(other):
+				d.add_collision_exception_with(other)
+				other.add_collision_exception_with(d)
