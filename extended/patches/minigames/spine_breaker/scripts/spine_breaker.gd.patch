+# Exactly n spawns, from every branch: a player who is not spawned can keep check_game_end()
+# from ever reaching active_players <= 1, and this minigame has no timeout.
+func _mp8_pick_spawns(n: int) -> Array :
+	return _mp8_ensure_count(_mp8_pick_rows(n), n)
+
+
+func _mp8_ensure_count(rows: Array, n: int) -> Array :
+
+	if rows.size() == n:
+		return rows
+	if rows.size() > n:
+		return rows.slice(0, n)
+
+	if rows.is_empty():
+		push_warning("[MP8] Spine Breaker: no spawn points at all, all %d players at the origin" % n)
+		var zero: Array = []
+		for i in n:
+			zero.append([Vector3.ZERO, 0.0])
+		return zero
+
+	# Fewer points than players: reuse them cyclically. Stacked players can still play.
+	push_warning("[MP8] Spine Breaker: the pool gave %d points for %d players, reusing points cyclically" % [rows.size(), n])
+	var base: int = rows.size()
+	var out: Array = rows.duplicate()
+	for i in range(n - base):
+		out.append(out[i % base])
+	return out
+
+
+# Enables the first N points for the player count and picks n of them at random, a minimum gap apart.
+func _mp8_pick_rows(n: int) -> Array :
+
+	if _mp8_pool.is_empty():
+		# No pool: the game's container (_mp8_ensure_count fixes the length).
+		var out: Array = []
+		if player_spawn_positions_node != null:
+			for c in player_spawn_positions_node.get_children():
+				if c is Node3D:
+					out.append([(c as Node3D).global_position, (c as Node3D).rotation_degrees.y])
+		return out
+
+	# Not clampi(enabled, n, pool.size()): with more players than points min > max, and clampi returns
+	# the lower bound, an index past the pool. A shortfall is _mp8_ensure_count's job.
+	var enabled: int = int(MP8_POOL_BY_COUNT.get(n, _mp8_pool.size()))
+	enabled = maxi(mini(enabled, _mp8_pool.size()), 1)
+
+	var idx: Array = range(enabled)
+
+	# In the spawn editor, no shuffle: the first n points in order, so each point maps to a player.
+	if _mp8_edit_on:
+		return _mp8_rows(idx.slice(0, n))
+
+	idx.shuffle()
+
+	# Greedy: skip points too close; if a pass falls short, relax the gap and retry. Never return
+	# fewer than n (see _mp8_pick_spawns).
+	var gap: float = MP8_PICK_MIN_GAP
+	while gap > 0.0:
+		var chosen: Array = []
+		for i in idx:
+			var p: Vector3 = _mp8_pool[i][0]
+			var ok: bool = true
+			for c in chosen:
+				if p.distance_to(_mp8_pool[c][0]) < gap:
+					ok = false
+					break
+			if ok:
+				chosen.append(i)
+			if chosen.size() >= n:
+				break
+		if chosen.size() >= n:
+			if gap < MP8_PICK_MIN_GAP:
+				print("[MP8] Spine Breaker: %d players needed the minimum gap relaxed to %.1f m (pool too crowded or too few points enabled)" % [n, gap])
+			return _mp8_rows(chosen)
+		gap -= 1.0
+
+	# Fewer enabled points than players: reuse points (players stack, none is missing).
+	push_warning("[MP8] Spine Breaker: %d enabled points cannot seat %d players, spawn points repeat" % [enabled, n])
+	var fill: Array = []
+	for i in n:
+		fill.append(idx[i % idx.size()])
+	return _mp8_rows(fill)
+
