+	# Logged as code ready to paste into MP8_POOL_BAKED.
+	var snippet := PackedStringArray()
+	for r in _mp8_pool:
+		var p: Vector3 = r[0]
+		snippet.append("\t[Vector3(%.2f, 0.0, %.2f), %.1f]," % [p.x, p.z, float(r[1])])
+	print("[MP8] Spine Breaker: spawn pool saved (%d) -> %s" % [
+		_mp8_pool.size(), ProjectSettings.globalize_path(MP8_LAYOUT_FILE)
+	])
+	print("[MP8] Spine Breaker: ready to paste into the code - \n%s" % "\n".join(snippet))
