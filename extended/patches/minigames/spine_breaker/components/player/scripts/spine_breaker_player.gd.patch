+# [MP8] The device to throw: the one whose `attached_to` is this player, written by attached_state on
+# the server. `has_spine_breaker` and `mp8_current_device` are set by separate RPCs and can disagree,
+# and `_mp8_dev()`'s fallback may name a device on someone else or in the air. None -> no throw.
+# Server only (attached_to is null on clients). break_spine_rpc keeps `_mp8_dev()` and its fallback.
+func _mp8_dev_to_throw() -> SpineBreakerDevice :
+
+	if mp8_current_device != null and is_instance_valid(mp8_current_device) \
+			and mp8_current_device.attached_to == self:
+		return mp8_current_device
+
+	if game_instance != null:
+		var list = game_instance.get("_mp8_devices")
+		if list is Array:
+			for d in list:
+				if is_instance_valid(d) and d.attached_to == self:
+					return d
+
+	return null
