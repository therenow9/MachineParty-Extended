+# [MP8] Tints the device seen on this player's back with c (Color.WHITE restores it): surface 3 of the
+# attached character mesh, found by texture name (empty tex_key tints every textured surface), not the
+# hidden device or `spine_breaker_visual`. mark (mp8_make_mark) replaces the previous one on bone 34,
+# `main body`, whose pose scale shows and hides the back visual, so the mark goes with it.
+func mp8_set_visual_tint(c: Color, tex_key: String = "", mark: Node3D = null) -> int :
+
+	# Undo the previous tint by restoring each surface's earlier override: player customization may
+	# have set one, and clearing to null would erase it.
+	for row in _mp8_tinted:
+		var old_mi = row[0]
+		if is_instance_valid(old_mi):
+			old_mi.set_surface_override_material(row[1], row[2])
+	_mp8_tinted.clear()
+
+	# Out of the tree at once, so the next mark takes its name.
+	if _mp8_back_mark != null and is_instance_valid(_mp8_back_mark):
+		_mp8_back_mark.get_parent().remove_child(_mp8_back_mark)
+		_mp8_back_mark.queue_free()
+	_mp8_back_mark = null
+
+	if mark != null:
+		if skeleton_attached != null:
+			var ba := BoneAttachment3D.new()
+			ba.name = "MP8Mark"
+			ba.bone_name = SpineBreakerDevice.MP8_MARK_BONE
+			skeleton_attached.add_child(ba)
+			ba.add_child(mark)
+			_mp8_back_mark = ba
+		else:
+			mark.free()
+
+	if c == Color.WHITE or visuals == null:
+		return 0
+
+	var n: int = 0
+
+	for node in visuals.find_children("", "MeshInstance3D", true, false):
+
+		var mi: MeshInstance3D = node
+		if mi.mesh == null:
+			continue
+
+		for s in mi.mesh.get_surface_count():
+
+			var src = mi.get_active_material(s)
+			if not (src is StandardMaterial3D):
+				continue
+
+			var sd: StandardMaterial3D = src
+			if sd.albedo_texture == null:
+				continue
+
+			if tex_key != "":
+				var f: String = str(sd.albedo_texture.resource_path).get_file()
+				if not f.ends_with(tex_key):
+					continue
+
+			var m: StandardMaterial3D = sd.duplicate()
+			m.albedo_color = c
+			_mp8_tinted.append([mi, s, mi.get_surface_override_material(s)])
+			mi.set_surface_override_material(s, m)
+			n += 1
+
+	return n
