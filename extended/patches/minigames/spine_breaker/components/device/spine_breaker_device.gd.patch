+# [MP8] Tells the player which device is on their back. The player's `spine_breaker_device` is the
+# first device, fixed in setup_rpc(), so throwing would throw the wrong one. call_local on every
+# peer: the player's _process syncs the blink from this device on clients too, where attached_to is null.
+func mp8_bind_rpc(player_path: NodePath) -> void :
+
+	var p = get_node_or_null(player_path)
+	if p == null:
+		# A failed bind makes the carrier throw the other device; it must be visible.
+		push_warning("[MP8] Spine Breaker: device %d cannot bind to the player - node %s not found" % [
+			mp8_index, str(player_path)
+		])
+		if multiplayer.is_server():
+			print("[MP8] Spine Breaker: ⚠️ device %d failed to bind, path %s" % [mp8_index, str(player_path)])
+		return
+
+	p.mp8_current_device = self
+
+	# [MP8] The device is hidden now, so its colour and hourglass show only on the visual on their back
+	# (spine_breaker_player.mp8_set_visual_tint). Set on every attach, so a white device replaces a dark one.
+	var painted: int = p.mp8_set_visual_tint(mp8_tint, mp8_tex_key, mp8_make_mark())
+
+	if multiplayer.is_server():
+		# The surface count shows a bind that tinted nothing.
+		print("[MP8] Spine Breaker: device %d bound to %s (back visual tinted on %d surfaces)" % [
+			mp8_index, String(p.name), painted
+		])
+
+
+# [MP8] A new hourglass at the mark's frame, for a BoneAttachment3D on MP8_MARK_BONE; null when this
+# device has none. Two triangles tip to tip, the long axis along the spine. Built in code: the patch
+# system adds no files.
+func mp8_make_mark() -> Node3D :
+
+	if not mp8_mark or not _mp8_measure_mark():
+		return null
+
+	var l: float = MP8_MARK_LENGTH
+	var w: float = l * 0.55
+	var waist: float = l * 0.06
+	var st := SurfaceTool.new()
+	st.begin(Mesh.PRIMITIVE_TRIANGLES)
+	st.set_normal(Vector3.UP)
+	for t in [[Vector3(-w / 2, 0, -l / 2), Vector3(w / 2, 0, -l / 2), Vector3(0, 0, waist)],
+			[Vector3(0, 0, -waist), Vector3(w / 2, 0, l / 2), Vector3(-w / 2, 0, l / 2)]]:
+		for v in t:
+			st.add_vertex(v)
+
+	var m := StandardMaterial3D.new()
+	m.albedo_color = MP8_MARK_ALBEDO
+	m.cull_mode = BaseMaterial3D.CULL_DISABLED
+	m.emission_enabled = true
+	m.emission = MP8_MARK_GLOW
+	m.emission_energy_multiplier = MP8_MARK_ENERGY
+
+	var mi := MeshInstance3D.new()
+	mi.mesh = st.commit()
+	mi.material_override = m
+	# Just above the body's top surface, so it does not flicker against it.
+	mi.position = Vector3.UP * 0.03
+
+	var root := Node3D.new()
+	root.name = "MP8Hourglass"
+	root.transform = _mp8_mark_frame
+	root.add_child(mi)
+	return root
+
+
+# [MP8] The mark's frame in the body bone's space, on the body's top behind its middle (the head
+# stands over the front). From the vertices that bone carries most, mapped into its space by the
+# skin's bind poses; up and forward from the rest pose relative to `visuals`, so no walk pose tilts it.
+func _mp8_measure_mark() -> bool :
+
+	if _mp8_mark_measured != 0:
+		return _mp8_mark_measured > 0
+	_mp8_mark_measured = -1
+
+	var bone: int = skeleton.find_bone(MP8_MARK_BONE) if skeleton != null else -1
+	var mi: MeshInstance3D = null
+	if bone >= 0:
+		for ch in skeleton.get_children():
+			if ch is MeshInstance3D and ch.visible and ch.mesh != null:
+				mi = ch
+				break
+	if mi == null or not is_inside_tree():
+		push_warning("[MP8] Spine Breaker: device %d has no %s bone or body mesh, no hourglass" % [mp8_index, MP8_MARK_BONE])
+		return false
+
+	var arr: Array = mi.mesh.surface_get_arrays(0)
+	var verts: PackedVector3Array = arr[Mesh.ARRAY_VERTEX]
+	var bones = arr[Mesh.ARRAY_BONES]
+	var weights = arr[Mesh.ARRAY_WEIGHTS]
+	var per: int = bones.size() / verts.size()
+	var skin: Skin = mi.skin
+	var pts := PackedVector3Array()
+
+	for v in verts.size():
+		var best: int = 0
+		var bw: float = -1.0
+		for k in per:
+			if weights[v * per + k] > bw:
+				bw = weights[v * per + k]
+				best = int(bones[v * per + k])
+		var sb: int = best
+		if skin != null:
+			sb = skin.get_bind_bone(best)
+			if sb < 0:
+				sb = skeleton.find_bone(skin.get_bind_name(best))
+		if sb != bone:
+			continue
+		pts.append(skin.get_bind_pose(best) * verts[v] if skin != null else skeleton.get_bone_global_rest(bone).affine_inverse() * verts[v])
+
+	if pts.is_empty():
+		push_warning("[MP8] Spine Breaker: device %d's body mesh has no vertices on %s, no hourglass" % [mp8_index, MP8_MARK_BONE])
+		return false
+
+	var rest: Transform3D = visuals.global_transform.affine_inverse() * skeleton.global_transform * skeleton.get_bone_global_rest(bone)
+	var to_bone: Basis = rest.basis.inverse()
+	var up: Vector3 = (to_bone * Vector3.UP).normalized()
+	var fwd: Vector3 = (to_bone * Vector3.FORWARD).normalized()
+	fwd = (fwd - up * fwd.dot(up)).normalized()
+
+	var lo := Vector3.INF
+	var hi := -Vector3.INF
+	for p in pts:
+		lo = lo.min(p)
+		hi = hi.max(p)
+	var c: Vector3 = (lo + hi) * 0.5 - fwd * 0.18
+	var top: float = -INF
+	for p in pts:
+		var off: Vector3 = p - c
+		if (off - up * off.dot(up)).length() < 0.22:
+			top = maxf(top, p.dot(up))
+	if top == -INF:
+		push_warning("[MP8] Spine Breaker: device %d found no body top for the hourglass" % mp8_index)
+		return false
+
+	var origin: Vector3 = c + up * (top - c.dot(up))
+	_mp8_mark_frame = Transform3D(Basis(up.cross(-fwd).normalized(), up, -fwd), origin)
+	_mp8_mark_measured = 1
+	print("[MP8] Spine Breaker: device %d hourglass on %s at %s, up %s, forward %s (%d vertices)" % [
+		mp8_index, MP8_MARK_BONE, origin, up, fwd, pts.size()
+	])
+	return true
+
 
