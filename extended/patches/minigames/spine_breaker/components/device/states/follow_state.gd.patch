+# [MP8] Stuck -> sidestep. A player carrying one device can't be taken by the other
+# (`_mp8_can_take`), so they can body-block it in place. Re-pathing does not help: the navigation
+# mesh has no players or devices in it, so the device slides sideways around the block instead.
+const MP8_STUCK_RATIO: float = 0.35   # moved less than this fraction of the intended distance = blocked
+const MP8_STUCK_SECS: float = 0.5     # blocked this long counts as stuck (a brush does not)
+const MP8_DODGE_SECS: float = 0.8     # duration of one sidestep
+
+var _mp8_stuck: float = 0.0
+var _mp8_dodge_left: float = 0.0
+var _mp8_dodge_dir: Vector3 = Vector3.ZERO
+var _mp8_dodge_count: int = 0
+
+# [MP8] Dead-end target: a target that can never be taken (already carrying a device) is never
+# dropped. update_proximity_check skips them and retargets only to another takeable player nearby
+# (`target_distance` is always INF); request_new_target only follows a kill. So the device asks the
+# host for a new target, on a cooldown: `_mp8_pick_prey()` may return null and must be asked again.
+const MP8_DEADEND_RETRY: float = 4.0   # longer than the longest MP8_DEVICE_WAIT (3 s), so it does not race the reassignment
+var _mp8_deadend_cd: float = 0.0
