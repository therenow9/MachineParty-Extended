+		_mp8_stuck = 0.0
+		return
+
+	_mp8_stuck += _delta
+	if _mp8_stuck < MP8_STUCK_SECS:
+		return
+
+	_mp8_stuck = 0.0
+	_mp8_dodge_dir = _mp8_pick_dodge(dir)
+	_mp8_dodge_left = MP8_DODGE_SECS
+	_mp8_dodge_count += 1
+
+	# Logged once per chase.
+	if _mp8_dodge_count == 1 and multiplayer.is_server():
+		print("[MP8] Spine Breaker: device %d is blocked, sidestepping (target %s)" % [
+			owner.mp8_index, (String(target.name) if target != null else "?")
+		])
+
+
+# Sidestep along the blocking surface's tangent, the one that does not go backwards.
+# With no wall normal (wedged between two bodies), the perpendicular of the current direction.
+func _mp8_pick_dodge(dir: Vector3) -> Vector3 :
+
+	var n: Vector3 = Vector3.ZERO
+	for i in owner.get_slide_collision_count():
+		var cn: Vector3 = owner.get_slide_collision(i).get_normal()
+		if absf(cn.y) < 0.7:        # vertical surfaces only, not the floor
+			n = cn
+			break
+
+	var side: Vector3 = (n.cross(Vector3.UP) if n != Vector3.ZERO else dir.cross(Vector3.UP))
+	side.y = 0.0
+	if side.length() < 0.01:
+		return dir
+	side = side.normalized()
+
+	if side.dot(dir) < 0.0:         # the tangent on the same side as the path direction
+		side = - side
+
+	# Part path direction, so the sidestep rejoins the path once past the block.
+	return (side * 0.8 + dir * 0.4).normalized()
+
