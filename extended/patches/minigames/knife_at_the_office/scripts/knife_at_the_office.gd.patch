+# [MP8V] machine-party-8p's Inside Job
+# Adapted from machine-party-8p's knife_at_the_office.gd and scene: vanilla's one syringe, turning up on
+# the Nth search overall, N clamped to what the office can reach; eight spawn markers; vanilla scoring.
+# A container is searched once, so N above the searchable count never comes and the hunt never starts.
+const MP8V_SEARCH_MARGIN: int = 2
+# 8p's knife_at_the_office.tscn adds four markers to PlayerSpawnPositions, each 1.2 along x from a
+# shipped one, unrotated as the shipped ones are; [shipped marker index, position under PlayerSpawnPositions].
+const MP8V_ADDED_MARKERS: Array = [
+	[0, Vector3(-3.82012, 0.0, -6.68596)],
+	[1, Vector3(6.2386, 0.0, -7.46958)],
+	[2, Vector3(-3.77804, 0.0, -2.71269)],
+	[3, Vector3(6.14438, 0.0, -2.16074)],
+]
+
+
+# The margin keeps the find off the very last container. Counted over the reachable searchables
+# (the list _mp8_collect_searchables fills, without the two sealed-room ones), so the margin is real.
+static func _mp8v_clamp_target(rolled: int, searchable_count: int) -> int :
+	return mini(rolled, maxi(searchable_count - MP8V_SEARCH_MARGIN, 1))
+
+
+func _mp8v_add_spawns() -> void :
+
+	# The room is latched before this scene's add_child (game.gd). A mixed room keeps the game's 4 (D116).
+	if not NetworkManager.mp8_room_extended():
+		print("[MP8] Inside Job: a mixed room, the game's spawns unchanged")
+		return
+
+	if player_spawn_positions_node == null:
+		return
+	var shipped: Array[Node] = player_spawn_positions_node.get_children()
+	if shipped.size() != MP8V_ADDED_MARKERS.size():
+		return
+	for row in MP8V_ADDED_MARKERS:
+		var twin: Node3D = shipped[row[0]] as Node3D
+		var added: Node3D = twin.duplicate()
+		added.name = "%s_MP8V" % twin.name
+		player_spawn_positions_node.add_child(added)
+		added.position = row[1]
+
+
+# Runs after vanilla's roll in spawn_players: the rolled target is already in guaranteed_search_result.
+func _mp8v_setup_search() -> void :
+
+	mp8_player_count = PlayerManager.player_presences.size()
+
+	_mp8_collect_searchables()
+	var rolled: int = guaranteed_search_result
+	guaranteed_search_result = _mp8v_clamp_target(rolled, searchables.size())
+
+	var markers: int = player_spawn_positions_node.get_child_count() if player_spawn_positions_node != null else 0
+	print("[MP8] Inside Job 8p: %d players, %d markers, %d searchables, 1 syringe, search target %d (rolled %d)" % [
+		mp8_player_count, markers, searchables.size(), guaranteed_search_result, rolled])
