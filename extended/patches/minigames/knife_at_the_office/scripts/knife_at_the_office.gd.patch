+# [MP8] Fills vanilla's declared-but-never-filled `searchables` with the scene's real containers,
+# found by type (the scene has 36, not the 26 vanilla's roll assumes), minus the sealed-room two.
+func _mp8_collect_searchables() -> void :
+
+	if mp8_searchables_collected:
+		return
+	# A mixed room leaves the game's searchables unfilled and every container on (D120).
+	if not NetworkManager.mp8_room_extended():
+		print("[MP8] Inside Job: a mixed room, every container left on")
+		return
+	mp8_searchables_collected = true
+
+	searchables.clear()
+	var stack: Array = [self]
+	var disabled_count: int = 0
+	var raw_index: int = 0
+	while not stack.is_empty():
+		var node: Node = stack.pop_back()
+		if node is KnifeAtTheOfficeSearchable:
+			var searchable := node as KnifeAtTheOfficeSearchable
+			# The mp8knifemark labels show the index before filtering, so #7 does not become #5.
+			searchable.set_meta(&"mp8_raw_searchable_index", raw_index)
+			raw_index += 1
+			if _mp8_disable_searchable_if_needed(searchable):
+				disabled_count += 1
+			else:
+				searchables.append(searchable)
+		for c in node.get_children():
+			stack.append(c)
+
+	if disabled_count != MP8_DISABLED_SEARCHABLE_PATHS.size():
+		push_warning("[MP8] Inside Job: expected to disable %d unreachable containers, matched %d; the scene paths may have changed" % [
+			MP8_DISABLED_SEARCHABLE_PATHS.size(), disabled_count])
+	else:
+		print("[MP8] Inside Job: unreachable containers #5/#6 disabled; %d searchable containers" % searchables.size())
+
+
+func _mp8_disable_searchable_if_needed(node: KnifeAtTheOfficeSearchable) -> bool :
+
+	var relative_path: String = String(get_path_to(node))
+	if not MP8_DISABLED_SEARCHABLE_PATHS.has(relative_path):
+		return false
+
+	# Players find a Searchable through area_entered; clearing all four hides it from them and
+	# stops it detecting anything. Its visual children are untouched.
+	node.monitoring = false
+	node.monitorable = false
+	node.collision_layer = 0
+	node.collision_mask = 0
+	return true
+
