+# ------------------------------------------------------------------ [MP8] Score multiplier
+# Largest team / this team, sent by forklift_certified._mp8_refresh_score_mults(); 1 with one player per bay.
+# Elimination, the lead light and this counter must all use the multiplied score, so players see what is
+# judged. Only the `ach_crate_number` achievement counts real crates.
+var mp8_score_mult: int = 1
+
+func mp8_set_score_mult_rpc(mult: int):
+
+	mp8_score_mult = maxi(1, mult)
+
+	# The multiplier can change mid-round (a teammate leaves), so the counter is refreshed now. Only the
+	# server maintains `crates_in_area`, so it computes and broadcasts the value.
+	if multiplayer.is_server():
+		update_counter_rpc.rpc(crates_in_area.size() * mp8_score_mult)
