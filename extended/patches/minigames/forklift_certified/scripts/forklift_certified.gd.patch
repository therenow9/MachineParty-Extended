+	if screen != null:
+		screen.position *= s
+	for c in get_children():
+		if c is OmniLight3D:
+			(c as OmniLight3D).position *= s
+			(c as OmniLight3D).omni_range *= maxf(yard.x, yard.y)
+	for area in grid:
+		area.position *= s
+
+	# The magnet's beam rests across the yard between the camera and the bays, in world space; it rests and
+	# returns as far out as the room grows, or the fitted camera sees it as a bar along the bottom of the shot.
+	var magnet: MagnetManager = crate_manager.magnet if crate_manager != null else null
+	if magnet != null and magnet.pos_home != null and magnet.axis_vertical != null:
+		magnet.pos_home.position *= s
+		magnet.axis_vertical.global_position.z *= yard.y
+	else:
+		push_warning("[MP8] Forklift Certified 8p: no magnet rig; its beam may show at the bottom of the shot")
+
+	var d0: float = cam.global_position.length()
+	_mp8v_fit_camera(cam, stock_groups, _mp8v_frame_groups(walls, grid))
+	print("[MP8] Forklift Certified 8p: yard x%.2f, z%.2f; walls %.1f x %.1f m, floor x%.2f; camera %.1f -> %.1f, forklifts drawn x%.2f" % [
+		yard.x, yard.y, walls.size.x, walls.size.z, yard.x * yard.y, d0, cam.global_position.length(),
+		d0 / cam.global_position.length()])
+
+
+# What the camera keeps framed as it was, group by group: the floor's corners (the near ones sit below the
+# shipped frame) and the shipped bays' readouts, which must stay in it.
+func _mp8v_frame_groups(walls: CSGBox3D, grid: Array[Node3D]) -> Array :
+	var c: Vector3 = walls.global_position
+	var hx: float = walls.size.x * 0.5
+	var hz: float = walls.size.z * 0.5
+	var corners: Array[Vector3] = [Vector3(c.x - hx, 0.0, c.z - hz), Vector3(c.x + hx, 0.0, c.z - hz),
+		Vector3(c.x - hx, 0.0, c.z + hz), Vector3(c.x + hx, 0.0, c.z + hz)]
+	var readouts: Array[Vector3] = []
+	for area in grid:
+		var readout: Node3D = area.get("display_background_mesh_instance") as Node3D
+		if readout != null:
+			readouts.append(readout.global_position)
+	return [corners, readouts]
+
+
+# (largest |x|, largest y, smallest y) of the points' view slopes from a camera at xf; slopes need no fov.
+func _mp8v_view_slopes(xf: Transform3D, points: Array) -> Vector3 :
+	var out: Vector3 = Vector3(0.0, -INF, INF)
+	for p in points:
+		var v: Vector3 = xf.affine_inverse() * p
+		var depth: float = maxf(-v.z, 0.001)
+		out.x = maxf(out.x, absf(v.x / depth))
+		out.y = maxf(out.y, v.y / depth)
+		out.z = minf(out.z, v.y / depth)
+	return out
+
+
+# The stock orientation, slid back along the view axis until the
+# scaled yard's frame groups each sit no further out in the frame than the shipped ones do.
+func _mp8v_fit_camera(cam: Camera3D, stock_groups: Array, groups: Array) -> void :
+
+	var xf: Transform3D = cam.global_transform
+	var limits: Array[Vector3] = []
+	for g in stock_groups:
+		limits.append(_mp8v_view_slopes(xf, g))
+	# The readouts (group 1) bound only the bottom: the near row's are the lowest thing in the shipped frame.
+	limits[1] = Vector3(INF, INF, limits[1].z)
+	var back: Vector3 = xf.basis.z.normalized()
+	var origin: Vector3 = xf.origin
+	var t: float = 0.0
+	while t < 200.0:
+		xf.origin = origin + back * t
+		var fits: bool = true
+		for i in groups.size():
+			var v: Vector3 = _mp8v_view_slopes(xf, groups[i])
+			var limit: Vector3 = limits[i]
+			if v.x > limit.x + 0.0001 or v.y > limit.y + 0.0001 or v.z < limit.z - 0.0001:
+				fits = false
+		if fits:
+			break
+		t += 0.25
+	if t >= 200.0:
+		push_warning("[MP8] Forklift Certified 8p: the camera fit did not converge; the camera stays")
+		return
+	# The sway animation keys the camera's position as well as its rotation, every frame, so the move goes on
+	# its parent; the parent's other children (the walls) are moved back to stay where they are.
+	var offset: Vector3 = xf.origin - origin
+	var holder: Node3D = cam.get_parent() as Node3D
+	if holder == null:
+		push_warning("[MP8] Forklift Certified 8p: the camera has no 3D parent; the camera stays")
+		return
+	holder.position += offset
+	for c in holder.get_children():
+		if c != cam and c is Node3D:
+			(c as Node3D).position -= offset
