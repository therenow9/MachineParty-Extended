+	var decal: Node3D = blood_decals_environment_parent.get_child(0)
+	decal.get_parent().remove_child(decal)
+	add_child(decal)
+	decal.global_position = _at_pos
+	decal.global_rotation = Vector3(decal.global_rotation.x, randf_range(0, 360), decal.global_rotation.z)
+
+
+# ============================================================== [MP8] Team helpers
+
+func _mp8_members_of_area(area) -> Array :
+
+	# The roster first; before it is built, vanilla's single belongs_to_id.
+	var idx: int = delivery_areas.find(area)
+	if idx >= 0 and idx < _mp8_area_members.size():
+		var members: Array = _mp8_area_members[idx]
+		if not members.is_empty():
+			return members
+
+	if area.belongs_to_id > check_id_threshold:
+		return [area.belongs_to_id]
+	return []
+
+
+func _mp8_area_has_member(area, network_id: int) -> bool :
+	return _mp8_members_of_area(area).has(network_id)
+
+
+# Teams with at least one player alive; equals active_players.size() with one player per bay.
+func _mp8_active_team_count() -> int :
+
+	if _mp8_area_members.is_empty():
+		return active_players.size()
+
+	var n: int = 0
+	for members in _mp8_area_members:
+		for pid in members:
+			if active_players.has(pid):
+				n += 1
+				break
+	return n
+
+
+# Score multiplier per bay = largest team / this team. Elimination, the lead light and the bay counter use
+# the multiplied count; the achievement uses the real one. With one player per bay it is 1; only a yard
+# that could not expand doubles players up.
+func _mp8_refresh_score_mults() -> void :
+
+	# A mixed room sends neither the multipliers nor their counter refresh; every bay keeps 1 (D116).
+	if not NetworkManager.mp8_room_extended():
+		return
+
+	var areas: Array = delivery_area_parent.get_children()
+
+	var max_team: int = 1
+	for members in _mp8_area_members:
+		max_team = maxi(max_team, (members as Array).size())
+
+	for i in _mp8_area_members.size():
+		if i >= areas.size():
+			continue
+		var n: int = (_mp8_area_members[i] as Array).size()
+		if n <= 0:
+			continue
+		NetworkManager.mp8_rpc(areas[i], &"mp8_set_score_mult_rpc", [max_team / n])
+
+
+func _mp8_area_score(area) -> int :
+	return area.crates_in_area.size() * area.mp8_score_mult
+
+
+func _mp8_light_team(area, on: bool) -> void :
+
+	for pid in _mp8_members_of_area(area):
+		# has(): between a player's elimination and the bay closing, a crate knocked out of the bay
+		# reaches here for a player no longer in active_players.
+		if active_players.has(pid):
+			active_players[pid].set_indicator_light_rpc.rpc(on)
+
+
+func _mp8_log_teams() -> void :
+
+	var areas: Array = delivery_area_parent.get_children()
+
+	var lines := PackedStringArray()
+	for i in _mp8_area_members.size():
+		var members: Array = _mp8_area_members[i]
+		if members.is_empty():
+			continue
+		var names := PackedStringArray()
+		for pid in members:
+			names.append("%s(%d)" % [_mp8_name_of(pid), pid])
+		var mult: int = (int(areas[i].mp8_score_mult) if i < areas.size() else 1)
+		lines.append("bay%d=[%s]%s" % [
+			i, ", ".join(names), ("" if mult <= 1 else " x%d per crate" % mult)
+		])
+
+	print("[MP8] Forklift Certified: %d players in %d teams - %s" % [
+		player_count, _mp8_active_team_count(), "  ".join(lines)
+	])
+
+	# The smallest distance between the spawns in use: a count alone does not show two forklifts overlapping.
+	var used: Array = []
+	for i in _mp8_area_members.size():
+		for _pid in _mp8_area_members[i]:
+			used.append((_mp8_spawns[i] as Array)[0])
+	var worst: float = INF
+	for a in used.size():
+		for b in range(a + 1, used.size()):
+			var pa: Vector3 = used[a]
+			var pb: Vector3 = used[b]
+			worst = minf(worst, Vector2(pa.x - pb.x, pa.z - pb.z).length())
+	if used.size() >= 2:
+		print("[MP8] Forklift Certified: %d spawns, min spacing %.2f m (forklift 3.0x6.0, source=8p version)" % [
+			used.size(), worst
+		])
+		if worst < 3.2:
+			push_warning("[MP8] Forklift Certified: spawns only %.2f m apart; two forklifts may overlap" % worst)
+
+
+func _mp8_name_of(network_id: int) -> String :
+	if PlayerManager.player_presences.has(network_id):
+		var p = PlayerManager.player_presences[network_id]
+		if p != null:
+			return String(p.network_name)
+	return "?"
+
+
+func _mp8_log_scores() -> void :
+
+	var rows := PackedStringArray()
+	for pid in player_scores.keys():
+		rows.append("%s(%d)=%d" % [_mp8_name_of(pid), pid, player_scores[pid]])
+	print("[MP8] Forklift Certified scores: %s" % "  ".join(rows))
+
+
+# ============================================================== [MP8] The added bays
+#
+# Adapted from machine-party-8p's forklift_certified.gd. Above four players, four more bays go at the
+# mid-edges of the yard, a 3x3 ring with a free centre: the floor box is the only static collider, so all
+# of it is drivable. One player per bay, so the team code above runs with teams of one.
+
+const MP8V_AREAS: int = 4
+const MP8V_CRATE_CAP: int = 10
+# DUPLICATE_GROUPS | DUPLICATE_SCRIPTS, no signals: a bay connects its own body signals in its _ready, and
+# the host's crate_number_changed hookup is made in _mp8v_expand_yard; copies would count every crate twice.
+const MP8V_DUPLICATE_FLAGS: int = 6
+# A 3x3 crate at any yaw reaches its half-diagonal, so crates keep this far inside every bay edge.
+const MP8V_CRATE_CLEARANCE: float = 2.122
+# @export node references survive duplicate() still pointing at the template's nodes; a clone re-points these.
+const MP8V_ZONE_NODE_EXPORTS: Array[String] = [
+	"border_mesh_instance",
+	"display_background_mesh_instance",
+	"counter_label",
+	"area_light",
+	"speaker_mechanism",
+]
+# The shipped plates sit below the drive plane in recessed bays; the mid-edge floor is flat, so they are lifted.
+const MP8V_ZONE_ART_CLEARANCE: float = 0.03
+const MP8V_ZONE_ART_MARGIN: float = 0.3
+# The grey grid plate is painted into the floor mesh, so an added bay samples it from the shipped atlas.
+const MP8V_PLATE_TEXTURE: String = "res://minigames/forklift_certified/models/forklift certified visuals1/forklift certified visuals1_fc area indicator8 marked8.png"
+const MP8V_PLATE_UV_OFFSET: Vector2 = Vector2(34.0 / 512.0, 6.0 / 512.0)
+const MP8V_PLATE_UV_SCALE: Vector2 = Vector2(276.0 / 512.0, 260.0 / 512.0)
+const MP8V_PLATE_INSET: float = 0.86
+const MP8V_BORDER_SHRINK: float = 0.9
+const MP8V_READOUT_GAP_FALLBACK: float = 2.16
+# The yard's (x, z) scale above four players: the room's art, walls, lights and bay positions grow about the
+# origin; bays, forklifts and crates keep their size. The owner's pick from in-game renders (D104);
+# `mp8forkyard=<sx>,<sz>` overrides it, and `mp8forkyard=1,1` is the shipped yard.
+const MP8V_YARD_SCALE: Vector2 = Vector2(1.3, 1.3)
+const MP8V_ROOM: String = "forklift certified visuals1"
+const MP8V_WALLS: String = "Placeholder/CSGBox3D main collider"
+const MP8V_CAMERA: String = "Placeholder/Camera3D"
+const MP8V_TIMER_SCREEN: String = "MeshInstance3D"
+
+
+func _mp8v_expand_yard() -> void :
+
+	if PlayerManager.player_presences.size() > MP8V_AREAS:
+		NetworkManager.mp8_rpc(self, &"zz_mp8v_add_delivery_areas_rpc", [_mp8v_yard_arg()])
+		# _ready builds delivery_areas and its crate_number_changed hookups before the clones exist.
+		if multiplayer.is_server():
+			for c in delivery_area_parent.get_children():
+				var area: ForkilftCertifiedDeliveryArea = c as ForkilftCertifiedDeliveryArea
+				if area == null or delivery_areas.has(area):
+					continue
+				delivery_areas.append(area)
+				if not area.crate_number_changed.is_connected(_on_crate_numbers_changed):
+					area.crate_number_changed.connect(_on_crate_numbers_changed)
+		_mp8v_add_spawn_markers()
+
+	# Bay i pairs with marker i: the shipped child orders match, and the added ones append in the same order.
+	_mp8_spawns = []
+	for m in player_spawn_positions_node.get_children():
+		_mp8_spawns.append([(m as Node3D).global_position, (m as Node3D).rotation_degrees.y])
+	print("[MP8] Forklift Certified 8p: %d bays, %d spawns" % [
+		delivery_area_parent.get_child_count(), _mp8_spawns.size()])
+
+
+# The shipped four, ordered far-west, far-east, near-west, near-east; empty unless there are exactly four.
+func _mp8v_sorted_grid(parent: Node) -> Array[Node3D] :
+	var ordered: Array[Node3D] = []
+	var out: Array[Node3D] = []
+	for c in parent.get_children():
+		if c is Node3D:
+			out.append(c as Node3D)
+	if out.size() != MP8V_AREAS:
+		return ordered
+
+	out.sort_custom(func(a: Node3D, b: Node3D) -> bool: return a.position.z < b.position.z)
+	var far_row: Array[Node3D] = [out[0], out[1]]
+	var near_row: Array[Node3D] = [out[2], out[3]]
+	far_row.sort_custom(func(a: Node3D, b: Node3D) -> bool: return a.position.x < b.position.x)
+	near_row.sort_custom(func(a: Node3D, b: Node3D) -> bool: return a.position.x < b.position.x)
+	ordered.append_array(far_row)
+	ordered.append_array(near_row)
+	return ordered
+
+
+# [position, template index] for the four mid-edge slots. The template is the shipped node whose row the
+# new one joins; the two mid-band slots have no row and take the far row's, facing along the wall.
+func _mp8v_mid_edge_slots(grid: Array[Node3D]) -> Array :
+	return [
+		[(grid[0].position + grid[1].position) * 0.5, 0],
+		[(grid[2].position + grid[3].position) * 0.5, 2],
+		[(grid[0].position + grid[2].position) * 0.5, 0],
+		[(grid[1].position + grid[3].position) * 0.5, 1],
+	]
+
+
+func _mp8v_zone_rect(area: Node3D) -> Rect2 :
+	for c in area.get_children():
+		if c is CollisionShape3D and (c as CollisionShape3D).shape is BoxShape3D:
+			var box: BoxShape3D = (c as CollisionShape3D).shape as BoxShape3D
+			var centre: Vector3 = (c as CollisionShape3D).global_position
+			return Rect2(centre.x - box.size.x * 0.5, centre.z - box.size.z * 0.5, box.size.x, box.size.z)
+	return Rect2()
+
+
+func _mp8v_add_zone_plate(copy: Node3D, floor_y: float) -> bool :
+	var border: Node3D = copy.get("border_mesh_instance") as Node3D
+	if border == null:
+		return false
+	var texture: Texture2D = load(MP8V_PLATE_TEXTURE) as Texture2D
+	if texture == null:
+		push_warning("[MP8] Forklift Certified 8p: no plate texture at %s" % MP8V_PLATE_TEXTURE)
+		return false
+
+	var mesh: PlaneMesh = PlaneMesh.new()
+	mesh.size = _mp8v_plane_size(border) * MP8V_PLATE_INSET
+	var mat: StandardMaterial3D = StandardMaterial3D.new()
+	mat.albedo_texture = texture
+	mat.uv1_offset = Vector3(MP8V_PLATE_UV_OFFSET.x, MP8V_PLATE_UV_OFFSET.y, 0.0)
+	mat.uv1_scale = Vector3(MP8V_PLATE_UV_SCALE.x, MP8V_PLATE_UV_SCALE.y, 1.0)
+	mat.texture_filter = BaseMaterial3D.TEXTURE_FILTER_NEAREST_WITH_MIPMAPS
+	mat.texture_repeat = false
+
+	var plate: MeshInstance3D = MeshInstance3D.new()
+	plate.name = "MP8VZonePlate"
+	plate.mesh = mesh
+	plate.material_override = mat
+	copy.add_child(plate)
+	plate.global_position = Vector3(border.global_position.x, floor_y + MP8V_ZONE_ART_CLEARANCE * 2.0, border.global_position.z)
+	return true
+
+
+func _mp8v_floor_y() -> float :
+	var markers: Array[Node3D] = _mp8v_sorted_grid(player_spawn_positions_node)
+	if markers.is_empty():
+		return 0.0
+	return markers[0].global_position.y
+
+
+# From mesh.size and the node's scale, not get_transformed_aabb(), which returns null in the release template.
+func _mp8v_plane_size(node: Node3D) -> Vector2 :
+	var mi: MeshInstance3D = node as MeshInstance3D
+	if mi == null or not (mi.mesh is PlaneMesh):
+		return Vector2.ZERO
+	var plane: PlaneMesh = mi.mesh as PlaneMesh
+	var scale: Vector3 = mi.global_transform.basis.get_scale()
+	return Vector2(plane.size.x * scale.x, plane.size.y * scale.z)
+
+
+func _mp8v_readout_gap(template: Node3D) -> float :
+	var plate: Node3D = template.get("border_mesh_instance") as Node3D
+	var readout: Node3D = template.get("display_background_mesh_instance") as Node3D
+	if plate == null or readout == null:
+		return MP8V_READOUT_GAP_FALLBACK
+	return readout.position.z - (plate.position.z + _mp8v_plane_size(plate).y * 0.5)
+
+
+# An added bay's plates, lifted onto the floor and clear of the shipped readouts. The mid-band bays put
+# their readout past the outer edge along X, turned a quarter: unturned, the 4.6-long housing hits the wall.
+func _mp8v_fit_added_zone(copy: Node3D, shipped: Array[Node3D], floor_y: float, is_side: bool) -> bool :
+	var border: Node3D = copy.get("border_mesh_instance") as Node3D
+	var display: Node3D = copy.get("display_background_mesh_instance") as Node3D
+
+	if border != null:
+		border.scale *= MP8V_BORDER_SHRINK
+
+	if is_side and border != null:
+		var border_far_edge: float = border.global_position.z - _mp8v_plane_size(border).y * 0.5
+		var blocked: float = -INF
+		for zone in shipped:
+			var panel: Node3D = zone.get("display_background_mesh_instance") as Node3D
+			if panel == null or panel.global_position.z >= copy.global_position.z:
+				continue
+			blocked = maxf(blocked, panel.global_position.z + _mp8v_plane_size(panel).y * 0.5)
+		if not is_inf(blocked):
+			var shift: float = blocked + MP8V_ZONE_ART_MARGIN - border_far_edge
+			if shift > 0.0:
+				copy.position.z += shift
+
+		if display != null and not shipped.is_empty():
+			var outward: float = signf(copy.global_position.x)
+			var gap: float = _mp8v_readout_gap(shipped[0])
+			display.position.x = border.position.x + outward * (_mp8v_plane_size(border).x * 0.5 + gap)
+			display.position.z = border.position.z
+			display.rotation_degrees.y += -90.0 * outward
+
+	if border != null:
+		border.global_position.y = floor_y + MP8V_ZONE_ART_CLEARANCE
+	if display != null:
+		display.global_position.y = floor_y + MP8V_ZONE_ART_CLEARANCE
+	return _mp8v_add_zone_plate(copy, floor_y)
+
+
+func _mp8v_rebind_zone_exports(template: Node3D, copy: Node3D) -> int :
+	var rebound: int = 0
+	for prop in MP8V_ZONE_NODE_EXPORTS:
+		var ref: Node = template.get(prop) as Node
+		if ref == null:
+			push_warning("[MP8] Forklift Certified 8p: %s has no %s to rebind" % [template.name, prop])
+			continue
+		var mine: Node = copy.get_node_or_null(template.get_path_to(ref))
+		if mine == null:
+			push_warning("[MP8] Forklift Certified 8p: %s has no node for %s" % [copy.name, prop])
+			continue
+		copy.set(prop, mine)
+		rebound += 1
+	return rebound
+
+
+# Built on every peer: the game drives bays by node path (set_owner_rpc, update_counter_rpc), so a bay only
+# on the host is an RPC into nothing.
+func zz_mp8v_add_delivery_areas_rpc(yard: Vector2) -> void :
+
+	if delivery_area_parent.get_child_count() > MP8V_AREAS:
+		return
+	var grid: Array[Node3D] = _mp8v_sorted_grid(delivery_area_parent)
+	if grid.is_empty():
+		push_warning("[MP8] Forklift Certified 8p: expected 4 shipped bays, found %d; not expanding" % delivery_area_parent.get_child_count())
+		return
+
+	# Before the clones: their slots are the midpoints of the moved shipped bays.
+	_mp8v_scale_yard(grid, yard)
+
+	var floor_y: float = _mp8v_floor_y()
+	var slots: Array = _mp8v_mid_edge_slots(grid)
+	for i in slots.size():
+		var template: Node3D = grid[slots[i][1]]
+		var copy: Node3D = template.duplicate(MP8V_DUPLICATE_FLAGS) as Node3D
+		copy.name = "DropArea_MP8V%d" % (MP8V_AREAS + 1 + i)
+		copy.position = slots[i][0]
+		# Before add_child: the bay's _ready caches a material off border_mesh_instance.
+		_mp8v_rebind_zone_exports(template, copy)
+		delivery_area_parent.add_child(copy)
+		_mp8v_fit_added_zone(copy, grid, floor_y, i >= 2)
+
+	# A shipped bay's border and readout sit in grooves of the floor mesh, which a scaled room moves out
+	# from under them; they get the clones' treatment (lifted, the grid plate, the 0.9 border). After the
+	# clones, which copy them.
+	if not _mp8v_yard.is_equal_approx(Vector2.ONE):
+		for area in grid:
+			_mp8v_fit_added_zone(area, grid, floor_y, false)
+
+
+# Host only: clients never read a marker, only the position setup_rpc carries.
+func _mp8v_add_spawn_markers() -> void :
+
+	if not multiplayer.is_server() or player_spawn_positions_node.get_child_count() > MP8V_AREAS:
+		return
+	var grid: Array[Node3D] = _mp8v_sorted_grid(player_spawn_positions_node)
+	if grid.is_empty():
+		push_warning("[MP8] Forklift Certified 8p: expected 4 shipped spawns, found %d; not expanding" % player_spawn_positions_node.get_child_count())
+		return
+	# The shipped markers sit on the shipped bays' origins, so they move with them.
+	for m in grid:
+		m.position *= Vector3(_mp8v_yard.x, 1.0, _mp8v_yard.y)
+	var slots: Array = _mp8v_mid_edge_slots(grid)
+	for i in slots.size():
+		var marker: Marker3D = Marker3D.new()
+		marker.name = "Marker3D_MP8V%d" % (MP8V_AREAS + 1 + i)
+		player_spawn_positions_node.add_child(marker)
+		marker.position = slots[i][0]
+		marker.rotation = grid[slots[i][1]].rotation
+
+
+# The crates go in the free centre cell of the ring, inside the inner edges of the bays either side of it.
+func _mp8v_set_crate_region() -> void :
+
+	var zones: Array[Node] = delivery_area_parent.get_children()
+	if zones.size() <= MP8V_AREAS:
+		return
+
+	var mean: Vector2 = Vector2.ZERO
+	var rects: Array[Rect2] = []
+	for z in zones:
+		var r: Rect2 = _mp8v_zone_rect(z as Node3D)
+		if not r.has_area():
+			push_warning("[MP8] Forklift Certified 8p: bay %s has no box collider; the shipped crate box stays" % z.name)
+			return
+		rects.append(r)
+		mean += r.get_center()
+	mean /= rects.size()
+
+	var gap: float = rects[0].size.x * 0.25
+	var x0: float = -INF
+	var x1: float = INF
+	var z0: float = -INF
+	var z1: float = INF
+	for r in rects:
+		var c: Vector2 = r.get_center()
+		if c.x < mean.x - gap:
+			x0 = maxf(x0, r.end.x)
+		elif c.x > mean.x + gap:
+			x1 = minf(x1, r.position.x)
+		if c.y < mean.y - gap:
+			z0 = maxf(z0, r.end.y)
+		elif c.y > mean.y + gap:
+			z1 = minf(z1, r.position.y)
+	if is_inf(x0) or is_inf(x1) or is_inf(z0) or is_inf(z1):
+		push_warning("[MP8] Forklift Certified 8p: no free centre cell; the shipped crate box stays")
+		return
+
+	var region: Rect2 = Rect2(x0, z0, x1 - x0, z1 - z0).grow(-MP8V_CRATE_CLEARANCE)
+	if region.size.x <= 0.0 or region.size.y <= 0.0:
+		push_warning("[MP8] Forklift Certified 8p: the centre cell is smaller than a crate; the shipped crate box stays")
+		return
+	crate_manager.mp8_spawn_region = region
+	print("[MP8] Forklift Certified 8p: crates in the centre cell, %.1f x %.1f m" % [region.size.x, region.size.y])
+
+
+# The host's yard scale: the pick, or `mp8forkyard=<sx>,<sz>` when it parses to two factors of at least 1.
+func _mp8v_yard_arg() -> Vector2 :
+
+	for a in NetworkManager.mp8_dev_args():
+		var s: String = String(a)
+		if not s.begins_with("mp8forkyard="):
+			continue
+		var parts: PackedStringArray = s.substr("mp8forkyard=".length()).split(",")
+		if parts.size() == 2 and parts[0].is_valid_float() and parts[1].is_valid_float() \
+				and float(parts[0]) >= 1.0 and float(parts[1]) >= 1.0:
+			return Vector2(float(parts[0]), float(parts[1]))
+		push_warning("[MP8] Forklift Certified 8p: %s not recognised (sx,sz, each at least 1)" % s)
+	return MP8V_YARD_SCALE
+
+
+# Every peer scales the same yard from the host's factors. The room's art scales as one node; the
+# magnet's moving axes hang under a plain Node, so they stay in world space, and magnet_manager's clamp
+# (z -22.9..23.9, x >= -27.9) still lifts a crate past it from the clamped spot, as by the stock back wall.
+func _mp8v_scale_yard(grid: Array[Node3D], yard: Vector2) -> void :
+
+	_mp8v_yard = yard
+	if yard.is_equal_approx(Vector2.ONE):
+		print("[MP8] Forklift Certified 8p: the shipped yard")
+		return
+
+	var room: Node3D = get_node_or_null(MP8V_ROOM) as Node3D
+	var walls: CSGBox3D = get_node_or_null(MP8V_WALLS) as CSGBox3D
+	var cam: Camera3D = get_node_or_null(MP8V_CAMERA) as Camera3D
+	if room == null or walls == null or cam == null:
+		push_warning("[MP8] Forklift Certified 8p: no room, walls or camera; the shipped yard stays")
+		_mp8v_yard = Vector2.ONE
+		return
+
+	var s: Vector3 = Vector3(yard.x, 1.0, yard.y)
+	var stock_groups: Array = _mp8v_frame_groups(walls, grid)
+	walls.size *= s
+	walls.position *= s
+	room.global_transform = Transform3D(Basis.from_scale(s), Vector3.ZERO) * room.global_transform
+
