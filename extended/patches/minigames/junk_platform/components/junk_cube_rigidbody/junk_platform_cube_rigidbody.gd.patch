 @rpc("any_peer", "call_local", "reliable")
 func set_held_rpc(held: bool, _held_by: NodePath):
+
+	# [MP8] A mixed room runs the game's set_held_rpc (D120).
+	if not NetworkManager.mp8_room_extended():
+		_mp8_game_set_held_rpc(held, _held_by)
+		return
+
+	# [MP8] On a hand-over, drop the previous holder's collision exception first: `throw_rpc`
+	# removes only the current holder's, so a loser of a same-frame grab would pass through this cube forever.
+	# Not first-come-wins: peers broadcast this RPC and may receive it in different orders, so the
+	# last one takes over. The player's grab loop already skips cubes someone else holds.
+	var claimer: Node = get_node_or_null(_held_by)
+	if claimer == null:
+		push_warning("[MP8] Debris Platforms: set_held_rpc got a path that does not resolve: %s, ignored" % String(_held_by))
+		return
+
+	if held_by_player != null and is_instance_valid(held_by_player) and held_by_player != claimer:
+		remove_collision_exception_with(held_by_player)
+		if multiplayer.is_server():
+			print("[MP8] Debris Platforms: cube changed hands %s -> %s (same-frame grab, old collision exception removed)" % [
+				String(held_by_player.name), String(claimer.name)
+			])
+
+	visible = false
+	held_by_player = claimer
+	add_collision_exception_with(held_by_player)
+	held_by = held_by_player.grab_position
+	freeze = held
+
+# The game's set_held_rpc, for a mixed room (D120).
+func _mp8_game_set_held_rpc(held: bool, _held_by: NodePath):
 	visible = false
 	held_by_player = get_node(_held_by)
 	add_collision_exception_with(held_by_player)
