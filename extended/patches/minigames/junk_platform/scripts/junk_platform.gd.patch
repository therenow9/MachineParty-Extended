+
+
+# [MP8] The server sends each platform's owner; the labels already exist on every peer.
+func mp8_set_platform_labels_rpc(names: Array) -> void :
+
+	for i in _mp8_platform_labels.size():
+		if i < names.size():
+			_mp8_platform_labels[i].text = String(names[i])
+		else:
+			_mp8_platform_labels[i].text = ""
+
+	# [MP8] PlayerManager is filled by now, so the id HUD can show the name.
+	_mp8_show_id_hud()
+
+
+# [MP8] Turns a group by yaw about its own centre, then moves it to target; the parts keep their
+# relative offsets.
+func _mp8_move_group(g: Dictionary, target: Vector3, yaw: float) -> void :
+
+	var center: Vector3 = g["pos"]
+	var basis_rot := Basis(Vector3.UP, yaw)
+
+	var nodes: Array = [g["platform"]]
+	nodes.append_array(g["nodes"])
+
+	for node in nodes:
+		var offset: Vector3 = node.global_position - center
+		offset = basis_rot * offset
+		node.global_position = target + offset
+		node.global_transform.basis = basis_rot * node.global_transform.basis
+
+
+# [MP8] Logs the smallest edge gap between platforms: too small and players walk across.
+func _mp8_report_gaps(slots: Array[Vector3]) -> void :
+
+	var radius: float = 6.0
+	if junk_handler != null and "platform_radius" in junk_handler:
+		radius = junk_handler.platform_radius
+
+	var min_gap: float = 1e20
+	for i in slots.size():
+		for j in range(i + 1, slots.size()):
+			var d: float = Vector2(
+				slots[i].x - slots[j].x, slots[i].z - slots[j].z
+			).length()
+			min_gap = minf(min_gap, d - radius * 2.0)
+
+	print("[MP8] smallest platform edge gap %.2f (stock corners: %.2f; too small and players walk across)" % [
+		min_gap, 26.0 - radius * 2.0
+	])
+
+
+# [MP8] Assigns a node to the nearest platform by horizontal distance (compactors hang high above).
+func _mp8_assign_to_nearest(groups: Array, node: Node3D) -> void :
+
+	var best: int = -1
+	var best_dist: float = 1e20
+	var np: Vector3 = node.global_position
+	for i in groups.size():
+		var gp: Vector3 = groups[i]["pos"]
+		var d: float = Vector2(np.x - gp.x, np.z - gp.z).length()
+		if d < best_dist:
+			best_dist = d
+			best = i
+	# Farther than a platform diameter: shared scenery.
+	if best >= 0 and best_dist < 12.0:
+		groups[best]["nodes"].append(node)
+
+
+# [MP8] World positions of the 8 slots, in `platforms` order: the stock 4 first, then the new 4 at
+# 0/90/180/270 degrees.
+func _mp8_slot_positions(original_positions: Array) -> Array[Vector3]:
+
+	var out: Array[Vector3] = []
+
+	for p in original_positions:
+		out.append(Vector3(p.x, 0.0, p.z))
+
+	if _mp8_couch != Vector3.ZERO:
+		for i in out.size():
+			out[i] = _mp8_couch_slot(atan2(out[i].x, out[i].z))
+		for k in 4:
+			out.append(_mp8_couch_slot(deg_to_rad(90.0 * float(k))))
+		return out
+
+	var r: float = _mp8_radius()
+
+	# [MP8] Mode c: the stock 4 keep their bearing at the new radius, making a regular octagon; only
+	# then is 45 degrees a symmetry, giving each player a facing of their own.
+	if _mp8_view_mode == "c":
+		for i in out.size():
+			var a: float = atan2(out[i].x, out[i].z)
+			out[i] = Vector3(sin(a) * r, 0.0, cos(a) * r)
+
+	for k in 4:
+		var angle: float = deg_to_rad(90.0 * float(k))
+		out.append(Vector3(sin(angle) * r, 0.0, cos(angle) * r))
+	return out
+
+
+# [MP8] Value of a `<prefix>=<value>` command-line argument, or "" when absent.
+func _mp8_arg(prefix: String) -> String:
+	for a in NetworkManager.mp8_dev_args():
+		var s: String = String(a)
+		if s.begins_with(prefix):
+			return s.substr(prefix.length())
+	return ""
+
+
+# [MP8] `mp8junkr=<radius>` overrides MP8_NEW_RADIUS.
+func _mp8_radius() -> float:
+	var v: String = _mp8_arg("mp8junkr=")
+	if v.is_valid_float():
+		return float(v)
+	return MP8_NEW_RADIUS
+
+
+# [MP8] Couch layout at 5-8 seats. One shared camera draws the back decks at about half the front's
+# size, so the ring flattens (rx, rz) and may tilt about X, back decks up; only up, since the fall
+# plane is at y -2. Online keeps mode c: its turned views need the regular octagon.
+var _mp8_couch: Vector3 = Vector3.ZERO   # (rx, rz, tilt in degrees); zero = off
+
+# The owner's pick from in-game renders (D102): wider and shallower, all decks at one height.
+# `mp8junkcouch=<rx>,<rz>,<tilt>` overrides it, and `mp8junkcouch=0,0,0` turns it off.
+const MP8_COUCH_LAYOUT: Vector3 = Vector3(34.0, 18.0, 0.0)
+
+# World units kept clear beyond each deck's radius when the couch camera is fitted.
+const MP8_COUCH_FRAME_MARGIN: float = 2.0
+
+
+# [MP8] Runs before `_mp8_expand_platforms()`: presences are filled by the lobby, before the load.
+func _mp8_init_couch() -> void :
+
+	_mp8_couch = Vector3.ZERO
+	if not GameManager.local_game:
+		return
+	var seats: int = PlayerManager.player_presences.size()
+	if seats > 4:
+		_mp8_couch = MP8_COUCH_LAYOUT
+	var v: String = _mp8_arg("mp8junkcouch=")
+	var parts: PackedStringArray = v.split(",")
+	if seats > 4 and parts.size() == 3 \
+			and parts[0].is_valid_float() and parts[1].is_valid_float() and parts[2].is_valid_float():
+		_mp8_couch = Vector3(float(parts[0]), float(parts[1]), float(parts[2]))
+	elif v != "" and seats > 4:
+		push_warning("[MP8] Debris Platforms: mp8junkcouch=%s not recognised (rx,rz,tilt)" % v)
+
+	if _mp8_couch == Vector3.ZERO:
+		print("[MP8] Debris Platforms: couch layout off (%d seats)" % seats)
+	else:
+		print("[MP8] Debris Platforms: couch layout rx %.1f rz %.1f tilt %.0f° (%d seats)" % [
+			_mp8_couch.x, _mp8_couch.y, _mp8_couch.z, seats
+		])
+
+
+# [MP8] The couch slot at bearing b: the ellipse turned about X by the tilt, then raised so the front
+# deck (+Z, nearest the camera) sits at y 0.
+func _mp8_couch_slot(b: float) -> Vector3:
+	var t: float = deg_to_rad(_mp8_couch.z)
+	var z0: float = cos(b) * _mp8_couch.y
+	return Vector3(sin(b) * _mp8_couch.x, (_mp8_couch.y - z0) * sin(t), z0 * cos(t))
+
+
+# [MP8] Couch camera: the stock orientation (the sway animates rotation, so only the position is
+# ours), slid along the view axis through the decks' centre until every deck is whole in frame.
+func _mp8_fit_couch_camera(slots: Array[Vector3]) -> void :
+
+	if camera == null or slots.is_empty() or _mp8_cam_fov0 <= 0.0:
+		return
+
+	var radius: float = 6.0
+	if junk_handler != null and "platform_radius" in junk_handler:
+		radius = junk_handler.platform_radius
+
+	camera.fov = _mp8_cam_fov0 + MP8_CAM_FOV_ADD
+	var half_v: float = deg_to_rad(camera.fov) * 0.5
+	var half_h: float = atan(tan(half_v) * _mp8_aspect())
+
+	var centre: Vector3 = Vector3.ZERO
+	for s in slots:
+		centre += s
+	centre /= float(slots.size())
+
+	var xf: Transform3D = camera.global_transform
+	var fwd: Vector3 = - xf.basis.z.normalized()
+	var d: float = 10.0
+	while d < 200.0:
+		xf.origin = centre - fwd * d
+		var worst: float = INF
+		for s in slots:
+			var m: Vector3 = _mp8_frame_margin(xf, half_v, half_h, s)
+			worst = minf(worst, minf(m.y, m.z))
+		if worst >= radius + MP8_COUCH_FRAME_MARGIN:
+			break
+		d += 0.25
+	camera.global_transform = xf
+
+	# On-screen size: a deck's radius as a fraction of half the screen height.
+	var sizes: PackedStringArray = []
+	var smallest: float = INF
+	var largest: float = 0.0
+	for i in slots.size():
+		var depth: float = _mp8_frame_margin(xf, half_v, half_h, slots[i]).x
+		var size: float = radius / (depth * tan(half_v))
+		smallest = minf(smallest, size)
+		largest = maxf(largest, size)
+		sizes.append("%d(%.0f,%.1f,%.0f)=%.3f" % [i + 1, slots[i].x, slots[i].y, slots[i].z, size])
+	print("[MP8] couch camera: distance %.1f, position (%.1f, %.1f, %.1f), fov %.1f; deck sizes %s; smallest/largest %.2f" % [
+		d, xf.origin.x, xf.origin.y, xf.origin.z, camera.fov, " ".join(sizes), smallest / largest
+	])
+
+
+# [MP8] A compactor slams by tweening its own position to y 1.355 under `junk platform compactors`, at
+# the origin, so over a raised deck it would plunge through. Each hangs from a node at its deck's
+# height instead, and rests no lower than the camera: below it, compactors block the view of the back.
+func _mp8_couch_lift_compactors(groups: Array, slots: Array[Vector3]) -> void :
+
+	var lowest_rest: float = 0.0
+	if camera != null:
+		lowest_rest = camera.global_position.y + 1.0
+
+	var lifted: int = 0
+	for i in groups.size():
+		if i >= slots.size():
+			break
+		var comp = _mp8_pick(groups[i], "compactor")
+		if comp == null:
+			continue
+		var holder := Node3D.new()
+		holder.name = "MP8CompactorLift%d" % (i + 1)
+		comp.get_parent().add_child(holder)
+		holder.global_position = Vector3(0.0, slots[i].y, 0.0)
+		comp.reparent(holder, true)
+		comp.global_position.y = maxf(comp.global_position.y, lowest_rest)
+		lifted += 1
+
+	print("[MP8] Debris Platforms: %d compactors hang from their decks, resting at y %.1f or higher" % [
+		lifted, lowest_rest
+	])
+
+
+# [MP8] The scene's one light sits 11 above the deck plane, over the centre, so a deck raised above it
+# is lit from below. It moves as far above the highest deck, over the decks' centre, with its energy
+# scaled by distance squared so the farthest deck gets about the stock farthest deck's light.
+func _mp8_couch_light(slots: Array[Vector3]) -> void :
+
+	var light := get_node_or_null("visuals base/Lighting/OmniLight3D") as OmniLight3D
+	if light == null or slots.is_empty():
+		print("[MP8] Debris Platforms: couch light not found")
+		return
+
+	var above: float = light.global_position.y
+	var stock_far: float = Vector2(MP8_NEW_RADIUS, above).length()
+
+	var centre: Vector3 = Vector3.ZERO
+	var top: float = 0.0
+	for s in slots:
+		centre += s
+		top = maxf(top, s.y)
+	centre /= float(slots.size())
+	var pos: Vector3 = Vector3(centre.x, top + above, centre.z)
+
+	var far: float = 0.0
+	for s in slots:
+		far = maxf(far, pos.distance_to(s))
+
+	light.global_position = pos
+	light.light_energy *= pow(far / stock_far, 2.0)
+	light.omni_range = maxf(light.omni_range, far * 2.0)
+	print("[MP8] Debris Platforms: couch light at (%.1f, %.1f, %.1f), energy %.1f, farthest deck %.1f (stock %.1f)" % [
+		pos.x, pos.y, pos.z, light.light_energy, far, stock_far
+	])
+
+
+# [MP8] The slot opposite slot i: nearest to (-x, -z). A view turned 180 degrees draws visuals from V
+# over (-V.x, -V.z), so the pairing is pure geometry, unrelated to array index.
+func _mp8_opposite_index(slots: Array[Vector3], i: int) -> int:
+
+	var target := Vector2( - slots[i].x, - slots[i].z)
+	var best: int = i
+	var best_d: float = 1e20
+	for j in slots.size():
+		var d: float = Vector2(slots[j].x, slots[j].z).distance_to(target)
+		if d < best_d:
+			best_d = d
+			best = j
+	return best
+
+
+# [MP8] Checks the flip pairing is an involution with no shared partner; otherwise a ring lights with
+# someone else's junk, which is hard to see by eye.
+func _mp8_check_pairing(slots: Array[Vector3]) -> void :
+
+	var partners: Array[int] = []
+	for i in slots.size():
+		partners.append(_mp8_opposite_index(slots, i))
+
+	var bad: bool = false
+	var seen: Dictionary = {}
+	for i in partners.size():
+		if partners[partners[i]] != i:
+			bad = true
+		if seen.has(partners[i]):
+			bad = true
+		seen[partners[i]] = true
+
+	var txt: PackedStringArray = []
+	for i in partners.size():
+		txt.append("%d(%.0f,%.0f)->%d" % [
+			i + 1, slots[i].x, slots[i].z, partners[i] + 1
+		])
+	print("[MP8] flip pairing %s: %s" % [
+		"❌ broken (slots not 180° symmetric)" if bad else "✓ involution holds",
+		" ".join(txt)
+	])
+
+
+# [MP8] Points a platform at its own group and its flipped partner. Rings and visuals sit under
+# `visuals base` and turn with the view, so they come from `own`; compactors and alarms do not turn,
+# so they always come from the platform's own group (`fixed`, else `own`). A compactor picked by
+# facing would slam on a different player on each peer.
+func _mp8_wire_platform(own: Dictionary, partner: Dictionary, fixed = null) -> void :
+
+	var p: JunkPlatformPlatform = own["platform"]
+
+	# Turn with the view: from `own`, the group above this platform now.
+	var own_indicator: Node3D = _mp8_pick(own, "damage indicator")
+	var own_visual: Node3D = _mp8_pick(own, "platform main")
+
+	# Do not turn: always the platform's own group.
+	var src_fixed: Dictionary = own if fixed == null else fixed
+	var own_compactor = _mp8_pick(src_fixed, "compactor")
+	var own_alarm = _mp8_pick(src_fixed, "speaker_indicator alarm")
+
+	var far_indicator: Node3D = _mp8_pick(partner, "damage indicator")
+	var far_visual: Node3D = _mp8_pick(partner, "platform main")
+	var far_compactor = _mp8_pick(partner, "compactor")
+	var far_alarm = _mp8_pick(partner, "speaker_indicator alarm")
+
+	if own_indicator != null:
+		p.damage_circle_parent = own_indicator
+	if far_indicator != null:
+		p.damage_circle_parent_flipped = far_indicator
+
+	var vis: Array[Node3D] = []
+	if own_indicator != null:
+		vis.append(own_indicator)
+	if own_visual != null:
+		vis.append(own_visual)
+	p.platform_visuals = vis
+
+	var vis_f: Array[Node3D] = []
+	if far_indicator != null:
+		vis_f.append(far_indicator)
+	if far_visual != null:
+		vis_f.append(far_visual)
+	p.platform_visuals_flipped = vis_f
+
+	if own_compactor != null:
+		p.compactor = own_compactor
+	if far_compactor != null:
+		p.compactor_flipped = far_compactor
+	if own_alarm != null:
+		p.speaker_alarm = own_alarm
+	if far_alarm != null:
+		p.speaker_alarm_flipped = far_alarm
+
+	p.assign_indicators()
+
+
+# Picks a group node by name, with `contains`: copies are prefixed `MP8_<n>_`.
+func _mp8_pick(group: Dictionary, keyword: String):
+	for node in group["nodes"]:
+		if String(node.name).contains(keyword):
+			return node
+	return null
+
+
+# [MP8] One spawn point per platform, in platform order: junk drop points derive from spawn points,
+# so a spawn point left behind drops junk into the void.
+func _mp8_rebuild_spawn_points(slots: Array[Vector3]) -> void :
+
+	var container: Node3D = player_spawn_position_node
+	if container == null:
+		return
+
+	var kids: Array = container.get_children()
+	if kids.is_empty():
+		return
+
+	var template: Node3D = kids[0]
+	while container.get_child_count() < slots.size():
+		var dup: Node3D = template.duplicate()
+		dup.name = "MP8Spawn%d" % container.get_child_count()
+		container.add_child(dup)
+
+	var all: Array = container.get_children()
+	for i in slots.size():
+		if i >= all.size():
+			break
+		var m: Node3D = all[i]
+		# Platform centre, at the template's height so the player does not start inside the collider.
+		m.global_position = slots[i] + Vector3(0.0, template.global_position.y, 0.0)
+
+
+# [MP8] View modes. A facing turns `camera_base` (the one camera node nothing else writes each frame)
+# and `visuals_base` while the colliders stay put, so each platform is re-pointed at the visuals above
+# it; stock has only two states (`platform_visuals` / `_flipped`). The step must map the ring onto
+# itself: b keeps the mixed rings (90), c puts all 8 on one octagon (45).
+const MP8_VIEW_STEPS: Dictionary = {"a": 180.0, "b": 90.0, "c": 45.0}
+const MP8_VIEW_DEFAULT: String = "c"
+# The mode on the stock two-state switch; the others re-point by geometry in `_mp8_apply_view()`.
+const MP8_VIEW_VANILLA: String = "a"
+
+var _mp8_view_mode: String = MP8_VIEW_DEFAULT
+var _mp8_my_facing: float = 0.0
+# Each group after the move: {"platform":, "nodes":, "pos": final world position}
+var _mp8_groups_final: Array = []
+
+# [MP8] Sweep: a round ends only by elimination, with no timeout, so a player killed (`active` false)
+# but never removed from `active_players` hangs it. The server removes them after a grace longer than
+# `fall_rpc`'s 1.5 s tween, which clears `active` before `emit_died`, and only while
+# `junk_handler.active`: before play starts every player is inactive.
+const MP8_SWEEP_TICK: float = 1.0
+const MP8_SWEEP_GRACE: float = 3.0
+var _mp8_dead_since: Dictionary[int, float] = {}
+var _mp8_sweep_timer: Timer = null
+
+
+func _mp8_facing_step() -> float:
+	return float(MP8_VIEW_STEPS.get(_mp8_view_mode, 180.0))
+
+
+# [MP8] A player's facing: the platform's bearing `atan2(x, z)` rounded to the mode's step (the camera
+# rests on +Z looking at -Z). With step 180 this equals the stock `position.z < 0` rule.
+func _mp8_facing_for(pos: Vector3) -> float:
+	var step: float = _mp8_facing_step()
+	var bearing: float = rad_to_deg(atan2(pos.x, pos.z))
+	return fposmod(round(bearing / step) * step, 360.0)
+
+
+# [MP8] Re-points every platform at the visuals above it: with `visuals_base` turned by deg, the group
+# at g draws at R(deg)*g, so platform p takes the group nearest R(-deg)*p. The stock
+# `platform_visuals_flipped` switch must not be applied on top.
+func _mp8_rebind_for_facing(deg: float) -> void :
+
+	if _mp8_groups_final.is_empty():
+		return
+
+	var inv := Basis(Vector3.UP, deg_to_rad( - deg))
+	var hit: int = 0
+	# [MP8] Each platform picks its nearest group on its own; two picking one group means one compactor
+	# serves two platforms. Reported, not corrected: the slots are not symmetric.
+	var taken: Dictionary = {}
+
+	for g in _mp8_groups_final:
+		var pl = g["platform"]
+		if pl == null or not is_instance_valid(pl):
+			continue
+
+		var p: Vector3 = Vector3(pl.global_position.x, 0.0, pl.global_position.z)
+		var want: Vector3 = inv * p
+		var want_far: Vector3 = - want
+
+		var best: Dictionary = {}
+		var far: Dictionary = {}
+		var bd: float = INF
+		var fd: float = INF
+		for h in _mp8_groups_final:
+			var hp: Vector3 = h["pos"]
+			var d: float = Vector2(hp.x - want.x, hp.z - want.z).length()
+			if d < bd:
+				bd = d
+				best = h
+			var d2: float = Vector2(hp.x - want_far.x, hp.z - want_far.z).length()
+			if d2 < fd:
+				fd = d2
+				far = h
+
+		if best.is_empty():
+			continue
+
+		var key: String = str(best.get("pos", Vector3.ZERO))
+		if taken.has(key):
+			print("[MP8] Debris Platforms: ⚠️ facing %.0f° rebind collision - platforms %s and %s both took group %s (one compactor shared)" % [
+				deg, String(pl.name), String(taken[key]), key
+			])
+		taken[key] = String(pl.name)
+
+		# A temporary group for `_mp8_wire_platform`; `g`, the platform's own group, supplies the compactor
+		# and alarm.
+		_mp8_wire_platform(
+			{"platform": pl, "nodes": best["nodes"]},
+			(far if not far.is_empty() else best),
+			g
+		)
+		hit += 1
+
+	print("[MP8] Debris Platforms: facing %.0f° -> re-pointed %d/%d platforms' visuals" % [
+		deg, hit, _mp8_groups_final.size()
+	])
+
+
+# [MP8] Applies a facing in modes b and c, locally: each peer turns its own view.
+func _mp8_apply_view(deg: float) -> void :
+
+	_mp8_my_facing = deg
+	if camera_base != null:
+		camera_base.rotation_degrees.y = deg
+	if visuals_base != null:
+		visuals_base.rotation_degrees.y = deg
+	_mp8_rebind_for_facing(deg)
+	_mp8_show_id_hud()
+
+
+# [MP8] Camera: each peer has its own, so position and fov can differ per player. Offsets go into the
+# camera's transform in `camera_base`'s local space, never onto `camera_base`: it turns about the world
+# origin, so a world offset would push rotated players' cameras forward. Default: one offset for
+# everyone; `mp8junkcamper` offsets only players whose platform touches the frame edge.
+const MP8_CAM_BACK: float = 6.0      # level pull-back; raised, the camera would pass the compactor tops (y~26.8)
+const MP8_CAM_DOWN: float = 2.0
+const MP8_CAM_FOV_ADD: float = 10.0  # fov added (stock 50.3 -> 60.3)
+
+var _mp8_cam_xf0: Transform3D        # stock camera transform, taken before camera_base turns
+var _mp8_cam_fov0: float = 0.0
+
+
