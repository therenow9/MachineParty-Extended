+# [MP8] Expands the 4 stock platforms to `NetworkManager.MAX_PLAYERS`.
+func _mp8_expand_platforms() -> void :
+
+	if _mp8_expanded:
+		return
+	var target: int = NetworkManager.MAX_PLAYERS
+	var n: int = platforms.size()
+	if n == 0 or n >= target:
+		return
+	_mp8_expanded = true
+
+	# 1. Group each platform's nodes by position, not by number: `platform main parent1` is not under
+	# Platform1, and diagonal platforms reference the same visuals.
+	var groups: Array = []
+	for p in platforms:
+		groups.append({"platform": p, "nodes": [], "pos": p.global_position})
+
+	for parent_path in [
+		"visuals base/junk platform visuals2",
+		"visuals base/damage indicators",
+		"junk platform compactors",
+	]:
+		var parent: Node = get_node_or_null(parent_path)
+		if parent == null:
+			continue
+		for child in parent.get_children():
+			if child is Node3D:
+				_mp8_assign_to_nearest(groups, child)
+
+	# The alarm speakers are loose children of the root.
+	for child in get_children():
+		if child is Node3D and String(child.name).begins_with("speaker_indicator alarm"):
+			_mp8_assign_to_nearest(groups, child)
+
+	# 2. Copy whole groups and move each as one, so the parts keep their relative offsets.
+	var all_groups: Array = groups.duplicate()
+	for i in range(n, target):
+		var src: Dictionary = groups[i % n]
+		var clone: Dictionary = {"nodes": [], "pos": src["pos"]}
+
+		var dup_platform: JunkPlatformPlatform = src["platform"].duplicate()
+		dup_platform.name = "MP8Platform%d" % (i + 1)
+		src["platform"].get_parent().add_child(dup_platform)
+		dup_platform.global_position = src["platform"].global_position
+		clone["platform"] = dup_platform
+		platforms.append(dup_platform)
+
+		for node in src["nodes"]:
+			var dup_node: Node3D = node.duplicate()
+			dup_node.name = "MP8_%d_%s" % [i + 1, node.name]
+			node.get_parent().add_child(dup_node)
+			dup_node.transform = node.transform
+			clone["nodes"].append(dup_node)
+
+		all_groups.append(clone)
+
+	# 3. Move to the slots. In modes a and b the stock 4 stay put (delta 0).
+	var original_positions: Array = []
+	for g in groups:
+		original_positions.append(g["pos"])
+	var slots: Array[Vector3] = _mp8_slot_positions(original_positions)
+
+	for i in all_groups.size():
+		if i >= slots.size():
+			break
+		var g: Dictionary = all_groups[i]
+		var delta: Vector3 = slots[i] - g["pos"]
+		# A couch slot may be raised, so its height counts.
+		if _mp8_couch == Vector3.ZERO:
+			delta.y = 0.0
+		if delta.length() < 0.01:
+			continue  # a stock platform left in place
+
+		# Only the new 4 turn 45 degrees; the stock 4 keep their bearing (mode c changes only their radius).
+		var yaw: float = deg_to_rad(MP8_NEW_YAW_DEGREES) if i >= n else 0.0
+		_mp8_move_group(g, slots[i], yaw)
+
+	# [MP8] Final positions, for `_mp8_rebind_for_facing`; `g["pos"]` is the position before the move.
+	_mp8_groups_final.clear()
+	for i in all_groups.size():
+		var gg: Dictionary = all_groups[i]
+		_mp8_groups_final.append({
+			"platform": gg["platform"],
+			"nodes": gg["nodes"],
+			"pos": (slots[i] if i < slots.size() else gg["pos"]),
+		})
+
+	_mp8_report_gaps(slots)
+	_mp8_check_pairing(slots)
+
+	# 4. Wire each platform to its own group and its opposite: `duplicate()` keeps @export references
+	# pointing at the originals.
+	for i in all_groups.size():
+		# The partner comes from positions: in slot order, `(i + size/2) % size` is not the 180-degree opposite.
+		var partner: int = _mp8_opposite_index(slots, i)
+		_mp8_wire_platform(all_groups[i], all_groups[partner])
+
+		# A ring lighting with someone else's junk is only diagnosable from this line.
+		var pl: JunkPlatformPlatform = all_groups[i]["platform"]
+		var own_i: Node3D = _mp8_pick(all_groups[i], "damage indicator")
+		var far_i: Node3D = _mp8_pick(all_groups[partner], "damage indicator")
+		print("[MP8-WIRE] platform%d (%.0f,%.0f) rings=%d own ring=%s flipped ring=%s(platform%d)" % [
+			i + 1, slots[i].x, slots[i].z, pl.damage_circles.size(),
+			"none" if own_i == null else own_i.name,
+			"none" if far_i == null else far_i.name, partner + 1
+		])
+
+	# 5. One spawn point per platform, in platform order.
+	_mp8_rebuild_spawn_points(slots)
+
+	# 6. Camera. Record the stock camera before camera_base turns: the per-player mode measures against it.
+	if camera != null:
+		_mp8_cam_xf0 = camera.global_transform
+		_mp8_cam_fov0 = camera.fov
+
+	# The couch layout fits its own camera unless `mp8junkcam=` sets the offset.
+	if _mp8_couch != Vector3.ZERO and _mp8_arg("mp8junkcam=") == "":
