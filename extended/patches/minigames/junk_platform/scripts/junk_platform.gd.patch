+		_mp8_apply_camera(c.x, c.y, c.z)
+
+	_mp8_report_camera(all_groups, slots)
+
+	# [MP8] The stock decks' floors are one static collider left at the corners, its top at y -0.06,
+	# above the fall plane. Every deck has its own pillar, so a moved couch layout turns it off.
+	if _mp8_couch != Vector3.ZERO:
