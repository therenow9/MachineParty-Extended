+# ---------- [MP8-DIAG] Diagnostics ----------
+
+func _mp8_diag_start() -> void :
+
+	var mp8_args := NetworkManager.mp8_dev_args()
+	_mp8_diag_on = OS.has_feature("editor") or mp8_args.has("-debug-tools") or mp8_args.has("mp8diag")
+	if not _mp8_diag_on:
+		return
+
+	var peer: int = multiplayer.get_unique_id()
+	var path: String = "user://mp8_diag_%d.log" % peer
+	_mp8_diag_f = FileAccess.open(path, FileAccess.WRITE)
+
+	_mp8_diag("═══ Debris Platforms diagnostics peer=%d server=%s ═══" % [peer, str(multiplayer.is_server())])
+	_mp8_diag("void plane y=-2.00; a probe found a surface at y=-0.06 at bearings 45/135/225/315°, r=14~24.5")
+
+	# A survivor snapshot every 2 s, on a Timer: a `_process` here could override the base class's.
+	_mp8_diag_timer = Timer.new()
+	_mp8_diag_timer.wait_time = 2.0
+	_mp8_diag_timer.autostart = true
+	_mp8_diag_timer.timeout.connect(_mp8_diag_tick)
+	add_child(_mp8_diag_timer)
+
+
+func _mp8_diag(s: String) -> void :
+
+	if not _mp8_diag_on:
+		return
+	var line: String = "[%8.2f] %s" % [float(Time.get_ticks_msec()) / 1000.0, s]
+	print("[MP8-DIAG] " + line)
+	if _mp8_diag_f != null:
+		_mp8_diag_f.store_line(line)
+		_mp8_diag_f.flush()          # a hung round is killed; unflushed lines would be lost
+
+
+func _mp8_diag_name(nid: int) -> String :
+	if PlayerManager.player_presences.has(nid):
+		return String(PlayerManager.player_presences[nid].network_name)
+	return "id%d" % nid
+
+
+# y is the key: a player standing on the y=-0.06 surface never triggers a fall.
+func _mp8_diag_tick() -> void :
+
+	if not _mp8_diag_on or finished:
+		return
+
+	var parts: PackedStringArray = []
+	for nid in active_players.keys():
+		var pl = active_players[nid]
+		if not is_instance_valid(pl):
+			parts.append("%s:invalid ref" % _mp8_diag_name(nid))
+			continue
+		var gp: Vector3 = pl.global_position
+		var r: float = Vector2(gp.x, gp.z).length()
+		var ang: float = rad_to_deg(atan2(gp.x, gp.z))
+		if ang < 0.0:
+			ang += 360.0
+		parts.append("%s y=%.2f r=%.1f bearing %.0f° active=%s onfloor=%s" % [
+			_mp8_diag_name(nid), gp.y, r, ang, str(pl.active), str(pl.is_on_floor())
+		])
+
+	var np: int = -1
+	if junk_handler != null:
+		np = junk_handler.spawn_points.size()
+
+	_mp8_diag("alive %d | drop points %d | %s" % [
+		active_players.size(), np, "  ||  ".join(parts)])
+
+
+# `fall_rpc` emits this first; a fall with no death after it means the chain broke in the tween.
+func _mp8_diag_fallen(_last_hit_by: int, nid: int, who) -> void :
+
+	var pos: String = "?"
+	if is_instance_valid(who):
+		var gp: Vector3 = who.global_position
+		pos = "(%.1f, %.2f, %.1f) r=%.1f" % [gp.x, gp.y, gp.z, Vector2(gp.x, gp.z).length()]
+		# What the fall cast saw: a fall far above the plane at y -2 shows its reach and its hit.
+		var fc: ShapeCast3D = who.fall_cast
+		if fc != null:
+			var hits: PackedStringArray = []
+			for i in fc.get_collision_count():
+				var c = fc.get_collider(i)
+				hits.append("%s@%.1f" % [String(c.name) if c != null else "?", fc.get_collision_point(i).y])
+			pos += " cast %.1f hits %s" % [fc.target_position.y, ",".join(hits)]
+	_mp8_diag("★ falling %s pos=%s" % [_mp8_diag_name(nid), pos])
+
+
+# The death itself: `kill_rpc` and `emit_died` after `fall_rpc`'s 1.5 s tween.
+func _mp8_diag_died(nid: int) -> void :
+
+	_mp8_diag("☠ died %s (active_players=%d now)" % [
+		_mp8_diag_name(nid), active_players.size()])
+
