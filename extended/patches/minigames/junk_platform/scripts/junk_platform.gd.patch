+# ---------- [MP8] Sweep (see MP8_SWEEP_GRACE) ----------
+
+func _mp8_sweep_start() -> void :
+
+	# Server only: only the server fills `active_players`.
+	if not multiplayer.is_server():
+		return
+
+	_mp8_sweep_timer = Timer.new()
+	_mp8_sweep_timer.wait_time = MP8_SWEEP_TICK
+	_mp8_sweep_timer.autostart = true
+	_mp8_sweep_timer.timeout.connect(_mp8_sweep_dead)
+	add_child(_mp8_sweep_timer)
+
+
+func _mp8_sweep_dead() -> void :
+
+	if finished or not multiplayer.is_server():
+		return
+
+	# Only during play: before it starts every player is inactive.
+	if junk_handler == null or not junk_handler.active:
+		_mp8_dead_since.clear()
+		return
+
+	var stale: Array = []
+
+	for nid in active_players.keys():
+
+		var pl = active_players[nid]
+
+		if not is_instance_valid(pl):
+			stale.append(nid)          # reference gone, no grace needed
+			continue
+
+		if pl.active:
+			_mp8_dead_since.erase(nid)
+			continue
+
+		var t: float = float(_mp8_dead_since.get(nid, 0.0)) + MP8_SWEEP_TICK
+		_mp8_dead_since[nid] = t
+		if t >= MP8_SWEEP_GRACE:
+			stale.append(nid)
+
+	if stale.is_empty():
+		return
+
+	for nid in stale:
+
+		_mp8_dead_since.erase(nid)
+		if not active_players.has(nid):
+			continue
+
+		active_players.erase(nid)
+		# Into `dead_players` as well: ranks and the survivor's score are computed from it.
+		if not dead_players.has(nid):
+			dead_players.append(nid)
+		if junk_handler != null:
+			junk_handler.remove_spawn_point(nid)
+
+		var nm: String = "id%d" % nid
+		if PlayerManager.player_presences.has(nid):
+			nm = String(PlayerManager.player_presences[nid].network_name)
+		print("[MP8] Debris Platforms: ⚠️ sweep - %s was killed but emit_died never reached the server, %d left" % [
+			nm, active_players.size()
+		])
+
+	check_game_end()
