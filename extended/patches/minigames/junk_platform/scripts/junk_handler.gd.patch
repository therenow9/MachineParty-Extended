+# The game's _physics_process, for a mixed room (D120).
+func _mp8_game_physics_process(_delta: float) -> void :
+
+	if not multiplayer.is_server():
+		return
+
+	if active:
+		elapsed += _delta
+
+	var data: Dictionary[int, Transform3D]
+	for k in junk_instances.keys():
+		if junk_instances[k].active:
+			data[k] = junk_instances[k].global_transform
+
+	updata_junk_positions_rpc.rpc(data)
+
+# [MP8] The junk pause lives here, not only as a stopped timer: `set_active(true)` restarts the
+# timer, which would undo a pause set by `junk_platform._mp8_apply_junk_speed()`.
