+# [MP8] Server only: called from `_physics_process` after its `is_server()` return.
+func _mp8_recycle_stuck_junk(delta: float) -> void :
+
+	# Cubes rest between rounds; without the reset a batch would be recycled as soon as play starts.
+	if not active:
+		mp8_idle_time.clear()
+		return
+
+	for k in junk_instances.keys():
+
+		var junk: JunkCubeRigidbody = junk_instances[k]
+
+		if not is_instance_valid(junk):
+			mp8_idle_time.erase(k)
+			continue
+
+		# Pooled or not yet dropped; also skips one the catcher just took, so it is not pooled twice.
+		if not junk.active:
+			mp8_idle_time[k] = 0.0
+			continue
+
+		# A held cube is frozen with zero velocity and would vanish from the player's hands.
+		if junk.held_by:
+			mp8_idle_time[k] = 0.0
+			continue
+
+		if junk.linear_velocity.length() > mp8_stuck_speed_threshold:
+			mp8_idle_time[k] = 0.0
+			continue
+
+		var idle: float = mp8_idle_time.get(k, 0.0) + delta
+
+		if idle < mp8_stuck_recycle_time:
+			mp8_idle_time[k] = idle
+			continue
+
+		# Same path as the catcher; the next tick drops it again.
+		mp8_idle_time[k] = 0.0
+		junk.reset_rpc.rpc()
+		caught_junk.append(junk)
+
+		mp8_stuck_recycled += 1
+		print("[MP8] Debris Platforms: #%d still for over %.0f s, recycled (%d this round, %d in pool)" % [
+			k, mp8_stuck_recycle_time, mp8_stuck_recycled, caught_junk.size()])
