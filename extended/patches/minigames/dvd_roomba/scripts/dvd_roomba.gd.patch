+		player_count, dead_players.size(), _mp8_survivor_score(), " / ".join(parts)
+	])
+
+
+# [MP8] dead_players.size() + 1, not vanilla's player_count: remove_player_rpc only erases a
+# disconnected player from active_players, never adds them to dead_players, so player_count would
+# overpay the winner. The + 1 keeps vanilla's 2-point lead. A mixed room runs the game's check_game_end (D120).
+func _mp8_survivor_score() -> int :
