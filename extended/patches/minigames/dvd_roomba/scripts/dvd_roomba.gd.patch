+# [MP8] Server-side log of the final ranks and scores; changes none. The starting count and the
+# deaths are both printed: a difference above 1 means someone disconnected.
+func _mp8_log_scores() -> void :
+
+	if not multiplayer.is_server():
+		return
+
+	var keys: Array = player_scores.keys()
+	keys.sort_custom(func(a, b): return player_scores[a] > player_scores[b])
+
+	var parts: PackedStringArray = []
+	for i in keys.size():
