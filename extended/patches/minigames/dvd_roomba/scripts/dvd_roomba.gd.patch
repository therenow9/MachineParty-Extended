+# [MP8] Tops the spawns up to 8 as a regular octagon computed from the shipped markers, which stay
+# untouched. Adds only what is missing, so a scene that has 8 is left alone.
+func _mp8_topup_spawns() -> void :
+
+	# The room is latched before this scene's add_child (game.gd). A mixed room keeps the game's 4 (D116).
+	if not NetworkManager.mp8_room_extended():
+		print("[MP8] Lethal Rebound: a mixed room, the game's spawns unchanged")
+		return
+
+	if player_spawn_parent_node == null:
+		push_warning("[MP8] Lethal Rebound: no spawn container, not expanding to 8")
+		return
+
+	var originals: Array = []
+	for c in player_spawn_parent_node.get_children():
+		if c is Node3D:
+			originals.append(c)
+
+	var n: int = originals.size()
+	if n == 0 or n >= 8:
+		return
+
+	# Centre: the shipped markers' centroid; radius: their mean distance from it.
+	var center: Vector3 = Vector3.ZERO
+	for o in originals:
+		center += o.position
+	center /= float(n)
+
+	var radius: float = 0.0
+	for o in originals:
+		radius += Vector2(o.position.x - center.x, o.position.z - center.z).length()
+	radius /= float(n)
+
+	# Each new point lies on the bisector of two angle-adjacent shipped markers.
+	var angles: Array = []
+	for o in originals:
+		angles.append(atan2(o.position.z - center.z, o.position.x - center.x))
+	angles.sort()
+
+	var added := PackedStringArray()
+
+	for i in angles.size():
+
+		if originals.size() + added.size() >= 8:
+			break
+
+		var a: float = angles[i]
+		var b: float = float(angles[(i + 1) % angles.size()])
+		if b <= a:
+			b += TAU                       # across the -pi/pi seam, or the bisector points the wrong way
+		var mid: float = (a + b) * 0.5
+
+		var p: Vector3 = Vector3(
+			center.x + cos(mid) * radius,
+			originals[0].position.y,
+			center.z + sin(mid) * radius
+		)
+
+		# Duplicated from the nearest shipped marker, so rotation, scale and script follow it.
+		var tmpl: Node3D = originals[0]
+		var best: float = INF
+		for o in originals:
+			var d: float = o.position.distance_to(p)
+			if d < best:
+				best = d
+				tmpl = o
+
+		var dup: Node3D = tmpl.duplicate()
+		dup.name = "MP8Spawn%d" % (n + added.size())
+		player_spawn_parent_node.add_child(dup)
+		dup.position = p
+		added.append("(%.2f, %.2f)" % [p.x, p.z])
+
+	# Logs the smallest gap: coincident points are how this kind of top-up fails, and the count alone
+	# would not show it.
+	var pts: Array = []
+	for c in player_spawn_parent_node.get_children():
+		if c is Node3D:
+			pts.append(c.position)
+
+	var min_d: float = INF
+	for i in pts.size():
+		for j in range(i + 1, pts.size()):
+			min_d = minf(min_d, Vector2(pts[i].x - pts[j].x, pts[i].z - pts[j].z).length())
+
+	print("[MP8] Lethal Rebound: spawns %d -> %d (centre (%.2f, %.2f) radius %.2f, smallest gap %.2f m) added %s" % [
+		n, pts.size(), center.x, center.z, radius, min_d, " ".join(added)
+	])
+
