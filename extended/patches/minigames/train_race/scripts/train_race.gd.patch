+# [MP8] Spawns 4 -> 8. The shipped markers are 2 columns (x < 0, x > 0) of 2; the new ones are spaced
+# evenly between each column's ends, so they stay inside the shipped layout and off the centre line.
+# The shipped 4 are untouched.
+func _mp8_expand_spawns() -> void :
+
+	# A mixed room keeps the game's 4 spawns (D120); they change above 4 players only.
+	if not NetworkManager.mp8_room_extended():
+		return
+
+	var mp8_args := NetworkManager.mp8_dev_args()
+	mp8_player_count = PlayerManager.player_presences.size()
+
+	if player_spawn_positions_node == null:
+		push_warning("[MP8] Tunnel Hazard: no spawn container, not expanding to 8")
+		return
+
+	var originals: Array = []
+	for child in player_spawn_positions_node.get_children():
+		if child is Node3D:
+			originals.append(child)
+
+	var n: int = originals.size()
+	if n == 0:
+		push_warning("[MP8] Tunnel Hazard: the spawn container is empty, not expanding to 8")
+		return
+
+	if mp8_args.has("mp8noexpand"):
+		print("[MP8] Tunnel Hazard: mp8noexpand, spawns left as shipped (vanilla control run, use 4 players)")
+		return
+
+	# Nothing is added for 4 or fewer: spawn_players() shuffles the markers, so an added one could be
+	# drawn and the game would no longer match vanilla.
+	if mp8_player_count <= 4:
+		print("[MP8] Tunnel Hazard: %d players, using the shipped %d spawn points unchanged" % [mp8_player_count, n])
+		return
+
+	var want: int = mini(maxi(mp8_player_count, 5), MP8_MAX_PLAYERS)
+	if n >= want:
+		print("[MP8] Tunnel Hazard: already %d spawn points (need %d), nothing to add" % [n, want])
+		return
+
+	# Two columns by the sign of x (the shipped markers are two on each side).
+	var columns: Dictionary = {"left": [], "right": []}
+	for m in originals:
+		if m.position.x < 0.0:
+			columns["left"].append(m)
+		else:
+			columns["right"].append(m)
+
+	# Each column sorted by z, so its ends come first and last.
+	for key in columns.keys():
+		columns[key].sort_custom(func(a, b): return a.position.z < b.position.z)
+
+	var need: int = want - n
+	var added: Array = []
+
+	# The new points alternate between the columns, to keep the sides even.
+	var order: Array = ["left", "right"]
+	var per_column: Dictionary = {"left": 0, "right": 0}
+	for j in need:
+		per_column[order[j % order.size()]] += 1
+
+	for key in order:
+
+		var col: Array = columns[key]
+		var add: int = per_column[key]
+		if add <= 0:
+			continue
+
+		# Interpolating needs both ends; the shipped columns have two each, so this fires only if the scene changes.
+		if col.size() < 2:
+			push_warning("[MP8] Tunnel Hazard: column %s has only %d shipped points, cannot interpolate, skipping it" % [key, col.size()])
+			continue
+
+		var a: Node3D = col[0]
+		var b: Node3D = col[col.size() - 1]
+
+		for i in add:
+			# t runs 1/(add+1) .. add/(add+1): evenly between the ends, x included.
+			var t: float = float(i + 1) / float(add + 1)
+			var extra: Node3D = a.duplicate()
+			extra.name = "MP8Spawn_%s_%d" % [key, i]
+			player_spawn_positions_node.add_child(extra)
+			extra.position = a.position.lerp(b.position, t)
+			added.append(extra)
+
+	# Logs the smallest gap, so a layout change can be checked against a number.
+	var all_points: Array = originals + added
+	var min_gap: float = INF
+	var min_pair: String = ""
+	for i in all_points.size():
+		for j in range(i + 1, all_points.size()):
+			var d: float = all_points[i].position.distance_to(all_points[j].position)
+			if d < min_gap:
+				min_gap = d
+				min_pair = "%s↔%s" % [all_points[i].name, all_points[j].name]
+
+	var parts: Array = []
+	for m in added:
+		parts.append("%s(%.2f,%.2f)" % [m.name, m.position.x, m.position.z])
+
+	print("[MP8] Tunnel Hazard: %d players - spawns %d -> %d, smallest gap %.2f m (%s); added %s" % [
+		mp8_player_count, n, all_points.size(), min_gap, min_pair, ", ".join(parts)])
+
+	if min_gap < MP8_MIN_SPAWN_GAP:
+		push_warning("[MP8] Tunnel Hazard: smallest gap %.2f m < %.2f, players may spawn overlapping" % [
+			min_gap, MP8_MIN_SPAWN_GAP])
+
