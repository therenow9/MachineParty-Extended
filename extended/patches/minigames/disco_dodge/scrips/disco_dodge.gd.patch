+# [MP8] Logs the final ranks and scores; scoring stays vanilla's: the n-th to fall scores n - 1 and
+# the survivor player_count, so the winner leads by 2. player_count is the starting count, so after a
+# disconnect the survivor is overpaid. scoring_players is never appended to and holds no order.
+func _mp8_log_scores() -> void :
+
+	var rows := PackedStringArray()
+
+	for i in dead_players.size():
+		var id: int = dead_players[i]
+		rows.append("fall #%d %s %d pts" % [i + 1, _mp8_name(id), i])
+
+	for network_id in active_players.keys():
+		rows.append("survivor %s %d pts" % [_mp8_name(network_id), player_count])
+		break
+
+	print("[MP8] Stable Footing scores (%d at start / %d fell): %s" % [
+		player_count, dead_players.size(), " | ".join(rows)
+	])
+
+
+func _mp8_name(network_id: int) -> String :
