+# ---------- [MP8] Jumbotron camera for the 45-degree seats ----------
+# The jumbotron's 4 screens face the game's seats, with pillars at the corners a 45-degree seat faces. The
+# camera rig (the `Node3D` above CameraParent, which `anim_camera` overwrites each frame) swings around the
+# arena centre by -(yaw mod 90): 0 for the game's seats, -45 for the new ones, each to a different screen.
+
+## Degrees the camera swings around the arena centre for the jumbotron (0 for the game's seats)
+var _mp8_view_offset_deg: float = 0.0
+## The rig's (CameraParent's parent) original local transform, taken once
+var _mp8_rig_rest: Transform3D = Transform3D.IDENTITY
+var _mp8_rig_rest_taken: bool = false
+var _mp8_view_tween: Tween
+
+
+func _mp8_camera_rig() -> Node3D :
+	if camera_parent == null:
+		return null
+	return camera_parent.get_parent() as Node3D
+
+
+func _mp8_set_seat_yaw(yaw_deg: float) -> void :
+
+	# Turn back by the difference from the nearest of the game's directions (a multiple of 90 degrees)
+	var within: float = fposmod(yaw_deg, 90.0)
+	_mp8_view_offset_deg = - within
+
+	if not is_zero_approx(_mp8_view_offset_deg):
+		print("[MP8] Chisel Gauntlet: local player in the %.0f° seat (not a stock direction), jumbotron camera turns %+.0f°" % [
+			fposmod(yaw_deg, 360.0), _mp8_view_offset_deg
+		])
+
+
+# Rotates the rig around the arena centre to `deg`: a left-multiplied rotation turns about the parent's
+# (the player root's) origin, which is the arena centre, so no absolute coordinates are needed.
+func _mp8_apply_view_angle(deg: float) -> void :
+
+	var rig: Node3D = _mp8_camera_rig()
+	if rig == null:
+		return
+	if not _mp8_rig_rest_taken:
+		_mp8_rig_rest = rig.transform
+		_mp8_rig_rest_taken = true
+
+	rig.transform = Transform3D(Basis(Vector3.UP, deg_to_rad(deg)), Vector3.ZERO) * _mp8_rig_rest
+
+
+# ---------- [MP8] Other players hidden while memorising ----------
+# The swung camera lands near the game's seat whose screen it faces, so it sees that player's head, and no
+# camera position faces the screen squarely without it. Other players' third-person visuals are hidden on
+# this machine only (no RPC); only what this hid is restored, so eliminated players stay hidden.
+# Split screen clears the other seats' body layers from this camera's cull mask; online sets `visible`.
+var _mp8_hidden_others: Array[Node3D] = []
+var _mp8_local_hidden_mask: int = 0
+
+
+func _mp8_is_local_view() -> bool :
+	if player_presence == null:
+		return false
+	return GameManager.local_game or (multiplayer.get_unique_id() == player_presence.network_id)
+
+
+# [MP8] Other player instances, not `game_instance.players`: that dictionary is filled by spawn_players()
+# from initialize(), which runs only on the server, so on clients it is empty. Players are children of
+# `PlayerSpawnNode` on every machine (replicated), so the siblings are scanned.
+func _mp8_others() -> Array :
+
+	var parent: Node = get_parent()
+	if parent == null:
+		return []
+
+	var out: Array = []
+	for c in parent.get_children():
+		if c != self and c is ChiselGauntletPlayer:
+			out.append(c)
+	return out
+
+
+func _mp8_hide_others(hide_them: bool) -> void :
+
+	# Split screens share one world. Hide bodies only in this camera, never by
+	# changing the shared visual node that the other seven cameras also render.
+	if GameManager.local_game:
+		if hide_them:
+			if _mp8_local_hidden_mask == 0:
+				for index in 8:
+					var bit: int = 1 << (_mp8_local_layer(index, true) - 1)
+					_mp8_local_hidden_mask |= local_camera.cull_mask & bit
+				local_camera.cull_mask &= ~_mp8_local_hidden_mask
+		else:
+			local_camera.cull_mask |= _mp8_local_hidden_mask
+			_mp8_local_hidden_mask = 0
+		return
+
+	# Only this machine's own player manages what its camera shows
+	if not _mp8_is_local_view():
+		return
+
+	if not hide_them:
+		for v in _mp8_hidden_others:
+			if is_instance_valid(v):
+				v.visible = true
+		_mp8_hidden_others.clear()
+		return
+
+	if not _mp8_hidden_others.is_empty():
+		return  # already hidden; don't record twice
+
+	for other in _mp8_others():
+		if not is_instance_valid(other):
+			continue
+		var v: Node3D = other.visuals_third_person
+		if v == null or not v.visible:
+			continue          # already invisible (eliminated/disconnected): not ours to hide or restore
+		v.visible = false
+		_mp8_hidden_others.append(v)
+
+	if not _mp8_hidden_others.is_empty():
+		print("[MP8] Chisel Gauntlet: hid %d other players' visuals while memorising (this machine)" % _mp8_hidden_others.size())
+
+
+# Tweens over `duration` when above 0, in step with the game's 1.5-second head turn.
+func _mp8_aim_view(target_deg: float, duration: float) -> void :
+
+	var rig: Node3D = _mp8_camera_rig()
+	if rig == null:
+		return
+	if not _mp8_rig_rest_taken:
+		_mp8_rig_rest = rig.transform
+		_mp8_rig_rest_taken = true
+
+	if _mp8_view_tween != null and _mp8_view_tween.is_valid():
+		_mp8_view_tween.kill()
+
+	# The game's seats have offset 0: from and to are both 0 and this returns, as the game behaves
+	var from: float = rad_to_deg((_mp8_rig_rest.affine_inverse() * rig.transform).basis.get_euler().y)
+	if is_zero_approx(target_deg) and is_zero_approx(from):
+		return
+
+	if duration <= 0.0:
+		_mp8_apply_view_angle(target_deg)
+		return
+
+	_mp8_view_tween = create_tween()
+	_mp8_view_tween.tween_method(_mp8_apply_view_angle, from, target_deg, duration
+	).set_ease(Tween.EASE_IN_OUT).set_trans(Tween.TRANS_SINE)
