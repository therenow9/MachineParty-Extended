+# A pad press steps to the active cube, or SUBMIT or RESET, that lies that way on
+# this seat's screen; the game's table (segment_matrix) is the fallback. On the
+# corner view its top-face links point 61-64 degrees off their stick direction.
+func _mp8_screen_target(from: Node3D, direction: Vector2) -> int:
+	var cam: Camera3D = local_camera if is_instance_valid(local_camera) else player_camera
+	if not is_instance_valid(cam) or not is_instance_valid(from) or cam.is_position_behind(from.global_position):
+		return MP8_NO_TARGET
+	var at: Dictionary = {}
+	for id in segments_by_id:
+		var node: Node3D = segments_by_id[id]
+		if node == from or not is_instance_valid(node) or cam.is_position_behind(node.global_position):
+			continue
+		if id >= 0 and not node.active:
+			continue
+		at[id] = cam.unproject_position(node.global_position)
+	return mp8_pick_screen_target(cam.unproject_position(from.global_position), at, direction)
+
+# The block is a honeycomb on screen: two of each cube's six neighbours lie
+# diagonally on each side, so a stick press steps in 8 directions. A press waits
+# until the stick is MP8_SETTLE_LENGTH out or MP8_SETTLE_S has passed, so the
+# second axis of a diagonal flick has crossed its deadzone; the d-pad is at once.
+const MP8_SETTLE_S: float = 0.08
+const MP8_SETTLE_LENGTH: float = 0.6
+var _mp8_press_age: float = -1.0
+var _mp8_press_last: Vector2 = Vector2.ZERO
+var _mp8_press_frame: int = -1
+
+# The stick's furthest reading since the press, once it has settled (ZERO until then):
+# raw strengths follow the stick below the deadzone, so its spring back must not steer.
+func _mp8_stick_press(delta: float, settle_now: bool = false) -> Vector2:
+	var frame: int = Engine.get_process_frames()
+	if _mp8_press_age >= 0.0 and frame - _mp8_press_frame > 1:
+		_mp8_press_age = -1.0
+	_mp8_press_frame = frame
+	if _mp8_press_age < 0.0:
+		for action in [&"up", &"right", &"down", &"left"]:
+			if DynamicInput.is_action_just_pressed(device_id, action):
+				_mp8_press_age = 0.0
+				_mp8_press_last = Vector2.ZERO
+		if _mp8_press_age < 0.0:
+			return Vector2.ZERO
+	else:
+		_mp8_press_age += delta
+	var v := Vector2(
+		DynamicInput.get_action_raw_strength(device_id, &"right") - DynamicInput.get_action_raw_strength(device_id, &"left"),
+		DynamicInput.get_action_raw_strength(device_id, &"down") - DynamicInput.get_action_raw_strength(device_id, &"up"))
+	if v.length() > _mp8_press_last.length():
+		_mp8_press_last = v
+	if not settle_now and v.length() > Globals.Epsilon and v.length() < MP8_SETTLE_LENGTH and _mp8_press_age < MP8_SETTLE_S:
+		return Vector2.ZERO
+	_mp8_press_age = -1.0
+	return _mp8_press_last
+
+# One of the 8 unit directions nearest v (diagonals normalised); ZERO for ZERO.
+static func mp8_snap_8(v: Vector2) -> Vector2:
+	if v.length() <= Globals.Epsilon:
+		return Vector2.ZERO
+	var step: int = int(roundf(v.angle() / (PI / 4.0)))
+	return Vector2.from_angle(step * PI / 4.0).round().normalized()
+
+# The game's table knows only the four sticks: the nearer one to the unsnapped stick v.
+static func mp8_cardinal(v: Vector2) -> Vector2:
+	if absf(v.x) > absf(v.y):
+		return Vector2(signf(v.x), 0.0)
+	return Vector2(0.0, signf(v.y))
+
+const MP8_SCREEN_CONE_DEG: float = 65.0
+# SUBMIT_VALUE and RESET_VALUE are -1 and -2, so "nothing that way" needs its own id.
+const MP8_NO_TARGET: int = -3
+
+# The nearest candidate within MP8_SCREEN_CONE_DEG of direction, a straighter one
+# preferred (distance times 1 + 2 * angle / 45); MP8_NO_TARGET when none lies that way.
+static func mp8_pick_screen_target(origin: Vector2, candidates: Dictionary, direction: Vector2) -> int:
+	var best: int = MP8_NO_TARGET
+	var best_cost: float = INF
+	for id in candidates:
+		var v: Vector2 = candidates[id] - origin
+		var along: float = v.dot(direction)
+		if along <= 0.0:
+			continue
+		var angle: float = rad_to_deg(atan2(absf(v.cross(direction)), along))
+		if angle > MP8_SCREEN_CONE_DEG:
+			continue
+		var cost: float = v.length() * (1.0 + 2.0 * angle / 45.0)
+		if cost < best_cost:
+			best_cost = cost
+			best = id
+	return best
