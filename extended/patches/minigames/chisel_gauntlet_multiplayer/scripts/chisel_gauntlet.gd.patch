+# ---------- [MP8] Chisel Gauntlet for 8 players ----------
+# Players share one spawn and differ only by yaw, so seats are extra player_rotations entries. The desk
+# colliders (`Colliders/StaticBody3D{,2,3,4}`) and visible desks (`chisel gauntlet art2/walls/control panel *`;
+# `Geometry/environment` is a hidden greybox) are 4 copies at the origin differing only by yaw, so the new
+# seats get copies rotated as a group: pairing is by angle, never by index.
+
+const MP8_MAX_SEATS: int = 8
+
+## Visible art belonging to a seat (under `chisel gauntlet art2/walls`): four copies 90 degrees apart,
+## cloned and rotated about Y. `control panel hole mesh` / `control panel hole wires` sit at the arena
+## centre and are not per-seat: never list them here.
+const MP8_SEAT_ART_NODES: Array[String] = [
+	"control panel alpha", "control panel bravo",
+	"control panel charlie", "control panel delta",
+]
+
+## The signs above the seats (alpha/bravo/charlie/delta), cloned with the desks by default.
+const MP8_SEAT_SIGN_NODES: Array[String] = [
+	"sign_alpha", "sign_bravo", "sign_charlie", "sign_delta",
+]
+
+## Clone visible desks for the new seats; `mp8chiselnodesk` turns it off (colliders only, for comparison).
+var _mp8_clone_desk_art: bool = true
+## mp8chiselnosign: clone the visible desks without their signs
+var _mp8_clone_sign: bool = true
+
+
+func _mp8_setup_seats() -> void :
+
+	var mp8_args := NetworkManager.mp8_dev_args()
+
+	_mp8_clone_desk_art = not mp8_args.has("mp8chiselnodesk")
+	_mp8_clone_sign = not mp8_args.has("mp8chiselnosign")
+
+	# Log the runtime value before changing it: an @export's real value comes from the scene, not the script.
+	print("[MP8] Chisel Gauntlet: runtime player_rotations = %s, %d entries" % [
+		str(player_rotations), player_rotations.size()
+	])
+
+	var want: int = clampi(PlayerManager.player_presences.size(), 0, MP8_MAX_SEATS)
+	if want > player_rotations.size():
+		push_warning("[MP8] Chisel Gauntlet: %d players but player_rotations has only %d entries, not enough seats" % [
+			want, player_rotations.size()
+		])
+		want = player_rotations.size()
+
+	_mp8_rebuild_shotgun_order(want)
+
+	if mp8_args.has("mp8noexpand"):
+		print("[MP8] Chisel Gauntlet: mp8noexpand, no seat furniture added (stock control run)")
+		return
+
+	if want <= 4:
+		print("[MP8] Chisel Gauntlet: %d players, the game's 4 seat sets unchanged" % want)
+		return
+
+	_mp8_expand_seats(want)
+
+
+# The game's [0, 2, 1, 3] is the seats ascending by angle 0->90->180->270, written as indices. Sorting
+# gives the same at 4 players and [0,4,2,6,1,5,3,7] at 8.
+func _mp8_rebuild_shotgun_order(seat_count: int) -> void :
+
+	var vanilla := shotgun_check_order.duplicate()
+
+	var order: Array[int] = []
+	for i in seat_count:
+		order.append(i)
+	order.sort_custom(func(a, b):
+		return _mp8_wrap360(player_rotations[a]) < _mp8_wrap360(player_rotations[b])
+	)
+	shotgun_check_order = order
+
+	var parts := PackedStringArray()
+	for i in order:
+		parts.append("%d(%.0f°)" % [i, _mp8_wrap360(player_rotations[i])])
+	print("[MP8] Chisel Gauntlet: shotgun check order %s -> %s   %s" % [
+		str(vanilla), str(order), ", ".join(parts)
+	])
+
+	if seat_count == 4 and order != vanilla:
+		push_warning("[MP8] Chisel Gauntlet: check order at 4 players differs from the game's (%s vs %s), check it" % [
+			str(order), str(vanilla)
+		])
+
+
+func _mp8_expand_seats(seat_count: int) -> void :
+
+	# ---- 1. Seat directions from the player scene's real ./Visuals offset, not a hard-coded 8.0/180 ----
+	var visuals_offset: Vector3 = _mp8_player_visuals_offset()
+	if is_zero_approx(Vector2(visuals_offset.x, visuals_offset.z).length()):
+		push_warning("[MP8] Chisel Gauntlet: cannot measure the player Visuals' horizontal offset, no seat furniture added")
+		return
+	print("[MP8] Chisel Gauntlet: player Visuals local offset = %s (radius %.2f m)" % [
+		str(visuals_offset), Vector2(visuals_offset.x, visuals_offset.z).length()
+	])
+
+	var seat_dir: Array[float] = []
+	for i in seat_count:
+		seat_dir.append(_mp8_seat_direction(visuals_offset, player_rotations[i]))
+
+	# ---- 2. Verify new seats = the game's seats rotated by MP8_SEAT_STEP; group rotation depends on it ----
+	if not _mp8_verify_rotational_layout(seat_dir):
+		push_warning("[MP8] Chisel Gauntlet: seats are not the game's rotated by %.0f°, no seat furniture added" % MP8_SEAT_STEP)
+		return
+
+	# ---- 3. Desk colliders ----
+	var colliders: Node3D = get_node_or_null("Colliders") as Node3D
+	if colliders != null:
+		var desks: Array[Node3D] = []
+		for c in colliders.get_children():
+			if c is StaticBody3D and _mp8_find_child_named(c, "desk") != null:
+				desks.append(c)
+		_mp8_clone_group_rotated(colliders, desks, "desk colliders")
+	else:
+		push_warning("[MP8] Chisel Gauntlet: no Colliders node, desk colliders not added")
+
+	# ---- 4. Visible desks and signs ----
+	var walls: Node3D = get_node_or_null("chisel gauntlet art2/walls") as Node3D
+	if walls == null:
+		push_warning("[MP8] Chisel Gauntlet: 'chisel gauntlet art2/walls' not found, all visible pieces skipped")
+		return
+
+	if not _mp8_clone_desk_art:
+		print("[MP8] Chisel Gauntlet: new seats have desk colliders but no visible desks (mp8chiselnodesk)")
+		return
+
+	var groups: Array = [MP8_SEAT_ART_NODES]
+	var labels: Array = ["visible desks"]
+	if _mp8_clone_sign:
+		groups.append(MP8_SEAT_SIGN_NODES)
+		labels.append("seat signs")
+
+	for g in groups.size():
+		var srcs: Array[Node3D] = []
+		for nm in groups[g]:
+			var n: Node3D = walls.get_node_or_null(nm) as Node3D
+			if n == null:
+				push_warning("[MP8] Chisel Gauntlet: visible piece '%s' missing, skipped" % nm)
+				continue
+			srcs.append(n)
+		_mp8_clone_group_rotated(walls, srcs, labels[g])
+
+
+## Angle from each of the game's seats to a new one: 8 seats = the 4 plus one between each pair.
+const MP8_SEAT_STEP: float = 45.0
+
+
+# Verifies new seats = the game's 4 rotated by MP8_SEAT_STEP, the one premise of group rotation: each new
+# seat must match exactly one of the game's seats MP8_SEAT_STEP degrees away, one to one.
+func _mp8_verify_rotational_layout(seat_dir: Array[float]) -> bool :
+
+	if seat_dir.size() <= 4:
+		return true
+
+	var used: Array[int] = []
+	for i in range(4, seat_dir.size()):
+		var found: int = -1
+		for j in 4:
+			if absf(_mp8_angle_delta(seat_dir[j], seat_dir[i]) - MP8_SEAT_STEP) < 1.0:
+				found = j
+				break
+		if found < 0 or used.has(found):
+			return false
+		used.append(found)
+	return true
+
+
+# Clones a per-seat group of nodes once, each copy rotated MP8_SEAT_STEP about the arena centre. No copy is
+# matched to a seat: the desk meshes are off-centre (AABB centre 33 degrees off the seat axis) and every node
+# origin is the same, so neither identifies a seat. Rotating the 4 as a group covers the 4 new seats; with
+# 5-7 players some new desks stay empty, as desks do after eliminations.
+func _mp8_clone_group_rotated(
+	parent: Node3D,
+	sources: Array[Node3D],
+	label: String
+) -> void :
+
+	if sources.is_empty():
+		push_warning("[MP8] Chisel Gauntlet: no %s found, skipped" % label)
+		return
+
+	# Self-check: the 4 must be one piece rotated by 90 degrees, judged by node yaw, not mesh centre.
+	var yaws: Array[float] = []
+	for s in sources:
+		yaws.append(_mp8_wrap360(rad_to_deg(s.global_transform.basis.get_euler().y)))
+	var sorted_yaws := yaws.duplicate()
+	sorted_yaws.sort()
+	var even: bool = sources.size() == 4
+	if even:
+		for i in 4:
+			if absf(_mp8_angle_delta(sorted_yaws[i], sorted_yaws[(i + 1) % 4]) - 90.0) > 1.0:
+				even = false
+				break
+
+	var wire := PackedStringArray()
+	for i in sources.size():
+		wire.append("%s(yaw %.0f°)" % [String(sources[i].name), yaws[i]])
+	print("[MP8-WIRE] Chisel Gauntlet: %s, %d stock copies - %s   %s" % [
+		label, sources.size(), ", ".join(wire),
+		("✓ four copies 90° apart" if even else "❌ not four even copies, group rotation may not hold")
+	])
+	if not even:
+		push_warning("[MP8] Chisel Gauntlet: %s is not four copies 90° apart; still rotating the group %.0f°, check a render" % [
+			label, MP8_SEAT_STEP
+		])
+
+	var added := PackedStringArray()
+	for s in sources:
+		var dup: Node3D = s.duplicate()
+		dup.name = "%s_MP8" % String(s.name)
+		parent.add_child(dup)
+		_mp8_rotate_about_center(dup, s, MP8_SEAT_STEP)
+		added.append("%s→%s" % [String(s.name), String(dup.name)])
+
+	print("[MP8] Chisel Gauntlet: %s cloned as a group, %d copies, each turned %+.0f° - %s" % [
+		label, added.size(), MP8_SEAT_STEP, ", ".join(added)
+	])
+
+
+# The arena centre's frame: `PlayerSpawnNode`, the centre of the seat circle (spawn_players() teleports
+# everyone to it). `Minigame extends Node`, so `self` has no `global_transform`; using it still compiles,
+# but the script then fails to load with a Parse Error and the minigame never starts.
+func _mp8_field_transform() -> Transform3D :
+	if player_spawn_node != null:
+		return player_spawn_node.global_transform
+	return Transform3D.IDENTITY
+
+
+# Rotates dup `delta_deg` about the arena centre's Y axis. `dup.rotate_y()` would turn about the node's own
+# origin, so the rotation is left-multiplied in the arena centre's space.
+func _mp8_rotate_about_center(dup: Node3D, src: Node3D, delta_deg: float) -> void :
+	var base: Transform3D = _mp8_field_transform()
+	var rot := Transform3D(Basis(Vector3.UP, deg_to_rad(delta_deg)), Vector3.ZERO)
+	dup.global_transform = base * rot * base.affine_inverse() * src.global_transform
+
+
+# A seat's (a yaw's) direction in the arena: the player root sits at the origin and only turns, and
+# ./Visuals' local offset places the player, so the direction is that offset rotated by the yaw.
+func _mp8_seat_direction(visuals_offset: Vector3, yaw_deg: float) -> float :
+	var v: Vector3 = Basis(Vector3.UP, deg_to_rad(yaw_deg)) * visuals_offset
+	return _mp8_wrap360(rad_to_deg(atan2(v.x, v.z)))
+
+
+# Reads ./Visuals' local offset from the player PackedScene (read, not instantiated) rather than a
+# hard-coded 8.0.
+func _mp8_player_visuals_offset() -> Vector3 :
+
+	var st: SceneState = player_scene.get_state()
+	for i in st.get_node_count():
+		var path: String = String(st.get_node_path(i)).trim_prefix("./")
+		if path != "Visuals":
+			continue
+		for k in st.get_node_property_count(i):
+			if String(st.get_node_property_name(i, k)) != "transform":
+				continue
+			var v = st.get_node_property_value(i, k)
+			if v is Transform3D:
+				return (v as Transform3D).origin
+	return Vector3.ZERO
+
+
+func _mp8_find_child_named(n: Node, needle: String) -> Node3D :
+	for c in n.get_children():
+		if c is Node3D and String(c.name).to_lower().contains(needle):
+			return c
+	return null
+
+
+func _mp8_wrap360(a: float) -> float :
+	return fposmod(a, 360.0)
+
+
+# [MP8] Every split-screen tile redraws each omni light's shadow every frame; dual paraboloid is 2 passes
+# to the cube's 6 (D90). Local only: online keeps the game's cube shadows. Runs after the players spawn,
+# so their own small lights are included.
+func _mp8_paraboloid_omni_shadows() -> void:
+	for light in find_children("*", "OmniLight3D", true, false):
+		(light as OmniLight3D).omni_shadow_mode = OmniLight3D.SHADOW_DUAL_PARABOLOID
+
+
+## Signed degrees to turn from a to b (-180..180)
+func _mp8_angle_delta(a: float, b: float) -> float :
+	return rad_to_deg(angle_difference(deg_to_rad(a), deg_to_rad(b)))
+
+
+# [MP8] Debug screenshot (`mp8shot`): the game saves its own PNG. Broadcast by RPC because both callers
+# (generate_random_cube_instructions / start_round_timer) run only on the server, and each seat's own
+# first-person view is what needs checking.
+func mp8_shot_rpc(tag: String, delay: float) -> void :
+
+	if not NetworkManager.mp8_dev_args().has("mp8shot"):
+		return
+
+	await get_tree().create_timer(delay, false).timeout
+	if not is_inside_tree():
+		return
+	await RenderingServer.frame_post_draw
+
+	var me: int = multiplayer.get_unique_id() if multiplayer.has_multiplayer_peer() else 0
+	var who: String = "p%d" % me
+	if PlayerManager.player_presences.has(me):
+		who = String(PlayerManager.player_presences[me].network_name)
+
+	var img: Image = get_viewport().get_texture().get_image()
+	if img != null:
+		img.save_png("user://mp8_chisel_%s_%s.png" % [tag, who])
+
+
+func mp8_show_dead_lobby() -> void :
+	dead_camera.get_viewport().render_target_update_mode = SubViewport.UPDATE_ALWAYS
+
+
+# [MP8] Log only: ranks, names and scores at the end, unchanged. This is the one minigame whose scores
+# can go negative.
+func _mp8_log_scores() -> void :
+
+	if not multiplayer.is_server():
+		return
+
+	var rows: Array = []
+	for id in player_scores.keys():
+		var nm: String = "id%d" % id
+		if PlayerManager.player_presences.has(id):
+			nm = String(PlayerManager.player_presences[id].network_name)
+		rows.append({"name": nm, "score": player_scores[id]})
+	rows.sort_custom(func(a, b): return a["score"] > b["score"])
+
+	var parts := PackedStringArray()
+	for i in rows.size():
+		parts.append("#%d %s %d pts" % [i + 1, rows[i]["name"], rows[i]["score"]])
+	print("[MP8] Chisel Gauntlet scores (%d players / starting score %d): %s" % [
+		player_count, player_count, " / ".join(parts)
+	])
+
