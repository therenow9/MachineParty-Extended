+# The game's _on_timer_timeout, for a mixed room (D120).
+func _mp8_game_on_timer_timeout():
+
+	if reading:
+
+		if randf() < fakeout_chance:
+			stop_reading_fakeout_rpc.rpc()
+			timer.start(randf_range(min_read_time, max_read_time))
+		else:
+			stop_reading_rpc.rpc()
