+# [MP8] Shoots this glance's catches in the order caught: one by the game's own RPC, two by ours. A caught
+# player who has left is skipped; false when nobody is left to shoot.
+func _mp8_shoot_caught() -> bool :
+
+	var seats := PackedInt32Array()
+	for nid in _mp8_caught:
+		var p = players.get(nid)
+		if p != null and is_instance_valid(p):
+			seats.append(p.player_seat_position)
+
+	_mp8_log("shot, seats %s" % str(seats))
+
+	if seats.is_empty():
+		_mp8_caught.clear()
+		return false
+
+	if seats.size() == 1:
+		shoot_player_rpc.rpc(seats[0])
+	else:
+		NetworkManager.mp8_rpc(self, &"mp8_shoot_players_rpc", [seats])
+	return true
+
+
+# Under Movie Maker the clock is the frame count, not the milliseconds.
+func _mp8_log(what: String) -> void :
+
+	var who := PackedStringArray()
+	for nid in _mp8_caught:
+		var p = players.get(nid)
+		if p != null and is_instance_valid(p) and p.player_presence != null:
+			who.append("%s@%d" % [p.player_presence.network_name, p.player_seat_position])
+		else:
+			who.append("id%d" % nid)
+	print("[MP8] Table Manners: %s, limit %d, caught [%s], t=%d ms, frame %d" % [
+		what, _mp8_limit, ", ".join(who), Time.get_ticks_msec(), Engine.get_process_frames()])
