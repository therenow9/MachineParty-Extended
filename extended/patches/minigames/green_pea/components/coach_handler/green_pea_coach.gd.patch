+const MP8_FIRE_AT: float = 0.93           # gun_shot_visuals' wait: the bang in every aim
+const MP8_TURN_IN_FROM: float = 0.25      # the turn joins the aim's own swing
+const MP8_TURN_IN: float = 0.55
