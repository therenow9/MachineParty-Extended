+# [MP8] Seat -> which `coach_shoot_position_N` animation. Filled on every peer by green_pea.gd's
+# `_mp8_map_animations()`, since `shoot_player` plays on each. Empty = the seat itself (identical up to 4).
+var mp8_anim_by_seat: Array = []
+
+
+func _mp8_anim_index(seat: int) -> int :
+
+	if seat >= 0 and seat < mp8_anim_by_seat.size():
+		return int(mp8_anim_by_seat[seat])
+
+	return seat
+
+# [MP8] The stock loops await a random 0-0.3 s per player, so the last seat's pause/resume lags by
+# the sum of every earlier delay and grows with the player count. Each step gets budget / players,
+# so the whole ramp stays as long as the stock 4-player one. `players.size()`, not the living count:
+# both loops walk the whole array.
+const MP8_STAGGER_BUDGET: float = 1.2   # the stock 4-player ramp: 4 x 0.3
+
+
+func _mp8_stagger() -> float :
+
+	return randf_range(0.0, MP8_STAGGER_BUDGET / float(maxi(players.size(), 1)))
