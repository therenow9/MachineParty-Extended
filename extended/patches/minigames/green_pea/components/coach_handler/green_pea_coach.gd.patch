+class MP8Turn extends SkeletonModifier3D:
+
+	var bone: int = -1                    # spine
+	var upper: int = -1                   # the gun arm: upper arm, forearm, hand
+	var fore: int = -1
+	var hand: int = -1
+	var gun_local: Transform3D = Transform3D.IDENTITY   # the gun on the hand: its +z is the barrel
+	var pose: Vector2 = Vector2.ZERO      # x: the turn about world up (radians), y: the gun drawn back (m)
+	# The elbow's side in the upper arm's own frame: taken once per draw-back, so a near-straight arm can't flip it,
+	# and turning with the arm through a swing.
+	var _bend: Vector3 = Vector3.ZERO
+
+	func _process_modification() -> void:
+		if pose.y <= 0.0:
+			_bend = Vector3.ZERO
+		var sk := get_skeleton()
+		if sk == null or bone < 0 or pose.is_zero_approx():
+			return
+		if not is_zero_approx(pose.x):
+			var up: Vector3 = (sk.global_basis.inverse() * Vector3.UP).normalized()
+			var gp: Transform3D = sk.get_bone_global_pose(bone)
+			sk.set_bone_global_pose(bone, Transform3D(Basis(up, pose.x) * gp.basis, gp.origin))
+		if pose.y > 0.0 and hand >= 0:
+			_draw_back(sk, pose.y / sk.global_basis.get_scale().x)
+
+	# Two-bone IK: the hand moves back along the barrel, the elbow bends to the side it already bends to, and
+	# the hand keeps its own rotation, so the barrel keeps its line. The arm's shortest reach stops it short.
+	func _draw_back(sk: Skeleton3D, dist: float) -> void:
+		var u: Transform3D = sk.get_bone_global_pose(upper)
+		var e: Vector3 = sk.get_bone_global_pose(fore).origin
+		var w: Transform3D = sk.get_bone_global_pose(hand)
+		var s: Vector3 = u.origin
+		var l1: float = s.distance_to(e)
+		var l2: float = e.distance_to(w.origin)
+		var back: Vector3 = (w.basis * gun_local.basis).z.normalized()
+		var dmin: float = absf(l1 - l2) + 0.001
+		var b: float = back.dot(w.origin - s)
+		var disc: float = b * b - (w.origin - s).length_squared() + dmin * dmin
+		if disc >= 0.0 and b > 0.0:
+			dist = minf(dist, maxf(b - sqrt(disc), 0.0))
+		var to: Vector3 = w.origin - back * dist
+		var span: Vector3 = to - s
+		var d: float = clampf(span.length(), dmin, l1 + l2 - 0.001)
+		var axis: Vector3 = span.normalized()
+		if _bend.is_zero_approx():
+			var side: Vector3 = (e - s) - axis * (e - s).dot(axis)
+			if side.length() < 0.05 * l1:
+				side = -(sk.global_basis.inverse() * Vector3.UP)
+			_bend = u.basis.inverse() * side
+		var bend: Vector3 = u.basis * _bend
+		var pole: Vector3 = bend - axis * bend.dot(axis)
+		var a: float = (l1 * l1 - l2 * l2 + d * d) / (2.0 * d)
+		var elbow: Vector3 = s + axis * a + pole.normalized() * sqrt(maxf(l1 * l1 - a * a, 0.0))
+		sk.set_bone_global_pose(upper, Transform3D(Basis(Quaternion((e - s).normalized(), (elbow - s).normalized())) * u.basis, s))
+		var f: Transform3D = sk.get_bone_global_pose(fore)
+		var now: Vector3 = sk.get_bone_global_pose(hand).origin
+		var hit: Vector3 = s + axis * d
+		sk.set_bone_global_pose(fore, Transform3D(Basis(Quaternion((now - f.origin).normalized(), (hit - f.origin).normalized())) * f.basis, f.origin))
+		sk.set_bone_global_pose(hand, Transform3D(w.basis, sk.get_bone_global_pose(hand).origin))
+
+var _mp8_turn: MP8Turn = null
+var _mp8_turn_tween: Tween = null
+
+
+func _mp8_turner() -> MP8Turn:
+
+	if _mp8_turn == null:
+		var sk := _mp8_skeleton()
+		var att := _mp8_gun().get_parent() as BoneAttachment3D
+		_mp8_turn = MP8Turn.new()
+		_mp8_turn.name = "MP8Turn"
+		_mp8_turn.bone = sk.find_bone("spine")
+		_mp8_turn.hand = sk.find_bone(att.bone_name) if att != null else -1
+		_mp8_turn.fore = sk.get_bone_parent(_mp8_turn.hand) if _mp8_turn.hand >= 0 else -1
+		_mp8_turn.upper = sk.get_bone_parent(_mp8_turn.fore) if _mp8_turn.fore >= 0 else -1
+		if _mp8_turn.upper < 0:
+			_mp8_turn.hand = -1
+		_mp8_turn.gun_local = _mp8_gun().transform
+		sk.add_child(_mp8_turn)
+	return _mp8_turn
+
+
+# The gun rides `hand_L`, a BoneAttachment3D on the coach's Skeleton3D.
+func _mp8_gun() -> Node3D:
+	return anim_gun_fire.get_parent()
+
+
+func _mp8_skeleton() -> Skeleton3D:
+	return _mp8_gun().get_parent().get_parent()
+
+
+func _mp8_turn_to(to: Vector2, seconds: float, after: float = 0.0) -> void :
+
+	var t := _mp8_turner()
+	if _mp8_turn_tween != null:
+		_mp8_turn_tween.kill()
+	_mp8_turn_tween = create_tween()
+	if after > 0.0:
+		_mp8_turn_tween.tween_interval(after)
+	_mp8_turn_tween.tween_property(t, "pose", to, seconds).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_IN_OUT)
+
+
+# A seat's shot from the aim's fire pose: the turn (none at the stock seats), and how far to draw the gun back
+# so that no living player's head is within MP8_GUN_CLEAR of its muzzle.
+func _mp8_turn_for(seat: int, anim_name: String) -> Vector2 :
+
+	var who: GreenPeaPlayer = null
+	for player: GreenPeaPlayer in player_spawn_parent.get_children():
+		if player.player_seat_position == seat:
+			who = player
+	var pose := _mp8_fire_pose(anim_name)
+	if who == null or pose.is_empty():
+		return Vector2.ZERO
+
+	var yaw := 0.0 if seat == _mp8_anim_index(seat) else _mp8_yaw_through(_mp8_head(who), pose)
+	var piv: Vector3 = pose["pivot"]
+	var gun: Vector3 = piv + (pose["gun"] - piv).rotated(Vector3.UP, yaw)
+	var tip: Vector3 = piv + (pose["tip"] - piv).rotated(Vector3.UP, yaw)
+	var d := _mp8_flat((pose["barrel"] as Vector3).rotated(Vector3.UP, yaw)).normalized()
+	var reach: float = _mp8_flat(tip - gun).dot(d)
+	var pull := 0.0
+	for player: GreenPeaPlayer in player_spawn_parent.get_children():
+		if player.is_dead:
+			continue
+		var h := _mp8_flat(_mp8_head(player) - gun)
+		var across: float = absf(d.x * h.y - d.y * h.x)
+		var ahead: float = h.dot(d)
+		if across < MP8_HEAD_WIDE and ahead > 0.0:
+			pull = maxf(pull, reach + MP8_GUN_CLEAR - ahead)
+	return Vector2(yaw, clampf(pull, 0.0, MP8_PULL_MAX))
+
+
+# The turn about the spine's origin that puts the barrel through the head. With h and v the head and the gun from
+# that origin and d the barrel, all flat, a turn t needs cross(d, R(-t) h) = cross(d, v), so
+# t = yaw(h) - yaw(d) + asin(cross(d, v) / |h|).
+func _mp8_yaw_through(head: Vector3, pose: Dictionary) -> float:
+
+	var h := _mp8_flat(head - pose["pivot"])
+	var v := _mp8_flat(pose["gun"] - pose["pivot"])
+	var d := _mp8_flat(pose["barrel"]).normalized()
+	if h.length() < 0.01 or d.is_zero_approx():
+		return 0.0
+	var k: float = d.x * v.y - d.y * v.x
+	var t: float = atan2(h.x, h.y) - atan2(d.x, d.y) + asin(clampf(k / h.length(), -1.0, 1.0))
+	return clampf(wrapf(t, -PI, PI), -MP8_TURN_MAX, MP8_TURN_MAX)
+
+
+func _mp8_flat(v: Vector3) -> Vector2:
+	return Vector2(v.x, v.z)
+
+
+func _mp8_head(who: GreenPeaPlayer) -> Vector3:
+
+	for sk: Skeleton3D in who.find_children("*", "Skeleton3D", true, false):
+		var b := sk.find_bone("head")
+		if b >= 0:
+			return sk.global_transform * sk.get_bone_global_pose(b).origin
+	return who.global_position
+
+
+# The spine's origin, the gun, its muzzle and its barrel (local +z) in world space, MP8_FIRE_AT into the aim: the
+# animation's rotation tracks chained over the bones' own positions and scales (the aims key rotations only).
+func _mp8_fire_pose(anim_name: String) -> Dictionary:
+
+	var sk := _mp8_skeleton()
+	var att := _mp8_gun().get_parent() as BoneAttachment3D
+	var anim: Animation = anim_coach.get_animation(anim_name) if anim_coach.has_animation(anim_name) else null
+	var hand: int = sk.find_bone(att.bone_name) if att != null else -1
+	var spine := sk.find_bone("spine")
+	if anim == null or hand < 0 or spine < 0:
+		return {}
+
+	var prefix := str(anim_coach.get_node(anim_coach.root_node).get_path_to(sk)) + ":"
+	var local := {}
+	var b := hand
+	while b >= 0:
+		var q: Quaternion = sk.get_bone_pose_rotation(b)
+		var tr := anim.find_track(NodePath(prefix + sk.get_bone_name(b)), Animation.TYPE_ROTATION_3D)
+		if tr >= 0:
+			q = anim.rotation_track_interpolate(tr, MP8_FIRE_AT)
+		local[b] = Transform3D(Basis(q) * Basis.from_scale(sk.get_bone_pose_scale(b)), sk.get_bone_pose_position(b))
+		b = sk.get_bone_parent(b)
+	if not local.has(spine):
+		return {}
+
+	var mesh := _mp8_gun() as MeshInstance3D
+	var box: AABB = mesh.get_aabb() if mesh != null else AABB()
+	var gun: Transform3D = _mp8_chain(sk, local, hand) * _mp8_gun().transform
+	return {"pivot": _mp8_chain(sk, local, spine).origin, "gun": gun.origin,
+		"tip": gun * Vector3(box.get_center().x, box.get_center().y, box.end.z), "barrel": gun.basis.z}
+
+
+func _mp8_chain(sk: Skeleton3D, local: Dictionary, to: int) -> Transform3D:
+
+	var x := Transform3D.IDENTITY
+	var c := to
+	while c >= 0:
+		x = local[c] * x
+		c = sk.get_bone_parent(c)
+	return sk.global_transform * x
+
+
+# A second name for an aim: AnimationPlayer doesn't restart or blend into the animation it is playing.
+func _mp8_again(anim_name: String) -> String:
+
+	if not anim_coach.has_animation_library(&"mp8"):
+		anim_coach.add_animation_library(&"mp8", AnimationLibrary.new())
+	var lib := anim_coach.get_animation_library(&"mp8")
+	if not lib.has_animation(StringName(anim_name)) and anim_coach.has_animation(anim_name):
+		lib.add_animation(StringName(anim_name), anim_coach.get_animation(anim_name))
+	return "mp8/" + anim_name
+
+
