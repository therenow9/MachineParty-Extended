+
+# The benches, [x, z, yaw degrees] in seat order: each flush against a wall, long side along it, none between the
+# recipe slots and the main counter, mirrored left and right. 5 and 7 players use the 6 and 8 layouts, and the
+# unused far-right corner keeps one of the game's empty desks. The side walls' collision stands 0.7 m behind
+# their visible face (the baseboard trim, z +-12.0), so the side benches are placed against the face.
+const MP8V_BENCHES_6: Array = [
+	[-8.00, -7.50, 0.0], [-8.00, 7.50, 0.0], [1.75, -10.70, 90.0], [1.75, 10.70, 90.0], [11.75, -8.00, 0.0], [11.75, 8.00, 0.0],
+]
+const MP8V_BENCHES_8: Array = [
+	[-7.75, -7.75, 0.0], [-7.75, 7.75, 0.0], [-1.50, -10.70, 90.0], [-1.50, 10.70, 90.0],
+	[5.50, -10.70, 90.0], [5.50, 10.70, 90.0], [11.75, -8.00, 0.0], [11.75, 8.00, 0.0],
+]
+# The game's spawns stand 3.4-3.7 m from their bench toward the middle, facing it; these stand 3.5 m from theirs
+# toward the main counter's middle (its collision outline's centre).
+const MP8V_SPAWN_FROM_BENCH: float = 3.5
+const MP8V_COUNTER_MIDDLE: Vector2 = Vector2(1.73, -0.20)
+# The props the side benches replace, with their collision. The pallet stands in the 8 layout's left side-bench
+# run, where the benches slide for an even spacing.
+const MP8V_GONE_PROPS: Array[String] = [
+	"manufacture gun artwork pass2/desk left", "manufacture gun artwork pass2/desk trolley", "manufacture gun artwork pass2/pallet",
+]
+const MP8V_GONE_SHAPES: Array[String] = [
+	"Colliders/StaticBody3D/CollisionShape3D2", "Colliders/StaticBody3D/CollisionShape3D4",
+	"Colliders/StaticBody3D2/CollisionShape3D", "Colliders/StaticBody3D2/CollisionShape3D3",
+]
+# The three part markers on the tops of the desks this layout hides, put on the floor in front of the benches
+# that stand there: [x, z] for the 6 layout, then for the 8 layout.
+const MP8V_DESK_PARTS: Dictionary = {
+	"part_010": [[0.72, -8.75], [0.72, -8.75]],
+	"part_013": [[5.46, 10.53], [4.46, 8.78]],
+	"part_014": [[2.98, 8.77], [2.98, 8.77]],
+}
+# A bench's lamp hangs 6.35 m up (shade 5.90-6.33), 1.0 m over its recipe hologram, inside the right wall's pipes
+# (5.17-6.71 m, 3 m deep) and beside their mounts (from 4.25 m). A lamp low enough to clear them hangs in the
+# hologram, so the run and its mounts go up; 2.1 m lifts the mounts' feet over the shades.
+const MP8V_PIPES: Array[String] = [
+	"manufacture gun artwork pass2/pipe wall", "manufacture gun artwork pass2/pipe wall mount",
+	"manufacture gun artwork pass2/pipe wall mount_001", "manufacture gun artwork pass2/pipe wall mount_002",
+]
+const MP8V_PIPES_RAISE: float = 2.1
+
+# network_manager's generic spawn top-up skips a minigame that sets this; _mp8v_expand_for_roster places its own.
+var mp8_owns_spawns: bool = true
+var _mp8v_spawns_added: int = 0
+var _mp8v_desks_added: int = 0
+var _mp8v_items_each: int = 0
+# The host's bench layout for this round, empty at 1-4 players.
+var _mp8v_layout: Array = []
+var _mp8v_room_changed: bool = false
+
+
+static func _mp8v_per_marker(roster: int) -> int :
+	return maxi(int(ceil(float(roster) / float(MP8V_VANILLA_SLOTS))), 1)
+
+
+# A spawner's limit raised to the roster, or left alone when it is unlimited (0) or already big enough.
+static func _mp8v_raised_spawn_limit(limit: int, roster: int) -> int :
+	return roster if limit > 0 and limit < roster else limit
+
+
+# The bench layout for a roster: 6 benches for 5-6 players, 8 for 7-8, none otherwise.
+static func _mp8v_benches_for(roster: int) -> Array :
+	if roster <= MP8V_VANILLA_SLOTS or roster > 8:
+		return []
+	return MP8V_BENCHES_6 if roster <= 6 else MP8V_BENCHES_8
+
+
+# A bench's spawn, [x, z, yaw degrees]: toward the counter's middle, turned toward the bench as the game's own
+# spawns are (its far-right spawn is -90; this formula on that spawn and its bench gives -96).
+static func _mp8v_spawn_for(bench: Array) -> Array :
+	var b := Vector2(float(bench[0]), float(bench[1]))
+	var s: Vector2 = b + (MP8V_COUNTER_MIDDLE - b).normalized() * MP8V_SPAWN_FROM_BENCH
+	var f: Vector2 = b - s
+	return [s.x, s.y, rad_to_deg(atan2(- f.x, - f.y))]
+
+
+# Before spawn_players() and spawn_workstations(), which index both containers by seat. Server only: the
+# markers and the item spawns are read on the host; the room itself changes on every peer (the room call).
+func _mp8v_expand_for_roster() -> void :
+
+	var roster: int = PlayerManager.player_presences.size()
+	_mp8v_layout = _mp8v_benches_for(roster)
+	if _mp8v_layout.is_empty():
+		return
+
+	var seats: Array = _mp8v_layout.slice(0, roster)
+	var spawns: Array = []
+	for bench in seats:
+		spawns.append(_mp8v_spawn_for(bench))
+	_mp8v_desks_added = _mp8v_place_markers(get_node_or_null("WorkstationSpawns") as Node3D, seats, false)
+	_mp8v_spawns_added = _mp8v_place_markers(get_node_or_null("SpawnPositions") as Node3D, spawns, true)
+
+	var which: int = 0 if roster <= 6 else 1
+	for part in MP8V_DESK_PARTS:
+		var m: Node3D = get_node_or_null(NodePath("ItemSpawner/ItemSpawns/" + part)) as Node3D
+		if m == null:
+			push_warning("[MP8] Firearm Factory 8p: no item marker %s to move off its desk" % part)
+			continue
+		var at: Array = MP8V_DESK_PARTS[part][which]
+		m.global_position = Vector3(float(at[0]), 0.0, float(at[1]))
+
+
+# The container's markers put at the entries, the shipped four first and markers added for the rest. A desk's
+# yaw goes into rotation_degrees (spawn_workstations sends it), a spawn's into global_rotation (spawn_players).
+func _mp8v_place_markers(container: Node3D, entries: Array, spawns: bool) -> int :
+
+	if container == null or container.get_child_count() < MP8V_VANILLA_SLOTS:
+		push_warning("[MP8] Firearm Factory 8p: a spawn container is missing or short, not placed")
+		return 0
+
+	# Anything past the shipped four would be the generic top-up, which mp8_owns_spawns already stops.
+	for extra in container.get_children().slice(MP8V_VANILLA_SLOTS):
+		container.remove_child(extra)
+		extra.queue_free()
+
+	var added: int = 0
+	for i in entries.size():
+		var marker: Node3D
+		if i < container.get_child_count():
+			marker = container.get_child(i) as Node3D
+		else:
+			marker = Marker3D.new()
+			marker.name = "Marker3D%d_MP8V" % (i + 1)
+			container.add_child(marker)
+			added += 1
+		var e: Array = entries[i]
+		marker.global_position = Vector3(float(e[0]), 0.0, float(e[1]))
+		if spawns:
+			marker.global_rotation = Vector3(0.0, deg_to_rad(float(e[2])), 0.0)
+		else:
+			marker.rotation_degrees = Vector3(0.0, float(e[2]), 0.0)
+
+	return added
+
+
+func zz_mp8v_bench_room_rpc(roster: int) -> void :
+	if not _mp8_host_command():
+		return
+	_mp8v_change_room(roster)
+
+
+# Every peer's own copy of the room for the bench layout: the replaced props and their collision gone, the empty
+# desks cleared but one moved into the unused corner at 5 and 7, the right wall's pipes raised.
+func _mp8v_change_room(roster: int) -> void :
+
+	var layout: Array = _mp8v_benches_for(roster)
+	if layout.is_empty() or _mp8v_room_changed:
+		return
+	_mp8v_room_changed = true
+
+	for path in MP8V_GONE_PROPS:
+		var prop: Node3D = get_node_or_null(NodePath(path)) as Node3D
+		if prop != null:
+			prop.visible = false
+	for path in MP8V_GONE_SHAPES:
+		var shape: CollisionShape3D = get_node_or_null(NodePath(path)) as CollisionShape3D
+		if shape != null:
+			shape.set_deferred("disabled", true)
+
+	var kept: bool = false
+	for k in empty_desk_array.size():
+		var desk: Node3D = empty_desk_array[k]
+		if desk == null or not is_instance_valid(desk):
+			continue
+		if not kept and roster < layout.size():
+			var spot: Array = layout[roster]
+			desk.global_position = Vector3(float(spot[0]), desk.global_position.y, float(spot[1]))
+			desk.rotation_degrees = Vector3(0.0, float(spot[2]), 0.0)
+			kept = true
+			continue
+		desk.queue_free()
+		empty_desk_array[k] = null
+
+	var raised: int = 0
+	for path in MP8V_PIPES:
+		var pipe: Node3D = get_node_or_null(NodePath(path)) as Node3D
+		if pipe != null:
+			pipe.global_position.y += MP8V_PIPES_RAISE
+			raised += 1
+
+	print("[MP8] Firearm Factory 8p: room for %d players - %d benches, empty desk %s, %d pipe parts raised" % [
+		roster, layout.size(), ("kept" if kept else "none"), raised,
+	])
+
+
+# Copy 0 sits where vanilla puts it; the others are spread round it, since an item is a plain Node3D
+# with no physics and two at one point would intersect for the whole round.
+func _mp8v_spawn_items() -> void :
+
+	var spawn_positions: Array[Vector3]
+	for c in $ItemSpawner / ItemSpawns.get_children():
+		spawn_positions.append(c.global_position)
+	spawn_positions.shuffle()
+
+	var variations = ManufactureGunItem.Variation.values().duplicate()
+	variations.pop_front()
+	variations.shuffle()
+
+	_mp8v_items_each = _mp8v_per_marker(PlayerManager.player_presences.size())
+
+	for spawn_position in spawn_positions:
+		for copy in _mp8v_items_each:
+
+			var item_instance: ManufactureGunItem = item_scene.instantiate()
+			items_node_parent.add_child(item_instance, true)
+
+			var offset: Vector3 = Vector3.ZERO
+			if copy > 0:
+				var ang: float = TAU * (float(copy) / float(_mp8v_items_each))
+				offset = Vector3(cos(ang), 0.0, sin(ang)) * MP8V_ITEM_SPREAD
+
+			item_instance.teleport_rpc.rpc(spawn_position + offset, Vector3.ZERO)
+			item_instance.set_variation_rpc.rpc(variations.pop_front(), true)
+			items.append(item_instance)
+
+			if variations.is_empty():
+				variations = ManufactureGunItem.Variation.values().duplicate()
+				variations.pop_front()
+				variations.shuffle()
+
+
+func _mp8v_log_layout() -> void :
+	var sp: Node = get_node_or_null("SpawnPositions")
+	var ws: Node = get_node_or_null("WorkstationSpawns")
+	print("[MP8] Firearm Factory 8p: %d players, %d-bench layout, spawns %d (+%d), desks %d (+%d), workstations %d, items %d (%d per marker), gun x1.0" % [
+		PlayerManager.player_presences.size(), _mp8v_layout.size(),
+		(sp.get_child_count() if sp != null else -1), _mp8v_spawns_added,
+		(ws.get_child_count() if ws != null else -1), _mp8v_desks_added,
+		workstations.size(), items.size(), _mp8v_items_each,
+	])
