+# [MP8] A bench's solid body (`Collision`) is a direct child of its ManufactureGunWorkstation.
+static func mp8_lands_on_other_bench(collider: Object, network_id: int) -> bool:
+	var bench = (collider as Node).get_parent() if collider is Node else null
+	return bench is ManufactureGunWorkstation and (bench.player_presence == null or bench.player_presence.network_id != network_id)
+
+# [MP8] A mixed room drops wherever the dropcast hits, another player's bench top included, as the game does (D116).
+static func mp8_drop_refused(collider: Object, network_id: int) -> bool:
+	return NetworkManager.mp8_room_extended() and mp8_lands_on_other_bench(collider, network_id)
