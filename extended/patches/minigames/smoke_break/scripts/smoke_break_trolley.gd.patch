@@ -22,6 +22,65 @@ class_name SmokeBreak_Trolley extends Node
 
 var smoke_particle_active_index = -1
 
+# [MP8] Seats whose death shows the fan blood decal. The game hardcodes seats 1 and 2; an added
+# seat counts when its template is seat 1 or 2.
+var _mp8_fan_seats: Array[int] = [1, 2]
+
+
+# [MP8] Called from the minigame's _ready() with the extended seat tables. The trolley cannot extend
+# them in its own _ready(): it is a child of the minigame's root, so it is ready before the new seats exist.
+func mp8_extend_seat_arrays(new_rots: Array, seats: Array) -> void :
+
+	# Revolver angles: the whole table is replaced (the first 4 are the game's)
+	var typed: Array[Vector3] = []
+	for r in new_rots:
+		typed.append(r as Vector3)
+	rot_by_seat_index_array = typed
+
+	# Blood decals: one copied set per added seat, moved to that seat
+	var made := PackedStringArray()
+	while blood_decals_by_seat_index_array.size() < seats.size():
+
+		var idx: int = blood_decals_by_seat_index_array.size()
+		var seat_pos: Vector3 = (seats[idx] as Node3D).global_position
+
+		# The nearest original seat's set is the template
+		var src_i: int = 0
+		var bd: float = INF
+		for i in mini(4, seats.size()):
+			var d: float = seat_pos.distance_to((seats[i] as Node3D).global_position)
+			if d < bd and i < blood_decals_by_seat_index_array.size():
+				bd = d
+				src_i = i
+
+		var src: Node3D = blood_decals_by_seat_index_array[src_i]
+		if src == null or not is_instance_valid(src):
+			blood_decals_by_seat_index_array.append(null)
+			continue
+
+		var dup: Node3D = src.duplicate()
+		dup.name = "MP8BloodSeat%d" % idx
+		src.get_parent().add_child(dup)
+		# The decals are children of the set's node, so moving it carries them all
+		dup.global_position = src.global_position + (
+			seat_pos - (seats[src_i] as Node3D).global_position
+		)
+		dup.visible = false
+		blood_decals_by_seat_index_array.append(dup)
+
+		# A copy of seat 1 or 2 faces the fan too
+		if src_i in [1, 2]:
+			_mp8_fan_seats.append(idx)
+
+		made.append("seat %d from seat %d" % [idx, src_i])
+
+	print("[MP8] Smoke Break trolley: %d revolver angles / %d blood decal sets (new: %s) / %d smoke particles (reused modulo) / fan seats %s" % [
+		rot_by_seat_index_array.size(), blood_decals_by_seat_index_array.size(),
+		(" ".join(made) if made.size() > 0 else "none"),
+		particles_smoke.size(), str(_mp8_fan_seats)
+	])
+
+
