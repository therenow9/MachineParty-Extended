+func _unhandled_key_input(event: InputEvent) -> void :
+
+	if not _mp8_edit_on or player_spawn_positions.size() <= 4:
+		return
+	var key := event as InputEventKey
+	if key == null or not key.pressed or key.echo:
+		return
+
+	var step: float = MP8_EDIT_STEPS[_mp8_edit_step_i]
+	var n: Node3D = player_spawn_positions[_mp8_edit_sel]
+
+	match key.keycode:
+		KEY_1, KEY_2, KEY_3, KEY_4, KEY_5, KEY_6, KEY_7, KEY_8:
+			# [MP8] Keys 1-8 select seat indexes 0-7; the panel and the tags show 1-8 to match
+			var want: int = key.keycode - KEY_1
+			if want >= player_spawn_positions.size():
+				return
+			_mp8_edit_sel = want
+			_mp8_edit_refresh()
+
+		KEY_X:
+			NetworkManager.mp8_rpc(self, &"mp8_toggle_crate_rpc", [_mp8_edit_sel])
+
+		KEY_C:
+			# Switch what I/K/J/L move: the seat (with its player) or its crate
+			var cr0 = _mp8_crates.get(_mp8_edit_sel)
+			if cr0 == null or not is_instance_valid(cr0):
+				print("[MP8] Smoke Break: seat %d has no crate to switch to" % (_mp8_edit_sel + 1))
+				return
+			_mp8_edit_crate = not _mp8_edit_crate
+			_mp8_edit_refresh()
+
+		KEY_I, KEY_K, KEY_J, KEY_L:
+			var dir: Vector2 = _mp8_screen_axis(key.keycode)
+			if dir == Vector2.ZERO:
+				return
+			if _mp8_edit_crate:
+				var cr1 = _mp8_crates.get(_mp8_edit_sel)
+				if cr1 == null or not is_instance_valid(cr1):
+					return
+				var cp := (cr1 as Node3D).global_position
+				NetworkManager.mp8_rpc(self, &"mp8_move_crate_rpc", [_mp8_edit_sel,
+					Vector3(cp.x + dir.y * step, cp.y, cp.z + dir.x * step),
+					rad_to_deg((cr1 as Node3D).global_rotation.y)])
+			else:
+				var p := n.global_position
+				NetworkManager.mp8_rpc(self, &"mp8_move_seat_rpc", [_mp8_edit_sel,
+					Vector2(p.x + dir.y * step, p.z + dir.x * step),
+					rad_to_deg(n.global_rotation.y)])
+
+		KEY_U, KEY_O:
+			var d: float = (-15.0 if key.keycode == KEY_U else 15.0)
+			if _mp8_edit_crate:
+				var cr2 = _mp8_crates.get(_mp8_edit_sel)
+				if cr2 == null or not is_instance_valid(cr2):
+					return
+				NetworkManager.mp8_rpc(self, &"mp8_move_crate_rpc", [_mp8_edit_sel,
+					(cr2 as Node3D).global_position,
+					rad_to_deg((cr2 as Node3D).global_rotation.y) + d])
+			else:
+				NetworkManager.mp8_rpc(self, &"mp8_move_seat_rpc", [_mp8_edit_sel,
+					Vector2(n.global_position.x, n.global_position.z),
+					rad_to_deg(n.global_rotation.y) + d])
+
+		KEY_Y:
+			# Crate height: the game's crate sits on the floor, and a rearranged seat may need it raised
+			if not _mp8_edit_crate:
+				return
+			var cr3 = _mp8_crates.get(_mp8_edit_sel)
+			if cr3 == null or not is_instance_valid(cr3):
+				return
+			var q := (cr3 as Node3D).global_position
+			NetworkManager.mp8_rpc(self, &"mp8_move_crate_rpc", [_mp8_edit_sel,
+				Vector3(q.x, q.y + (step if key.shift_pressed else - step), q.z),
+				rad_to_deg((cr3 as Node3D).global_rotation.y)])
+
+		KEY_M:
+			_mp8_edit_step_i = (_mp8_edit_step_i + 1) % MP8_EDIT_STEPS.size()
+			_mp8_edit_refresh()
+
+		KEY_P:
+			# Pause or resume the countdown through an RPC: the countdown loop runs only on the server,
+			# so a local flag would not reach it.
+			NetworkManager.mp8_rpc(self, &"mp8_set_pause_rpc", [not mp8_edit_paused])
+
+		KEY_0:
+			var ok: bool = _mp8_save_seats()
+			_mp8_edit_refresh()
+			if _mp8_edit_panel != null:
+				_mp8_edit_panel.text = ("[SAVED] the next game uses these seats\n" if ok
+					else "[SAVE FAILED] see the log\n") + _mp8_edit_panel.text
+
+		KEY_N:
+			var parts := PackedStringArray()
+			for i in range(4, player_spawn_positions.size()):
+				var q := player_spawn_positions[i].global_position
+				parts.append("seat%d(%.2f,%.2f) angle %.1f°" % [
+					i, q.x, q.z, _mp8_aim_for(q)])
+			print("[MP8] Smoke Break seat report: %s" % " | ".join(parts))
+
+		_:
+			return
+
+	get_viewport().set_input_as_handled()
+
+
+func _mp8_screen_axis(code: int) -> Vector2 :
+	var cam: Camera3D = get_viewport().get_camera_3d()
+	if cam == null:
+		return Vector2.ZERO
+	var right: Vector3 = cam.global_transform.basis.x
+	var fwd: Vector3 = - cam.global_transform.basis.z
+	var r2 := Vector2(right.x, right.z)
+	var f2 := Vector2(fwd.x, fwd.z)
+	if r2.length() < 0.001 or f2.length() < 0.001:
+		return Vector2.ZERO
+	r2 = r2.normalized()
+	f2 = f2.normalized()
+	match code:
+		KEY_L: return Vector2(r2.y, r2.x)
+		KEY_J: return - Vector2(r2.y, r2.x)
+		KEY_I: return Vector2(f2.y, f2.x)
+		KEY_K: return - Vector2(f2.y, f2.x)
+	return Vector2.ZERO
+
+
+# [MP8] any_peer + call_local: every peer moves it (seat markers, crates and tags are local nodes on each).
+func mp8_move_seat_rpc(slot: int, pos: Vector2, yaw_deg: float) -> void :
+
+	# [MP8] All eight seats can be moved. With 4 players or fewer the custom layout never runs
+	# (the player-count check in _mp8_setup_seats()).
+	if slot < 0 or slot >= player_spawn_positions.size():
+		return
+	var n: Node3D = player_spawn_positions[slot]
+	if n == null or not is_instance_valid(n):
+		return
+
+	var old: Vector3 = n.global_position
+	n.global_position = Vector3(pos.x, old.y, pos.y)
+	n.global_rotation = Vector3(0.0, deg_to_rad(yaw_deg), 0.0)
+
+	# The crate does not follow: crates stay put and seats are placed onto them.
+
+	# [MP8] The player in this seat moves with it, to judge spacing and facing. Only the server sends
+	# it: the setup is itself sent to every peer, and every peer re-sending from this handler would storm.
+	# The seat editor runs above four seats only, so the setup is always Extended's.
+	if multiplayer.is_server():
+		for p in players_node_parent.get_children():
+			if not (p is SmokeBreakPlayer):
+				continue
+			if (p as SmokeBreakPlayer).active_player_seat_index != slot:
+				continue
+			NetworkManager.mp8_rpc(p, &"mp8_setup_rpc", [
+				n.global_position, n.global_rotation, slot,
+				(mp8_death_anim_by_seat[slot] if slot < mp8_death_anim_by_seat.size() else "")
+			])
+			break
+
+	# Recompute the angle and hand it to the trolley
+	var trolley: Node = _mp8_find_trolley()
+	if trolley != null:
+		var rots = trolley.get("rot_by_seat_index_array")
+		if rots is Array and slot < (rots as Array).size():
+			var arr: Array[Vector3] = []
+			for r in (rots as Array):
+				arr.append(r as Vector3)
+			arr[slot] = Vector3(_mp8_aim_for(n.global_position), 0.0, 0.0)
+			trolley.set("rot_by_seat_index_array", arr)
+
+	_mp8_edit_refresh()
+
+
+# [MP8] Move a seat's crate (position and yaw); crates are local scene nodes, so every peer runs it.
+func mp8_move_crate_rpc(slot: int, pos: Vector3, yaw_deg: float) -> void :
+
+	var crate = _mp8_crates.get(slot)
+	if crate == null or not is_instance_valid(crate):
+		return
+	(crate as Node3D).global_position = pos
+	(crate as Node3D).global_rotation = Vector3(0.0, deg_to_rad(yaw_deg), 0.0)
+	_mp8_edit_refresh()
+
+
+# [MP8] Hide or show a seat's crate on every peer. visible rather than queue_free, so it can be
+# toggled back without restarting the round.
+func mp8_toggle_crate_rpc(slot: int) -> void :
+
+	var crate = _mp8_crates.get(slot)
+	if crate == null or not is_instance_valid(crate):
+		print("[MP8] Smoke Break: seat %d has no crate (the game's seats sit on scenery)" % (slot + 1))
+		_mp8_edit_refresh()
+		return
+
+	(crate as Node3D).visible = not (crate as Node3D).visible
+	print("[MP8] Smoke Break: seat %d crate %s" % [
+		slot + 1, ("shown" if (crate as Node3D).visible else "hidden")
+	])
+	_mp8_edit_refresh()
+
+
+# [MP8] Pause or resume the round countdown. Its loop runs on the server, so every peer gets it (call_local).
+func mp8_set_pause_rpc(paused: bool) -> void :
+	mp8_edit_paused = paused
+	_mp8_edit_refresh()
+	print("[MP8] Smoke Break: round countdown %s" % ("paused" if paused else "running"))
+
+
+func _mp8_edit_refresh() -> void :
+
+	for i in _mp8_tags.size():
+		var t: Label3D = _mp8_tags[i]
+		if t == null or not is_instance_valid(t):
+			continue
+		# [MP8] Tags show 1-8, matching keys 1-8
+		var sel: bool = (i == _mp8_edit_sel)
+		t.text = ("▼%d▼" % (i + 1)) if sel else str(i + 1)
+		t.modulate = (Color(1.0, 0.85, 0.2) if sel else Color(0.55, 0.75, 0.85))
+
+	if _mp8_edit_panel == null:
+		return
+
+	var n: Node3D = player_spawn_positions[_mp8_edit_sel]
+	var p := n.global_position
+	var aim: float = _mp8_aim_for(p)
+	var ok: bool = _mp8_aim_ok(aim)
+
+	# Distance to the nearest other seat (too small = too tight)
+	var gap: float = INF
+	for i in player_spawn_positions.size():
+		if i == _mp8_edit_sel:
+			continue
+		gap = minf(gap, Vector2(p.x - player_spawn_positions[i].global_position.x,
+			p.z - player_spawn_positions[i].global_position.z).length())
+
+	var crate = _mp8_crates.get(_mp8_edit_sel)
+	var crate_txt: String = "no crate (game seat)"
+	if crate != null and is_instance_valid(crate):
+		crate_txt = ("crate" if (crate as Node3D).visible else "crate removed")
+
+	var cr_now = _mp8_crates.get(_mp8_edit_sel)
+	var target: String = "▶ editing [seat/player]"
+	var line2: String = "pos x=%.2f z=%.2f  yaw %.0f°   nearest seat %.2f m %s" % [
+		p.x, p.z, rad_to_deg(n.global_rotation.y), gap, ("✓" if gap >= 0.9 else "⚠tight")]
+	if _mp8_edit_crate and cr_now != null and is_instance_valid(cr_now):
+		var c3: Node3D = cr_now
+		target = "▶ editing [crate]"
+		line2 = "crate x=%.2f y=%.2f z=%.2f  yaw %.0f°   (player at %.2f, %.2f)" % [
+			c3.global_position.x, c3.global_position.y, c3.global_position.z,
+			rad_to_deg(c3.global_rotation.y), p.x, p.z]
+
+	_mp8_edit_panel.text = "\n".join([
+		"[EDIT] seat %d / %d   %s   step %.2f m   %s   source %s" % [
+			_mp8_edit_sel + 1, player_spawn_positions.size(), target,
+			MP8_EDIT_STEPS[_mp8_edit_step_i], crate_txt, _mp8_seat_src],
+		line2,
+		"revolver angle %.1f°  %s" % [aim,
+			("✓ within the game's span, aims true" if ok
+			else "⚠️ outside the game's span %.0f°~%.0f°, this angle is unreliable and the gun may miss" % [
+				MP8_AIM_MIN, MP8_AIM_MAX])],
+		"countdown %s   1-8 seat  C seat/crate  I/K/J/L move  U/O turn  Y crate height (Shift up)  M step  X crate on/off  P pause  0 save" % [
+			("⏸ paused" if mp8_edit_paused else "▶ running")],
+	])
+
+
+# [MP8] Seat position -> revolver angle; see MP8_AIM_* (the fit is not unique).
+func _mp8_aim_for(pos: Vector3) -> float :
+	var b: float = rad_to_deg(atan2(pos.z - MP8_AIM_PIVOT.y, pos.x - MP8_AIM_PIVOT.x))
+	return MP8_AIM_K * b + MP8_AIM_C
+
+
+# Within the game's four-seat span? Inside is reliable, outside is not
+func _mp8_aim_ok(deg: float) -> bool :
+	return deg >= MP8_AIM_MIN - 0.5 and deg <= MP8_AIM_MAX + 0.5
+
+
+# [MP8] A crate for an added seat to sit on, copied from seat 3's and placed at seat 3's offset, so
+# it sits as in the game without knowing its absolute height. The game's own props are untouched.
+func _mp8_make_crate(seat_idx: int, seat_pos: Vector3) -> void :
+
+	# Only the seats in MP8_CRATE_SEATS
+	if not MP8_CRATE_SEATS.has(seat_idx):
+		return
+
+	var src: Node3D = get_node_or_null(MP8_CRATE_PATH) as Node3D
+	if src == null:
+		push_warning("[MP8] Smoke Break: crate %s not found, seat %d gets none" % [MP8_CRATE_PATH, seat_idx + 1])
+		return
+
+	var dup: Node3D = src.duplicate()
+	dup.name = "MP8Crate%d" % seat_idx
+	src.get_parent().add_child(dup)
+	# The offset is from seat 3 before it moved (_mp8_crate_offset); measured from a moved seat,
+	# each crate would shift by however far that seat had been moved.
+	dup.global_position = seat_pos + _mp8_crate_offset
+	_mp8_crates[seat_idx] = dup
+
+
+# An added seat takes the death animation (window / fan) of the nearest original seat
+func _mp8_nearest_vanilla_anim(p: Vector3) -> String :
+	var best: int = 0
+	var bd: float = INF
+	for i in mini(4, player_spawn_positions.size()):
+		var d: float = p.distance_to(player_spawn_positions[i].global_position)
+		if d < bd:
+			bd = d
+			best = i
+	return mp8_death_anim_by_seat[best]
+
+
+func _mp8_find_trolley() -> Node :
+	var t: Node = get_node_or_null("trolley gun main parent/trolley gun manager")
+	if t != null:
+		return t
+	# If the path changes, find the node that has the angle table rather than depend on the name
+	for c in find_children("*", "", true, false):
+		if c.get("rot_by_seat_index_array") != null:
+			return c
+	return null
+
