+# ---- Seat file: one row per seat, all 8 ----
+
+func _mp8_load_seats() -> Array :
+	# No seat file -> MP8_SEATS_BAKED, not the arc fill: peers never have the file.
+	# `mp8smokenofile` gives the arc fill alone.
+	# [MP8] The editor's file, read only in a test build: a shipped build plays the built-in layout.
+	if not NetworkManager.mp8_development_tools_allowed() or not FileAccess.file_exists(MP8_SEAT_FILE):
+		return _mp8_baked_seats()
+	var f := FileAccess.open(MP8_SEAT_FILE, FileAccess.READ)
+	if f == null:
+		push_warning("[MP8] Smoke Break: cannot open %s, using the built-in seat table" % MP8_SEAT_FILE)
+		return _mp8_baked_seats()
+	var rows: Array = []
+	while not f.eof_reached():
+		var line: String = f.get_line().strip_edges()
+		if line.is_empty() or line.begins_with("#"):
+			continue
+		var c: PackedStringArray = line.split(",", false)
+		if c.size() < 3:
+			continue
+		var sx: String = c[0].strip_edges()
+		var sz: String = c[1].strip_edges()
+		var sy: String = c[2].strip_edges()
+		if not (sx.is_valid_float() and sz.is_valid_float() and sy.is_valid_float()):
+			continue
+		# Column 4 (has crate) is optional and defaults to a crate
+		var has: bool = true
+		if c.size() >= 4 and c[3].strip_edges().is_valid_int():
+			has = (int(c[3].strip_edges()) != 0)
+		var row := {"pos": Vector2(float(sx), float(sz)), "yaw": float(sy), "crate": has}
+		# Columns 5-8: a hand-placed crate position (x, y, z, yaw); without them the computed offset applies
+		if c.size() >= 8:
+			var cx: String = c[4].strip_edges()
+			var cy: String = c[5].strip_edges()
+			var cz: String = c[6].strip_edges()
+			var cw: String = c[7].strip_edges()
+			if cx.is_valid_float() and cy.is_valid_float() and cz.is_valid_float() and cw.is_valid_float():
+				row["crate_pos"] = Vector3(float(cx), float(cy), float(cz))
+				row["crate_yaw"] = float(cw)
+		rows.append(row)
+	f.close()
+
+	_mp8_seat_src = "seat file %s" % MP8_SEAT_FILE
+
+	# Fewer than 8 rows is ignored: a file of the 4 added seats alone would fill 8 seats and
+	# shift every one.
+	if rows.size() > 0 and rows.size() < MP8_MAX_PLAYERS:
+		push_warning("[MP8] Smoke Break: %s has only %d rows (old format, 8 needed), ignored; using the built-in seat table" % [
+			MP8_SEAT_FILE, rows.size()
+		])
+		print("[MP8] Smoke Break: the seat file is in the old format (%d rows), ignored. Place the seats again and press 0 to save over it." % rows.size())
+		return _mp8_baked_seats()
+
+	if rows.is_empty():
+		# No valid rows also gets the baked table, not the arc fill, or this peer would differ from the rest
+		push_warning("[MP8] Smoke Break: %s has no valid rows, using the built-in seat table" % MP8_SEAT_FILE)
+		return _mp8_baked_seats()
+
+	return rows
+
+
+# [MP8] MP8_SEATS_BAKED in _mp8_load_seats()'s row shape. Peers without the seat file use it,
+# so it must match the host's file.
+func _mp8_baked_seats() -> Array :
+
+	_mp8_seat_src = "built-in table MP8_SEATS_BAKED"
+	var rows: Array = []
+	for r in MP8_SEATS_BAKED:
+		var row := {"pos": r[0] as Vector2, "yaw": float(r[1]), "crate": bool(r[2])}
+		if r[3] != null:
+			row["crate_pos"] = r[3] as Vector3
+			row["crate_yaw"] = float(r[4])
+		rows.append(row)
+	return rows
+
+
+func _mp8_save_seats() -> bool :
+	var f := FileAccess.open(MP8_SEAT_FILE, FileAccess.WRITE)
+	if f == null:
+		push_warning("[MP8] Smoke Break: cannot write %s" % MP8_SEAT_FILE)
+		return false
+	f.store_line("# Smoke Break (mp8game=4) seat table - 8 lines, one per seat 1-8")
+	f.store_line("# Each line: x, z, yaw (degrees), crate (1/0)")
+	f.store_line("# Used only at 5+ players; at 4 or fewer the stock 4 seats are used unchanged.")
+	f.store_line("# The revolver angle is computed from the position and is reliable only within the stock seats' span:")
+	f.store_line("#    it must fall between %.0f° and %.0f°, or the gun misses (the editor shows yellow)." % [
+		MP8_AIM_MIN, MP8_AIM_MAX])
+	f.store_line("# Only the added seats have crates (the stock four are scene art and cannot change).")
+	f.store_line("# Delete this file to go back to the built-in seat table (MP8_SEATS_BAKED).")
+	f.store_line("# Saved %s" % Time.get_datetime_string_from_system())
+	f.store_line("")
+	for i in player_spawn_positions.size():
+		var n: Node3D = player_spawn_positions[i]
+		var crate = _mp8_crates.get(i)
+		var has: int = 0
+		var line: String = "%.2f, %.2f, %.1f" % [
+			n.global_position.x, n.global_position.z, rad_to_deg(n.global_rotation.y)
+		]
+		if crate != null and is_instance_valid(crate) and (crate as Node3D).visible:
+			has = 1
+			var c3: Node3D = crate
+			# The crate's absolute position (height included) is saved: it is placed by hand, and
+			# seat + offset would put it back at the computed spot
+			line += ", 1, %.2f, %.2f, %.2f, %.1f" % [
+				c3.global_position.x, c3.global_position.y, c3.global_position.z,
+				rad_to_deg(c3.global_rotation.y)
+			]
+		else:
+			line += ", %d" % has
+		f.store_line(line)
+	f.close()
+	print("[MP8] Smoke Break: seats saved -> %s" % ProjectSettings.globalize_path(MP8_SEAT_FILE))
+	return true
+
