 func player_disconnected(_network_id: int):
+	# [MP8] A mixed room keeps the game's own handler, its raw read included.
+	var mp8_ext: bool = NetworkManager.mp8_room_extended()
 	super.player_disconnected(_network_id)
 
+	if not mp8_ext:
+		_mp8_game_player_disconnected_tail(_network_id)
+		return
+
+	# [MP8] .get() rather than the game's direct lookup: a player who left while loading was never
+	# spawned (spawn_players() runs from initialize()). This player_disconnected calls no end-of-round
+	# code, so no is_all_player_loaded guard is needed.
+	var player_instance = player_characters.get(_network_id, null)
+
+	if player_instance == null:
+		print("[MP8] Smoke Break: %d left before having a seat (the round has likely not started), clearing the reference only" % _network_id)
+		player_characters.erase(_network_id)
+		return
+
+	active_players.erase(player_instance)
+
+	finished_players.erase(player_instance)
+
+	player_instance.queue_free()
