+
+	print("[MP8] The Filter: %d players -> %d seats, %.1f° step, %d belt slots (vanilla %d), outer ring push %.2f m" % [
+		n, mp8_seats, mp8_seat_step, mp8_slot_count, MP8_ORIG_SLOTS, mp8_ring_push])
+	print("[MP8] The Filter: %d rounds without ties, at most %d out a round" % [MP8_MAX_ROUNDS, MP8_MAX_OUT])
