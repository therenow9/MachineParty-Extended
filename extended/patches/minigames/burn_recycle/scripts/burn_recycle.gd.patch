+# [MP8] The UV scroll per slot for a shortened belt: vanilla's 0.028 is one 1 m slot of the 18-slot
+# belt, so a belt shrunk by k needs 0.028 / k.
+func _mp8_calc_uv_step() -> void :
+
+	mp8_belt_uv_step = MP8_BELT_UV_STEP
+	var k: float = _mp8_belt_shrink()
+	if k > 0.01:
+		mp8_belt_uv_step = MP8_BELT_UV_STEP / k
+
+
+func _mp8_belt_shrink() -> float :
+	var span_orig: float = float(MP8_ORIG_SLOTS - 1) * MP8_SLOT_SPACING
+	var span_new: float = float(mp8_slot_count - 1) * MP8_SLOT_SPACING
+	if span_orig <= 0.0:
+		return 1.0
+	return span_new / span_orig
+
