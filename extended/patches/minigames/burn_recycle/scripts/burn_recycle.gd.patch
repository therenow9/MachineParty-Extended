+	# so every instance needs the argument.
+	var wv: String = _mp8_arg("mp8burnwall=")
+	if wv.is_valid_float():
+		mp8_wall_push = clampf(float(wv), 0.0, 30.0)
+
+	_mp8_calc_uv_step()
+
+	# [MP8] The layout editor, `mp8burnedit` on the host's window; see the section at the end.
+	_mp8_edit_on = NetworkManager.mp8_dev_args().has("mp8burnedit")
+
