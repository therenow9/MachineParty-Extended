+# [MP8] Speed that makes an animation fill `window` seconds: its length / window, or 1.0 when the
+# length is unknown. Clamped to [0.25, 4.0]: beyond that it smears or looks frozen, and staying
+# out of sync is better.
+func _mp8_anim_speed_for(anim_name: StringName, window: float) -> float:
+
+	if window <= 0.0 or anim_rig == null:
+		return 1.0
+	if not anim_rig.has_animation(anim_name):
+		return 1.0
+
+	var anim: Animation = anim_rig.get_animation(anim_name)
+	if anim == null or anim.length <= 0.0:
+		return 1.0
+
+	return clampf(anim.length / window, 0.25, 4.0)
+
+
+func _mp8_hipfire_spread_deg() -> float:
+	for a in NetworkManager.mp8_dev_args():
+		var t: String = String(a)
+		if t.begins_with("mp8spread="):
+			return float(t.substr(10))
+	return mp8_hipfire_spread_deg
+
