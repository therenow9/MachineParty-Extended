+# [MP8] Hunter tuning, keyed by total player count rather than duck count (5 and 6 players both
+# have 4 ducks but need opposite tuning). _mp8_tier() clamps the count into the key range, so a
+# lookup never falls to a default. Fire per duck (hunters x shots/s / ducks, reload included) is
+# 0.21-0.22 in every tier but 7 players (0.24), left higher on purpose.
+@export var magazine_capacity_by_player_count: Dictionary[int, int] = {
+	4: 10,
+	5: 12,
+	6: 7,
+	7: 8,
+	8: 10,
+}
+# cycle_time is not the interval between shots: the interval is the game's fixed 0.5 s + cycle_time,
+# so a rate change is computed on the whole interval (1.20 s / 1.3 = 0.92 s -> cycle 0.42).
+# The reload (2.85 s) is fixed in reload() and not tuned here.
+@export var cycle_time_by_player_count: Dictionary[int, float] = {
+	4: 0.80,   # interval 1.30 s (baseline)
+	5: 0.42,   # interval 0.92 s
+	6: 1.375,  # interval 1.875 s
+	7: 0.80,   # interval 1.30 s
+	8: 0.80,   # interval 1.30 s
+}
+
+# [MP8] Total player count from setup_rpc (0 = not passed; the tier falls back to duck count)
+var mp8_player_count: int = 0
+
+
+# [MP8] Hip-fire spread: the game's ray is exact scoped or not, so an unscoped shot
+# (zoom_fov_index 0) is turned to a random direction within this cone. The miss grows with
+# distance: at 8 degrees the median is about 1 m at 10 m and 12 m at 125 m, so unscoped shots
+# land only up close. The `mp8spread=<degrees>` command-line argument overrides it.
+@export var mp8_hipfire_spread_deg: float = 8.0
+
+var _mp8_spread_saved_rotation: Vector3 = Vector3.ZERO
+var _mp8_spread_applied: bool = false
+
