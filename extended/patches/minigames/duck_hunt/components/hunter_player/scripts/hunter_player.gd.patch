+func _mp8_apply_hipfire_spread() -> void :
+
+	_mp8_spread_applied = false
+
+	if laser_raycast == null:
+		return
+	if zoom_fov_index > 0:   # scoped shots stay exact
+		return
+
+	var spread: float = deg_to_rad(_mp8_hipfire_spread_deg())
+	if spread <= 0.0:
+		return
+
+	_mp8_spread_saved_rotation = laser_raycast.rotation
+	_mp8_spread_applied = true
+
+	# Uniform over the cone's area: sqrt(randf()) for the radius, or hits bunch at the centre and
+	# the spread is smaller than set.
+	var angle: float = randf() * TAU
+	var radius: float = sqrt(randf()) * spread
+	laser_raycast.rotation.x += sin(angle) * radius
+	laser_raycast.rotation.y += cos(angle) * radius
+
+	# RayCast3D's result is from the last physics step: without the forced update,
+	# is_colliding()/get_collider() still see the unturned ray and the spread does nothing.
+	laser_raycast.force_raycast_update()
+
+
+func _mp8_clear_hipfire_spread() -> void :
+
+	if not _mp8_spread_applied:
+		return
+	_mp8_spread_applied = false
+	laser_raycast.rotation = _mp8_spread_saved_rotation
+	laser_raycast.force_raycast_update()
