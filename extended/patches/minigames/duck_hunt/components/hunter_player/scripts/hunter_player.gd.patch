+# command-line argument. The scale applies to the whole interval, the fixed 0.5 s included:
+# scaling cycle_time alone changes the interval too little to feel.
+var _mp8_rate_scale: float = 1.0
+var _mp8_rate_keys: bool = false
+var _mp8_rate_label: Label = null
+var _mp8_id_label: RichTextLabel = null  # two lines in two colours need rich text
