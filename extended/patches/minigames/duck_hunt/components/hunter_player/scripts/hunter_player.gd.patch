+
+
+func _mp8_init_rate_keys() -> void :
+	# [MP8] Only the explicit `mp8ratekeys` argument, not -debug-tools: the test bench always passes
+	# -debug-tools, which would leave the keys on.
+	_mp8_rate_keys = NetworkManager.mp8_dev_args().has("mp8ratekeys")
+
+
+func _mp8_handle_rate_key(event: InputEvent) -> void :
+
+	if not _mp8_rate_keys:
+		return
+	if not (event is InputEventKey):
+		return
+	var key: InputEventKey = event
+	if not key.pressed or key.echo:
+		return
+
+	var scale: float = -1.0
+	match key.keycode:
+		KEY_1:
+			scale = 1.0
+		KEY_2:
+			scale = 0.5
+		KEY_3:
+			scale = 2.0
+	if scale < 0.0:
+		return
+
+	_mp8_rate_scale = scale
+
+	var base: float = 0.5 + _mp8_effective_cycle()
+	var label: String = "normal rate" if is_equal_approx(scale, 1.0) else (
+		"2x rate" if scale < 1.0 else "half rate"
+	)
+	var msg: String = "[rate debug] %s  shot interval %.2f s (%d-player tier cycle=%.2f)" % [
+		label, base * scale, _mp8_tier(), _mp8_effective_cycle()
+	]
+	print("[MP8] " + msg)
+	_mp8_show_rate_hint(msg)
