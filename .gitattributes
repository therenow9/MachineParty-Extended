# Line endings are LF in the repository and the working tree. This machine has
# core.autocrlf=true, and a CRLF round-trip shows up as a whole-file diff.
* text=auto eol=lf

*.sh text eol=lf
*.ps1 text eol=lf
# cmd.exe misreads labels and multi-line blocks in an LF batch file.
*.bat text eol=crlf

# Binary. Never touched, never diffed as text.
*.png binary
*.jpg binary
*.zip binary
*.exe binary
*.dll binary
*.pck binary
*.gdc binary
